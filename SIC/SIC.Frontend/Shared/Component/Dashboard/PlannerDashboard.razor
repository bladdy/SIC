@if (PlannerDashboards != null)
{

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h6>Mis Creditos</h6>
                    <h3>@UserCreditDTO?.AvailableCredits</h3>
                    <small class="text-muted">Creditos disponibles</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h6>Mis Eventos</h6>
                    <h3>@PlannerDashboards.MyEventsCount</h3>
                    <small class="text-muted">Asignados a ti</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h6>Invitaciones (mis eventos)</h6>
                    <h3>@PlannerDashboards.MyInvitationsTotal</h3>
                    <small class="text-muted">Enviadas</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <h6>Confirmadas</h6>
                    <h3>@PlannerDashboards.MyInvitationsConfirmed</h3>
                    <small class="text-muted">Estado = Si asistire</small>
                </div>
            </div>
        </div>
        <!-- Resumen de invitados del planner -->
        @if (PlannerDashboards != null)
        {
            <div class="col-12 mt-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="mb-3 text-center">Resumen de invitados</h6>

                        @if (PlannerDashboards.TotalGuests > 0)
                        {
                            <div class="progress" style="height: 28px;">
                                @if (PlannerDashboards.ConfirmedGuests > 0)
                                {
                                    var confirmedPct = (double)PlannerDashboards.ConfirmedGuests / PlannerDashboards.TotalGuests * 100;
                                    <div class="progress-bar bg-success" style="width:@confirmedPct%">
                                        Confirmados: @PlannerDashboards.ConfirmedGuests
                                    </div>
                                }

                                @if (PlannerDashboards.PendingGuests > 0)
                                {
                                    var pendingPct = (double)PlannerDashboards.PendingGuests / PlannerDashboards.TotalGuests * 100;
                                    <div class="progress-bar bg-warning text-dark" style="width:@pendingPct%">
                                        Pendientes: @PlannerDashboards.PendingGuests
                                    </div>
                                }

                                @if (PlannerDashboards.NotAttendingGuests > 0)
                                {
                                    var notAttendPct = (double)PlannerDashboards.NotAttendingGuests / PlannerDashboards.TotalGuests * 100;
                                    <div class="progress-bar bg-danger" style="width:@notAttendPct%">
                                        No asistirán: @PlannerDashboards.NotAttendingGuests
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted">Sin datos de invitados</div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Top eventos progreso -->
        <div class="col-md-6 col-12 mt-3">
            <div class="card shadow-sm" style="height: 450px;">
                <!-- Altura fija -->
                <div class="card-body d-flex flex-column h-100">
                    <h6 class="mb-3">Top 15 eventos por confirmaciones</h6>

                    <!-- Contenido scrollable -->
                    <div class="flex-grow-1 overflow-auto">
                        @foreach (var e in TopEventsPage)
                        {
                            var total = e.TotalGuests > 0 ? e.TotalGuests : 1;
                            var confirmedPercent = (int)((double)e.ConfirmedGuests / total * 100);
                            var pendingPercent = (int)((double)e.PendingGuests / total * 100);
                            var notAttendingPercent = (int)((double)e.NotAttendingGuests / total * 100);

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>@e.EventName</strong>
                                    @if (e.TotalGuests > 0)
                                    {
                                        <small>@e.ConfirmedGuests confirmados de @e.TotalGuests invitados</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Sin invitados</small>
                                    }
                                </div>

                                <div class="progress" style="height: 22px;">
                                    @if (e.ConfirmedGuests > 0)
                                    {
                                        <div class="progress-bar bg-success" style="width: @confirmedPercent%">@e.ConfirmedGuests Confirmados</div>
                                    }
                                    @if (e.PendingGuests > 0)
                                    {
                                        <div class="progress-bar bg-warning text-dark" style="width: @pendingPercent%">@e.PendingGuests Pendientes</div>
                                    }
                                    @if (e.NotAttendingGuests > 0)
                                    {
                                        <div class="progress-bar bg-danger" style="width: @notAttendingPercent%">@e.NotAttendingGuests No asistirán</div>
                                    }
                                    @if (e.TotalGuests == 0)
                                    {
                                        <div class="progress-bar bg-secondary" style="width: 100%">Sin datos</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Botones fijos al fondo -->
                    <div class="d-flex justify-content-between mt-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick="PrevTopEvents" disabled="@(topEventsPage == 0)">Anterior</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="NextTopEvents" disabled="@(topEventsPage >= TopEventsTotalPages - 1)">Siguiente</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Próximos eventos -->
        <div class="col-md-6 col-12 mt-3">
            <div class="card shadow-sm" style="height: 450px;">
                <!-- Altura fija -->
                <div class="card-body d-flex flex-column h-100">
                    <h6 class="mb-3">Próximos eventos</h6>

                    <div class="flex-grow-1 overflow-auto">
                        @if (UpcomingEventsPage.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var upcoming in UpcomingEventsPage)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@upcoming.EventName</strong><br />
                                            <small class="text-muted">@upcoming.Date.ToString("dd/MM/yyyy")</small>
                                        </div>
                                        <span class="badge bg-primary rounded-pill">@upcoming.TotalGuests invitados</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted text-center">No hay eventos próximos.</div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick="PrevUpcomingEvents" disabled="@(upcomingEventsPage == 0)">Anterior</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="NextUpcomingEvents" disabled="@(upcomingEventsPage >= UpcomingEventsTotalPages - 1)">Siguiente</button>
                    </div>
                </div>
            </div>
        </div>



    </div>
}
else
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
