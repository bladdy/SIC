@using System.Globalization
@if (PlannerDashboards != null)
{
    <!--Datos generales planner-->
<div class="row g-4">
        <div class="row g-4 d-none d-md-flex">
            <div class="col-md-4">
                <div class="card shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6>Mis Créditos Disponibles</h6>
                        <h3>@UserCreditDTO?.AvailableCredits</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6>Mis Eventos Activos</h6>
                        <h3>@PlannerDashboards.MyEventsActive</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm text-center h-100">
                    <div class="card-body">
                        <h6>Mis Eventos Completados</h6>
                        <h3>@PlannerDashboards.MyEventsCompleted</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 d-block d-md-none">
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Mís Créditos Disponibles</strong>
                        <span>@UserCreditDTO?.AvailableCredits</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Eventos Activos</strong>
                        <span>@PlannerDashboards.MyEventsActive</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Eventos Completados</strong>
                        <span>@PlannerDashboards.MyEventsCompleted</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- Resumen de invitados del planner -->

@if (PlannerDashboards != null)
        {
            <div class="col-12 mt-3 d-none">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="mb-3 text-center">Resumen de invitados</h6>

                        @if (PlannerDashboards.TotalGuests > 0)
                        {
                            <div class="progress" style="height: 28px;">
                                @if (PlannerDashboards.ConfirmedGuests > 0)
                                {
                                    var confirmedPct = (double)PlannerDashboards.ConfirmedGuests / PlannerDashboards.TotalGuests * 100;
                                    <div class="progress-bar bg-success" style="width:@confirmedPct%">
                                        Confirmados: @PlannerDashboards.ConfirmedGuests
                                    </div>
                                }

                                @if (PlannerDashboards.PendingGuests > 0)
                                {
                                    var pendingPct = (double)PlannerDashboards.PendingGuests / PlannerDashboards.TotalGuests * 100;
                                    <div class="progress-bar bg-warning text-dark" style="width:@pendingPct%">
                                        Pendientes: @PlannerDashboards.PendingGuests
                                    </div>
                                }

                                @if (PlannerDashboards.NotAttendingGuests > 0)
                                {
                                    var notAttendPct = (double)PlannerDashboards.NotAttendingGuests / PlannerDashboards.TotalGuests * 100;
                                    <div class="progress-bar bg-danger" style="width:@notAttendPct%">
                                        No asistirán: @PlannerDashboards.NotAttendingGuests
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted">Sin datos de invitados</div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Top eventos por invitados -->
        <div class="col-12 mt-3">
            <div class="card shadow-sm" style="height: 580px;">
                <div class="card-body d-flex flex-column h-100">
                    <h5 class="mb-3"><strong>Próximos eventos</strong></h5>

                    <!-- Contenido scrollable -->
                    <div class="flex-grow-1 overflow-auto">
                        @foreach (var e in TopEventsPage)
                        {
                            var total = Math.Max(e.TotalGuests, 1);
                            var confirmedPct = e.ConfirmedGuests * 100.0 / total;
                            var pendingPct = e.PendingGuests * 100.0 / total;
                            var notAttendPct = e.NotAttendingGuests * 100.0 / total;

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <a href="/my-events/details/@e.Code" style="text-decoration:none;">
                                            <strong>@e.EventName</strong><br />
                                        </a>
                                        <small class="text-muted">@e.Date.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <small>@e.ConfirmedGuests Asistirán / @e.TotalGuests invitados</small>
                                </div>

                                <div class="progress" style="height:22px;">
                                    @if (e.ConfirmedGuests > 0)
                                    {
                                        <div class="progress-bar bg-success"
                                             style="width: @confirmedPct.ToString("F2", CultureInfo.InvariantCulture)%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <span class="small">@e.ConfirmedGuests</span>
                                        </div>
                                    }
                                    @if (e.PendingGuests > 0)
                                    {
                                        <div class="progress-bar bg-warning text-dark"
                                             style="width: @pendingPct.ToString("F2", CultureInfo.InvariantCulture)%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <span class="small">@e.PendingGuests</span>
                                        </div>
                                    }
                                    @if (e.NotAttendingGuests > 0)
                                    {
                                        <div class="progress-bar bg-danger"
                                             style="width: @notAttendPct.ToString("F2", CultureInfo.InvariantCulture)%; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <span class="small">@e.NotAttendingGuests</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Botones fijos al fondo -->
                    <div class="d-flex justify-content-between mt-2">
                        <button class="btn btn-sm btn-custom" @onclick="PrevTopEvents" disabled="@(topEventsPage == 0)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-compact-left"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M13 20l-3 -8l3 -8" /></svg>
                        </button>
                        <button class="btn btn-sm btn-custom" @onclick="NextTopEvents" disabled="@(topEventsPage >= TopEventsTotalPages - 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-compact-right"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M11 4l3 8l-3 8" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Próximos eventos -->
        <div class="col-md-6 col-12 mt-3 d-none">
            <div class="card shadow-sm" style="height: 450px;">
                <!-- Altura fija -->
                <div class="card-body d-flex flex-column h-100">
                    <h6 class="mb-3">Próximos eventos</h6>

                    <div class="flex-grow-1 overflow-auto">
                        @if (UpcomingEventsPage.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var upcoming in UpcomingEventsPage)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@upcoming.EventName</strong><br />
                                            <small class="text-muted">@upcoming.Date.ToString("dd/MM/yyyy")</small>
                                        </div>
                                        <span class="badge bg-primary rounded-pill">@upcoming.TotalGuests invitados</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted text-center">No hay eventos próximos.</div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mt-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick="PrevUpcomingEvents" disabled="@(upcomingEventsPage == 0)">Anterior</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="NextUpcomingEvents" disabled="@(upcomingEventsPage >= UpcomingEventsTotalPages - 1)">Siguiente</button>
                    </div>
                </div>
            </div>
        </div>



    </div>
}
else
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
