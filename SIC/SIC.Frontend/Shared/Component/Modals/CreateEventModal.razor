@using CurrieTechnologies.Razor.SweetAlert2
@using SIC.Shared.Entities
@using SIC.Shared.Enums
@using Microsoft.AspNetCore.Components.Forms

@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Crear Evento</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewEvent" OnValidSubmit="@SaveEventAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <!-- Asignar Usuario -->
                        <div class="mb-3">
                            <label class="form-label">Asignar a Usuario</label>
                            <input type="text" class="form-control mb-2"
                            placeholder="Filtrar usuarios..."
                            @bind="filterText"
                            @bind:event="oninput" />
                            <select class="form-select" @bind="NewEvent.UserId">
                                <option value="">-- Selecciona un usuario --</option>
                                @foreach (var user in FilteredUsers)
                                {
                                    <option value="@user.Id">@user.FullName (@user.UserType.GetDescription())</option>
                                }
                            </select>
                        </div>

                        <!-- Tipo de evento -->
                        <div class="mb-3">
                            <label class="form-label">Tipo de Evento</label>
                            <InputSelect class="form-select" @bind-Value="NewEvent.EventTypeId">
                                <option value="">-- Selecciona un tipo --</option>
                                @foreach (var type in EventTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <!-- Datos -->
                        <div class="mb-3">
                            <label class="form-label">Anfitrión(es)</label>
                            <InputText class="form-control" @bind-Value="NewEvent.Name" placeholder="Ej. Fernanda & Raúl" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nombre del Evento</label>
                            <InputText class="form-control" @bind-Value="NewEvent.SubTitle" placeholder="Ej. Nuestra Boda" />
                        </div>

                        <div class="mb-3 row">
                            <div class="col">
                                <label class="form-label">Fecha</label>
                                <InputDate class="form-control" @bind-Value="NewEvent.Date" />
                            </div>
                            <div class="col d-none">
                                <label class="form-label">Hora</label>
                                <InputTime CssClass="form-control" @bind-Value="NewEvent.Time" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">URL Invitacion</label>
                            <InputText class="form-control" @bind-Value="NewEvent.Url" placeholder="Ej. https://mi-invitacion.com.." />
                        </div>

                        <div class="mb-3 d-none">
                            <label class="form-label">Planner</label>
                            <InputText class="form-control" @bind-Value="NewEvent.Planner" />
                        </div>

                        <div class="mb-3 d-none">
                            <label class="form-label">Teléfono Planner</label>
                            <InputText class="form-control" @bind-Value="NewEvent.PlannerPhone" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="NewEvent.Status">
                                <option value="">-- Selecciona un Estado --</option>
                                @foreach (var status in Enum.GetValues<Status>())
                                {
                                    <option value="@status">@status.GetDescription()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => NewEvent.Status)" />
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom">Guardar</button>
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    public List<EventType> EventTypes { get; set; } = new();
    public List<User> AllUsers { get; set; } = new();
    [Parameter] public EventCallback<Event> OnSaved { get; set; }

    [Inject] private IRepository Repository { get; set; } = default!;
    [Inject] private SweetAlertService SweetAlertService { get; set; } = default!;

    private Event NewEvent = new();
    private string filterText = string.Empty;

    private IEnumerable<User> FilteredUsers =>
                string.IsNullOrWhiteSpace(filterText)
                    ? AllUsers
                    : AllUsers.Where(u =>
                        u.FullName.Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
                        u.PhoneNumber!.Contains(filterText, StringComparison.OrdinalIgnoreCase) ||
                        u.Email!.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadEventTypes();
        await LoadUsersAsync();
    }
    private async Task SaveEventAsync()
    {
        if (string.IsNullOrEmpty(NewEvent.UserId))
        {
            await SweetAlertService.FireAsync("Error", "Debes asignar un usuario al evento.", SweetAlertIcon.Error);
            return;
        }
        var HostUser = AllUsers.FirstOrDefault(u => u.Id == NewEvent.UserId);
        if (HostUser == null)
        {
            await SweetAlertService.FireAsync("Error", "El usuario asignado no es válido.", SweetAlertIcon.Error);
            return;
        }
        NewEvent.Host = HostUser.FullName;
        NewEvent.HostPhone = HostUser.PhoneNumber!;
        var response = await Repository.PostAsync("api/Events/full", NewEvent);
        if (response.Error)
        {
            await SweetAlertService.FireAsync("Error", "No se pudo guardar el evento.", SweetAlertIcon.Error);
            return;
        }

        await SweetAlertService.FireAsync("Éxito", "Evento creado correctamente.", SweetAlertIcon.Success);
        await OnSaved.InvokeAsync(NewEvent);
        await Close();
    }
    private async Task LoadUsersAsync()
    {
        var result = await Repository.GetAsync<List<User>>("api/Accounts/all");
        if (result != null)
        {
            // Excluir Admin y WeddingPlanner
            AllUsers = result.Response!
                //.Where(u => u.UserType != UserType.Admin && u.UserType != UserType.WeddingPlanner)
                .ToList();
        }
    }
    private async Task LoadEventTypes()
    {
        var response = await Repository.GetAsync<List<EventType>>("api/EventTypes");
        if (!response.Error)
            EventTypes = response.Response;
    }
    private async Task Close() => await ShowChanged.InvokeAsync(false);
}
