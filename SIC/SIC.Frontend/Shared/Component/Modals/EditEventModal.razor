@using CurrieTechnologies.Razor.SweetAlert2
@using SIC.Shared.Entities
@using SIC.Shared.Enums
@using Microsoft.AspNetCore.Components.Forms

@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Evento: @EventModel.Code</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@EventModel" OnValidSubmit="@SaveEventAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <!-- Campos similares al modal anterior -->
                        <div class="mb-3">
                            <label class="form-label">Tipo de Evento</label>
                            <InputSelect class="form-select" @bind-Value="EventModel.EventTypeId">
                                <option value="">-- Selecciona un tipo --</option>
                                @foreach (var type in EventTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Anfitrión(es)</label>
                            <InputText class="form-control" @bind-Value="EventModel.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nombre del Evento</label>
                            <InputText class="form-control" @bind-Value="EventModel.SubTitle" />
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom">Guardar Cambios</button>
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public Event EventModel { get; set; } = new();
    [Parameter] public List<EventType> EventTypes { get; set; } = new();
    [Parameter] public EventCallback<Event> OnSaved { get; set; }

    [Inject] private IRepository Repository { get; set; } = default!;
    [Inject] private SweetAlertService SweetAlertService { get; set; } = default!;

    private async Task SaveEventAsync()
    {
        var response = await Repository.PutAsync("api/Events/full", EventModel);
        if (response.Error)
        {
            await SweetAlertService.FireAsync("Error", "No se pudo actualizar el evento.", SweetAlertIcon.Error);
            return;
        }

        await SweetAlertService.FireAsync("Éxito", "Evento actualizado correctamente.", SweetAlertIcon.Success);
        await OnSaved.InvokeAsync(EventModel);
        await Close();
    }

    private async Task Close() => await ShowChanged.InvokeAsync(false);
}
