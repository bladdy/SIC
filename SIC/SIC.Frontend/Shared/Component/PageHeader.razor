@namespace SIC.Frontend.Shared.Component

<div class="sic-header">
    <div class="sic-header-main">
        <div class="sic-header-icon">
            @if (Icon =="tools-kitchen-2")
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-tools-kitchen-2"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19 3v12h-5c-.023 -3.681 .184 -7.406 5 -12m0 12v6h-1v-3m-10 -14v17m-3 -17v3a3 3 0 1 0 6 0v-3" /></svg>
            }
            else
            {
                <i class="bi @Icon"></i>
            }

        </div>
        <div>
            <h1 class="sic-header-title">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <span class="sic-header-subtitle">@Subtitle</span>
            }
        </div>
    </div>
    @if (ChildContent is not null || Actions is not null)
    {
        <div class="sic-header-actions">
            @ChildContent
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi-box";
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}