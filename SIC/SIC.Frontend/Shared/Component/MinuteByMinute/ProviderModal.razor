@using SIC.Frontend.Pages.MinuteByMinute

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content" style="border-radius: 12px; border: none;">
                <div class="modal-header" style="background: #3C6A79; color: white; border-radius: 12px 12px 0 0;">
                    <h5 class="modal-title fw-semibold">
                        <i class="bi bi-truck me-2"></i>@(IsEdit ? "Editar Proveedor" : "Nuevo Proveedor")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="OnClose"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre *</label>
                        <input class="form-control" @bind="Model.Name" placeholder="Ej. Catering La Maison" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contacto</label>
                        <input class="form-control" @bind="Model.Contact" placeholder="Ej. 555-0101" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Servicio</label>
                        <input class="form-control" @bind="Model.Service" placeholder="Ej. Decoracion floral" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Costo</label>
                        <input type="number" class="form-control" @bind="Model.Cost" placeholder="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estado</label>
                        <select class="form-select" @bind="Model.Status">
                            <option value="Confirmado">Confirmado</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #e9ecef;">
                    <button class="btn btn-custom btn-sm" @onclick="OnSave">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="OnClose">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public MbMProvider Model { get; set; } = default!;
    [Parameter] public EventCallback OnSave { get; set; }

    private async Task OnClose()
    {
        await IsVisibleChanged.InvokeAsync(false);
    }
}
