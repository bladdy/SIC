<!-- Mobile: all stats inside one card, horizontal rows -->
<div class="card shadow-sm mb-2 d-flex d-md-none" style="border-radius: 12px; border: none;">
    <div class="card-body py-0">
        <div class="d-flex justify-content-between align-items-center" >
            <small class="text-muted">Total</small>
            <div class="fw-bold fs-5" style="color: #3C6A79;">@Total</div>
        </div>
        <div class="d-flex justify-content-between align-items-center" >
            <small class="text-muted">Completadas</small>
            <div class="fw-bold fs-5 text-success">@Completed</div>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">En Progreso</small>
            <div class="fw-bold fs-5" style="color: #e6a800;">@InProgress</div>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Pendientes</small>
            <div class="fw-bold fs-5 text-secondary">@Pending</div>
        </div>
    </div>
</div>

<!-- Desktop: each stat is its own card in a row -->
<div class="row g-3 mb-4 d-none d-md-flex">
    <div class="col-md-3">
        <div class="card shadow-sm mbm-stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="mbm-stat-icon" style="background: rgba(60,106,121,0.12); color: #3C6A79;">
                    <i class="bi bi-list-task"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4" style="color: #3C6A79;">@Total</div>
                    <small class="text-muted">Total de Actividades</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm mbm-stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="mbm-stat-icon" style="background: rgba(25,135,84,0.12); color: #198754;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4 text-success">@Completed</div>
                    <small class="text-muted">Completadas</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm mbm-stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="mbm-stat-icon" style="background: rgba(255,193,7,0.12); color: #ffc107;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4" style="color: #e6a800;">@InProgress</div>
                    <small class="text-muted">En Progreso</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm mbm-stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="mbm-stat-icon" style="background: rgba(108,117,125,0.12); color: #6c757d;">
                    <i class="bi bi-clock"></i>
                </div>
                <div>
                    <div class="fw-bold fs-4 text-secondary">@Pending</div>
                    <small class="text-muted">Pendientes</small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Total { get; set; }
    [Parameter] public int Completed { get; set; }
    [Parameter] public int InProgress { get; set; }
    [Parameter] public int Pending { get; set; }
}
