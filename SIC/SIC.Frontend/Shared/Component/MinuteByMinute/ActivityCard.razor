@using SIC.Frontend.Pages.MinuteByMinute

<div class="card shadow-sm mbm-card">
    <div class="card-header mbm-card-header py-3" @onclick="ToggleExpand"
         style="background: white; border-bottom: 1px solid #e9ecef;">
        <div class="d-flex align-items-start justify-content-between">
            <div class="d-flex align-items-start gap-3 flex-grow-1">
                <span class="mbm-time-badge mt-1">
                    <i class="bi bi-clock me-1"></i>@Activity.StartTime.ToString("HH:mm")
                    @if (Activity.EndTime.HasValue)
                    {
                        <span> - @Activity.EndTime.Value.ToString("HH:mm")</span>
                    }
                </span>
                <div class="flex-grow-1">
                    <h6 class="mb-1 fw-bold">@Activity.Title</h6>
                    <small class="text-muted">@Activity.Description</small>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="badge bg-@(GetStatusColor())">@Activity.Status</span>
                        <span class="badge bg-@(GetPriorityColor())">@Activity.Priority</span>
                        @if (!string.IsNullOrWhiteSpace(Activity.Location))
                        {
                            <span class="badge" style="background: #e9ecef; color: #495057;">
                                <i class="bi bi-geo-alt me-1"></i>@Activity.Location
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="dropdown d-flex align-items-center gap-1">
                <button class="btn btn-sm btn-link text-secondary p-0" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots-vertical fs-5"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button class="dropdown-item" @onclick:stopPropagation @onclick="OnEdit">
                            <i class="bi bi-pencil me-2 text-primary"></i>Editar
                        </button>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button class="dropdown-item text-danger" @onclick:stopPropagation @onclick="OnDelete">
                            <i class="bi bi-trash me-2"></i>Eliminar
                        </button>
                    </li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-1 d-none">
                <button class="btn btn-sm btn-outline-primary rounded-circle" style="width:32px;height:32px;"
                        title="Editar" @onclick:stopPropagation @onclick="OnEdit">
                    <i class="bi bi-pencil" style="font-size: 0.75rem;"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger rounded-circle" style="width:32px;height:32px;"
                        title="Eliminar" @onclick:stopPropagation @onclick="OnDelete">
                    <i class="bi bi-trash" style="font-size: 0.75rem;"></i>
                </button>
                <button class="btn btn-sm btn-link text-secondary p-0" @onclick:stopPropagation @onclick="ToggleExpand">
                    <i class="bi @(IsExpanded ? "bi-chevron-up" : "bi-chevron-down") fs-5"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="mbm-expand-section @(IsExpanded ? "expanded" : "")">
        <div class="card-body pt-0">
            @if (!string.IsNullOrWhiteSpace(Activity.Notes))
            {
                <div class="alert alert-light mb-3 mt-2" style="border-left: 3px solid #3C6A79;">
                    <small><i class="bi bi-info-circle me-1"></i>@Activity.Notes</small>
                </div>
            }

            <!-- TAREAS -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-semibold mb-0" style="color: #3C6A79;">
                        <i class="bi bi-check2-square me-1"></i>Tareas
                        <span class="badge bg-secondary rounded-pill ms-1" style="font-size: 0.7rem;">@Activity.Tasks.Count</span>
                    </h6>
                    <button class="btn btn-sm btn-outline-success" @onclick="OnAddTask">
                        <i class="bi bi-plus-lg"></i> Tarea
                    </button>
                </div>
                @if (Activity.Tasks.Any())
                {
                    @foreach (var task in Activity.Tasks)
                    {
                        <div class="d-flex align-items-center gap-2 py-1 @(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                            <input type="checkbox" class="form-check-input mbm-task-check"
                                   checked="@task.IsCompleted"
                                   @onclick="() => OnToggleTask(task)" />
                            <span class="flex-grow-1" style="font-size: 0.9rem;">@task.Title</span>
                            <span class="badge bg-@(GetPriorityColorForTask(task.Priority))" style="font-size: 0.65rem;">@task.Priority</span>
                            <button class="btn btn-sm text-muted p-0" style="font-size: 0.7rem;"
                                    @onclick="() => OnEditTask(task)" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm text-danger p-0" style="font-size: 0.7rem;"
                                    @onclick="() => OnDeleteTask(task)" title="Eliminar">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <small class="text-muted">Sin tareas registradas.</small>
                }
            </div>

            <hr class="my-2" />

            <!-- PROVEEDORES -->
            <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-semibold mb-0" style="color: #3C6A79;">
                        <i class="bi bi-truck me-1"></i>Proveedores
                        <span class="badge bg-secondary rounded-pill ms-1" style="font-size: 0.7rem;">@Activity.Providers.Count</span>
                    </h6>
                    <button class="btn btn-sm btn-outline-success" @onclick="OnAddProvider">
                        <i class="bi bi-plus-lg"></i> Proveedor
                    </button>
                </div>
                @if (Activity.Providers.Any())
                {
                    <div class="row g-2">
                        @foreach (var provider in Activity.Providers)
                        {
                            <div class="col-12 col-md-6">
                                <div class="mbm-provider-card">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-semibold" style="font-size: 0.9rem;">@provider.Name</div>
                                            <small class="text-muted">@provider.Service</small>
                                            <div><small><i class="bi bi-telephone me-1"></i>@provider.Contact</small></div>
                                            @if (provider.Cost.HasValue)
                                            {
                                                <div><small class="fw-semibold text-success">$@provider.Cost.Value.ToString("N0")</small></div>
                                            }
                                        </div>
                                        <div class="d-flex flex-column align-items-end gap-1">
                                            <span class="badge @(provider.Status == "Confirmado" ? "bg-success" : "bg-warning text-dark")" style="font-size: 0.65rem;">
                                                @provider.Status
                                            </span>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm text-muted p-0" style="font-size: 0.7rem;"
                                                        @onclick="() => OnEditProvider(provider)" title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm text-danger p-0" style="font-size: 0.7rem;"
                                                        @onclick="() => OnDeleteProvider(provider)" title="Eliminar">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <small class="text-muted">Sin proveedores registrados.</small>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public MbMActivity Activity { get; set; } = default!;
    [Parameter] public EventCallback<MbMActivity> OnEditActivity { get; set; }
    [Parameter] public EventCallback<MbMActivity> OnDeleteActivity { get; set; }
    [Parameter] public EventCallback<MbMActivity> OnAddTaskClick { get; set; }
    [Parameter] public EventCallback<(MbMActivity, MbMTask)> OnEditTaskClick { get; set; }
    [Parameter] public EventCallback<(MbMActivity, MbMTask)> OnDeleteTaskClick { get; set; }
    [Parameter] public EventCallback<(MbMActivity, MbMTask)> OnToggleTaskClick { get; set; }
    [Parameter] public EventCallback<MbMActivity> OnAddProviderClick { get; set; }
    [Parameter] public EventCallback<(MbMActivity, MbMProvider)> OnEditProviderClick { get; set; }
    [Parameter] public EventCallback<(MbMActivity, MbMProvider)> OnDeleteProviderClick { get; set; }

    private bool IsExpanded;

    private void ToggleExpand() => IsExpanded = !IsExpanded;

    private async Task OnEdit() => await OnEditActivity.InvokeAsync(Activity);
    private async Task OnDelete() => await OnDeleteActivity.InvokeAsync(Activity);
    private async Task OnAddTask() => await OnAddTaskClick.InvokeAsync(Activity);
    private async Task OnEditTask(MbMTask task) => await OnEditTaskClick.InvokeAsync((Activity, task));
    private async Task OnDeleteTask(MbMTask task) => await OnDeleteTaskClick.InvokeAsync((Activity, task));
    private async Task OnToggleTask(MbMTask task) => await OnToggleTaskClick.InvokeAsync((Activity, task));
    private async Task OnAddProvider() => await OnAddProviderClick.InvokeAsync(Activity);
    private async Task OnEditProvider(MbMProvider provider) => await OnEditProviderClick.InvokeAsync((Activity, provider));
    private async Task OnDeleteProvider(MbMProvider provider) => await OnDeleteProviderClick.InvokeAsync((Activity, provider));

    private string GetStatusColor() => Activity.Status switch
    {
        ActivityStatus.Completada => "success",
        ActivityStatus.EnProgreso => "warning",
        ActivityStatus.Pendiente => "secondary",
        ActivityStatus.Cancelada => "danger",
        _ => "secondary"
    };

    private string GetPriorityColor() => Activity.Priority switch
    {
        Priority.Alta => "danger",
        Priority.Media => "warning",
        Priority.Baja => "info",
        _ => "secondary"
    };

    private string GetPriorityColorForTask(Priority p) => p switch
    {
        Priority.Alta => "danger",
        Priority.Media => "warning",
        Priority.Baja => "info",
        _ => "secondary"
    };
}
