@using SIC.Shared.Enums
@using SIC.Shared.Entities

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none;">
                <div class="modal-header" style="background: #3C6A79; color: white; border-radius: 12px 12px 0 0;">
                    <h5 class="modal-title fw-semibold">
                        <i class="bi bi-calendar-event me-2"></i>@(IsEdit ? "Editar Actividad" : "Nueva Actividad")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="OnClose"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Titulo *</label>
                        <input class="form-control" @bind="Model.Title" placeholder="Ej. Ceremonia principal" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Responsable</label>
                            <input class="form-control" @bind="Model.Responsible" placeholder="Ej. Carlos" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Tipo / Cargo</label>
                            <input class="form-control" @bind="Model.ResponsibleRole" placeholder="Ej. Coordinador" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Número de Responsable</label>
                        <input class="form-control" @bind="Model.ResponsiblePhone" placeholder="Ej. 866 123 4567" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripcion</label>
                        <textarea class="form-control" rows="2" @bind="Model.Description" placeholder="Descripcion de la actividad..."></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Fecha *</label>
                            <input type="date" class="form-control" value="@Fecha"
                                   @onchange="(ChangeEventArgs e) => Fecha = e.Value?.ToString()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Hora *</label>
                            <input type="time" class="form-control" value="@Hora"
                                   @onchange="(ChangeEventArgs e) => Hora = e.Value?.ToString()" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estado</label>
                        <select class="form-select" @bind="Model.Status">
                            @foreach (var s in Enum.GetValues<ActivityStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ubicacion</label>
                        <input class="form-control" @bind="Model.Location" placeholder="Ej. Salon Principal" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notas</label>
                        <textarea class="form-control" rows="2" @bind="Model.Notes" placeholder="Notas adicionales..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #e9ecef;">
                    <button class="btn btn-custom" @onclick="OnSave">
                        <i class="bi bi-check-lg me-1"></i>Guardar
                    </button>
                    <button class="btn btn-secondary" @onclick="OnClose">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public MbMActivity Model { get; set; } = default!;
    [Parameter] public EventCallback OnSave { get; set; }

    private string Fecha
    {
        get => Model.StartTime == default ? "" : Model.StartTime.ToString("yyyy-MM-dd");
        set
        {
            if (DateTime.TryParse(value, out var date))
            {
                Model.StartTime = date.Date.Add(Model.StartTime.TimeOfDay);
            }
        }
    }

    private string Hora
    {
        get => Model.StartTime == default ? "" : Model.StartTime.ToString("HH:mm");
        set
        {
            if (TimeSpan.TryParse(value, out var time))
            {
                Model.StartTime = Model.StartTime.Date.Add(time);
            }
        }
    }

    private async Task OnClose()
    {
        await IsVisibleChanged.InvokeAsync(false);
    }
}
