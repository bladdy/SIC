@using System.Security.Claims

<AuthorizeView>
    <Authorized>
        @{
            // Obtener el ID del usuario autenticado
            var userId = context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var userName = context.User.Identity?.Name;
        }

        <div class="d-flex justify-content-center align-items-center gap-3">
            <p class="m-0 p-0 fw-bold">Hola, @userName</p>
            <a href="Logout" class="btn btn-custom d-none d-md-block text-decoration-none">Cerrar Sesión</a>
        </div>

    </Authorized>

    <NotAuthorized>
        <button href="login" class="btn btn-custom">Iniciar Sesión</button>
    </NotAuthorized>
</AuthorizeView>
