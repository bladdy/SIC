@page "/upload-photo/{Code}"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Subir fotos</PageTitle>
<div class="container-fluid min-vh-100 position-relative text-light" style=" margin: 0; padding: 0;">
    <!-- Contenedor principal sin margen superior -->
    <div style="width: 100%; font-family: Arial, sans-serif;">

        <!-- Imagen de portada con overlay -->
        <div style="position: relative; width: 100%; height: 440px; overflow: hidden; margin: 0; padding: 0;">
            @if (Event is not null)
            {
                <img src="@Event!.CoverImageUrl"
                alt="Portada del evento"
                style="width: 100%; height: 440px; object-fit: cover; object-position: center;" />

                <!-- Overlay con título y código -->
                <div style="position: absolute; bottom: 20px; left: 20px; color: white; text-align: left;
                            text-shadow: 0 0 10px rgba(0,0,0,0.7);">
                    <h1 style="font-size: 2.5rem; margin: 0;">📸 Álbum del Evento: @Event.Name </h1>
                    <p style="font-size: 1rem; margin: 5px 0 0 0;">Código del evento: <strong>@Code</strong></p>
                </div>

            }

        </div>
        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <div class="d-flex flex-column gap-3" style="width: 300px;">

                <!-- InputFile cámara -->
                <InputFile class="d-none"
                           id="cameraInput"
                           OnChange="HandleFileSelected"
                           accept="image/*"
                           capture="environment" />

                <button class="btn btn-sm btn-outline-secondary w-100"
                        type="button"
                        onclick="document.getElementById('cameraInput').click()">
                    📷 Tomar foto
                </button>
                <!-- InputFile normal -->
                <InputFile class="d-none"
                           id="fileInput"
                           OnChange="HandleFileSelected"
                           multiple
                           accept="image/*" />

                <label for="fileInput"
                       class="form-control form-control-sm text-center"
                       style="cursor:pointer;">
                    Elige una imagen
                    @if (selectedFiles != null && selectedFiles.Count > 0)
                    {
                        <strong>(@selectedFiles.Count archivo(s))</strong>
                    }
                </label>

                

                <!-- Botón subir -->
                <button class="btn btn-sm btn-custom w-100"
                        @onclick="UploadPhoto"
                        disabled="@(!hasFileSelected || isLoadingImport)">
                    @if (isLoadingImport)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Cargando...</span>
                    }
                    else
                    {
                        <span>Subir Imagen</span>
                    }
                </button>

                <div class="d-flex mb-2">
                    <button class="btn btn-sm btn-custom w-100"
                            type="button"
                            data-bs-toggle="popover"
                            data-bs-placement="bottom"
                            data-bs-html="true"
                            title="¿Cómo subir tu imagen?"
                            data-bs-content="<ol style='padding-left:1rem; margin:0;'>
                                            <li>Toma una Foto o Selecciona imágen(es)</li>
                                            <li>Solo formatos JPG o PNG</li>
                                            <li>Tamaño máximo recomendado: 5MB</li>
                                            <li>Evita imágenes borrosas</li>
                                        </ol>
                                ">
                            ❔ Ayuda
                    </button>
                </div>



            </div>
        </div>

        <!--Album Publico, si es publico carga todas las imagenes del album para que cualquiera la pueda descargar-->
        @if (Event is not null && Event.AlbumPublic)
        {
            <div style="padding: 1rem; font-family: Arial, sans-serif;">
                <!-- Header -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                    <h2 style="margin: 0; color: black;">📸 Álbum del Evento (@EventImages!.Count)</h2>
                </div>

                <!-- Cargando / vacío / imágenes -->
                @if (EventImages == null)
                {
                    <p style="color: #6c757d;">Cargando imágenes...</p>
                }
                else if (!EventImages.Any())
                {
                    <div style="padding: 2rem; text-align: center; color: #6c757d; border: 1px dashed #dee2e6; border-radius: 0.25rem;">
                        <p>No hay imágenes en este álbum aún.</p>
                    </div>
                }
                else
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
                        @foreach (var image in EventImages)
                        {
                            <div style="overflow: hidden; border-radius: 0.25rem; cursor: pointer;">
                                <img src="@image.Url"
                                     alt="Imagen del evento"
                                     loading="lazy"
                                     @onclick="() => OpenPreview(image)"
                                     style="width: 100%; height: 250px; display: block; object-fit: cover; border-radius: 0.25rem;" />
                            </div>
                        }
                    </div>
                }
            </div>

        }
    </div>
</div>


@if (PreviewImage != null && !string.IsNullOrEmpty(PreviewImage.Url))
{
    <div @onclick="ClosePreview"
         style="position: fixed;
                inset: 0;
                background-color: rgba(0,0,0,0.8);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 9999;">

        <!-- Contenedor de la imagen -->
        <div style="position: relative;" @onclick:stopPropagation>
            <!-- Imagen -->
            <img src="@PreviewImage.Url"
                 style="max-width: 90vw;
                        max-height: 90vh;
                        border-radius: 0.25rem;" />
        </div>
    </div>
}