@page "/upload-photo/{Code}"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Subir fotos</PageTitle>
<div class="container-fluid min-vh-100 position-relative text-light" style=" margin: auto; padding: 0;">
    <!-- Contenedor principal sin margen superior -->
    <div style="width: 100%; font-family: Arial, sans-serif;">

        <!-- Imagen de portada con overlay -->
        <div style="
                position: relative;
                width: 100%;
                aspect-ratio: 3 / 1;
                min-height: 280px;
                max-height: 440px;
                overflow: hidden;
                margin-bottom: 1.5rem;
        ">

            @if (Event is not null && Event.CoverAlbumImageUrl is not null)
            {

                <!-- Imagen -->
                <img src="@Event.CoverAlbumImageUrl"
                alt="Portada del evento"
                style="
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: @($"{Event.CoverPositionX}% {Event.CoverPositionY}%");
                display: block;
                " />

                <!-- Overlay degradado (mejora legibilidad en mobile) -->
                <div style="
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to top,
                rgba(0,0,0,0.6),
                rgba(0,0,0,0)
            );
                "></div>

                <!-- Texto -->
                <div style="
            position: absolute;
            bottom: clamp(12px, 4vw, 24px);
            left: clamp(12px, 4vw, 24px);
            right: clamp(12px, 4vw, 24px);
            color: white;
            text-align: left;
            text-shadow: 0 0 10px rgba(0,0,0,0.7);
            max-width: 100%;
                ">

                    <p style="
                font-size: clamp(0.85rem, 2.5vw, 1rem);
                margin: 0 0 4px 0;
                line-height: 1.3;
                opacity: 0.9;
                    ">
                        @Event.SubTitle
                    </p>

                    <h1 style="
                font-size: clamp(1.4rem, 5vw, 2.2rem);
                margin: 0;
                line-height: 1.15;
                word-break: break-word;
                    ">
                        @Event.Name
                    </h1>

                </div>
            }

        </div>
        <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
            <div class="d-flex flex-column gap-3" style="width: 340px;">

                <!-- InputFile cámara -->
                <InputFile class="d-none"
                id="cameraInput"
                OnChange="HandleFileSelected"
                accept="image/*,video/*"
                capture="environment" />


                <button class="btn btn-sm btn-outline-secondary w-100"
                type="button"
                onclick="document.getElementById('cameraInput').click()">
                    📷 Tomar foto o video
                </button>
                <!-- InputFile normal -->
                <InputFile class="d-none"
                id="fileInput"
                OnChange="HandleFileSelected"
                multiple
                accept="image/*,video/mp4,audio/mpeg" />

                <label for="fileInput"
                class="form-control form-control-sm text-center"
                style="cursor:pointer;">
                    @if (selectedFiles != null && selectedFiles.Count > 0)
                    {
                        <strong>@selectedFiles.Count Archivo(s) seleccionado(s)</strong>
                    }
                    else
                    {

                        <strong>Seleccionar Archivos (imagenes, audio y video)</strong>
                    }
                </label>

                

                <!-- Botón subir -->
                <button class="btn btn-sm btn-custom w-100"
                        @onclick="UploadPhoto"
                        disabled="@(!hasFileSelected || isLoadingImport)">
                    @if (isLoadingImport)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Cargando...</span>
                    }
                    else
                    {
                        <span>Subir Archivo</span>
                    }
                </button>

                <div class="d-flex mb-2">
                    <button class="btn btn-sm btn-custom w-100"
                            data-bs-toggle="popover"
                            data-bs-placement="bottom"
                            data-bs-html="true"
                            title="¿Cómo subir un archivo?"
                            data-bs-content="<ol style='padding-left:1rem; margin:0;'>
                                                <li>Toma una foto, video o selecciona archivos desde tu galería.</li>
                                                <li>Formatos permitidos:
                                                    <strong>JPG, PNG, WEBP, MP4, MOV y MP3</strong>.
                                                </li>
                                                <li>Tamaño máximo recomendado:
                                                    <strong>10 MB por archivo</strong>.
                                                </li>
                                                <li>Evita imágenes borrosas o videos con poca iluminación.</li>
                                                <li>Puedes seleccionar múltiples archivos al mismo tiempo.</li>
                                                <li>Espera a que finalice la carga antes de cerrar la página.</li>
                                            </ol>">
                                        Instrucciones
                    </button>
                </div>



            </div>
        </div>

        <!--Album Publico, si es publico carga todas las imagenes del album para que cualquiera la pueda descargar-->
        @if (Event is not null && Event.AlbumPublic)
        {
            <div style="padding: 1rem; font-family: Arial, sans-serif;">
                <!-- Header -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                    <h2 style="margin: 0; color: #3C6A79;">Galería (@EventImages!.Count)</h2>
                </div>

                <!-- Cargando / vacío / imágenes -->
                @if (EventImages == null)
                {
                    <p style="color: #6c757d;">Cargando imágenes...</p>
                }
                else if (!EventImages.Any())
                {
                    <div style="padding: 2rem; text-align: center; color: #6c757d; border: 1px dashed #dee2e6; border-radius: 0.25rem;">
                        <p>No hay imágenes en este álbum aún.</p>
                    </div>
                }
                else
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
                        @foreach (var image in EventImages)
                        {
                            <div style="overflow: hidden; border-radius: 0.25rem; cursor: pointer;">
                                <img src="@image.Url"
                                     alt="Imagen del evento"
                                     loading="lazy"
                                     @onclick="() => OpenPreview(image)"
                                     style="width: 100%; height: 250px; display: block; object-fit: cover; border-radius: 0.25rem;" />
                            </div>
                        }
                    </div>
                }
            </div>

        }
    </div>
</div>


@if (PreviewImage != null && !string.IsNullOrEmpty(PreviewImage.Url))
{
    <div @onclick="ClosePreview"
         style="position: fixed;
                inset: 0;
                background-color: rgba(0,0,0,0.8);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 9999;">

        <!-- Contenedor de la imagen -->
        <div style="position: relative;" @onclick:stopPropagation>
            <!-- Imagen -->
            <img src="@PreviewImage.Url"
                 style="max-width: 90vw;
                        max-height: 90vh;
                        border-radius: 0.25rem;" />
        </div>
    </div>
}