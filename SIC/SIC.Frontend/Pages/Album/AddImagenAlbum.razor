@page "/upload-photo/{Code}"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Subir fotos</PageTitle>
<div class="container-fluid min-vh-100 position-relative text-light" style=" margin: auto; padding: 0; background-color:#3C6A79;">
    <!-- Contenedor principal sin margen superior -->
    <div style="width: 100%; font-family: Arial, sans-serif;">

        <!-- Imagen de portada con overlay -->
        <div style="
                position: relative;
                width: 100%;
                aspect-ratio: 3 / 1;
                min-height: 280px;
                max-height: 440px;
                overflow: hidden;
                padding:10px;
        ">

            @if (Event is not null && Event.CoverAlbumImageUrl is not null)
            {

                <!-- Imagen -->
                <img src="@Event.CoverAlbumImageUrl"
                alt="Portada del evento"
                style="
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: @($"{Event.CoverPositionX}% {Event.CoverPositionY}%");
                display: block;

                border-radius:12px;
                " />

                <!-- Overlay degradado (mejora legibilidad en mobile) -->
                <div style="
            position: absolute;
            inset: 0;
                "></div>

                <!-- Texto -->
                <div style="
            position: absolute;
            bottom: clamp(22px, 4vw, 24px);
            left: clamp(22px, 4vw, 24px);
            right: clamp(12px, 4vw, 24px);
            color: white;
            text-align: left;
            text-shadow: 0 0 10px rgba(0,0,0,0.7);
            max-width: 100%;
                ">

                    <p style="
                font-size: clamp(0.85rem, 2.5vw, 1rem);
                margin: 0 0 4px 0;
                line-height: 1.3;
                opacity: 0.9;
                    ">
                        @Event.SubTitle
                    </p>

                    <h1 style="
                font-size: clamp(1.4rem, 5vw, 2.2rem);
                margin: 0;
                line-height: 1.15;
                word-break: break-word;
                    ">
                        @Event.Name
                    </h1>

                </div>
            }

        </div>
        <div style="width: 100%;">

            <div class="card" style="border-top-left-radius:12px;border-top-right-radius:12px;">
                <div class="card-body">

                    <!-- Label centrado -->
                    <label class="card-title d-block text-center fw-bold mb-2"
                    style="color: #3C6A79;">
                        ¿Qué deseas agregar al álbum?
                    </label>

                    <div class="container-fluid px-1">
                        <div class="row g-2">

                            <!-- FOTO -->
                            <div class="col-3 d-flex">
                                <button class="btn w-100 d-flex flex-column align-items-center justify-content-center"
                                @onclick='() => ChangeTab("foto")'
                                style="@GetTabStyle("foto")">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2" />
                                        <path d="M9 13a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                                    </svg>

                                    <div style="font-size:13px;font-weight:500;">
                                        Foto
                                    </div>
                                </button>
                            </div>

                            <!-- VIDEO -->
                            <div class="col-3 d-flex">
                                <button class="btn w-100 d-flex flex-column align-items-center justify-content-center"
                                @onclick='() => ChangeTab("video")'
                                style="@GetTabStyle("video")">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12" />
                                        <path d="M8 4l0 16" />
                                        <path d="M16 4l0 16" />
                                    </svg>

                                    <div style="font-size:13px;font-weight:500;">
                                        Reels
                                    </div>
                                </button>
                            </div>

                            <!-- AUDIO -->
                            <div class="col-3 d-flex">
                                <button class="btn w-100 d-flex flex-column align-items-center justify-content-center"
                                @onclick='() => ChangeTab("audio")'
                                style="@GetTabStyle("audio")">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M9 5a3 3 0 0 1 3 -3a3 3 0 0 1 3 3v5a3 3 0 0 1 -3 3a3 3 0 0 1 -3 -3l0 -5" />
                                        <path d="M5 10a7 7 0 0 0 14 0" />
                                        <path d="M12 17l0 4" />
                                    </svg>

                                    <div style="font-size:13px;font-weight:500;">
                                        Audio
                                    </div>
                                </button>
                            </div>

                            <!-- TEXTO -->
                            <div class="col-3 d-flex">
                                <button class="btn w-100 d-flex flex-column align-items-center justify-content-center"
                                @onclick='() => ChangeTab("texto")'
                                style="@GetTabStyle("texto")">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                                        <path d="M13.5 6.5l4 4" />
                                    </svg>

                                    <div style="font-size:13px;font-weight:500;">
                                        Texto
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- OPCIONES SEGUN TAB -->
                    <div class="card mt-2"
                    style="border-radius:16px;
                        border:1px solid #ebe7e2;
                        overflow:hidden;">

                        <!-- HEADER -->
                        <div style="background:#3C6A79;
                            color:white;
                            padding:8px 16px; font-size:12px;
                            font-weight:400; align-items:start; 
                            display:flex; justify-items:start; gap:12px;">

                            @if (ActiveTab == "foto")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2" />
                                    <path d="M9 13a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                                </svg>
                                <span>Foto</span>
                            }
                            else if (ActiveTab == "video")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12" />
                                    <path d="M8 4l0 16" />
                                    <path d="M16 4l0 16" />
                                </svg>
                                <span>Reels</span>
                            }
                            else if (ActiveTab == "audio")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M9 5a3 3 0 0 1 3 -3a3 3 0 0 1 3 3v5a3 3 0 0 1 -3 3a3 3 0 0 1 -3 -3l0 -5" />
                                    <path d="M5 10a7 7 0 0 0 14 0" />
                                    <path d="M12 17l0 4" />
                                </svg>
                                <span>Audio</span>
                            }
                            else if (ActiveTab == "texto")
                            {
                                <svg xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                                    <path d="M13.5 6.5l4 4" />
                                </svg>
                                <span>Texto</span>
                            }

                        </div>

                        <!-- BODY -->
                        <div class="card-body p-2">

                            <div class="row g-2" >

                                @if (ActiveTab == "foto")
                                {
                                    <div class="col-5 d-flex">
                                        <InputFile class="d-none"
                                        id="cameraInput"
                                        OnChange="HandleFileSelected"
                                        accept="image/*"
                                        capture="environment" />

                                        @if (hasFileSelected || isLoadingImport)
                                        {
                                            <button class="btn w-100"
                                            @onclick="UploadPhoto"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:16px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><path d="M7 9l5 -5l5 5" /><path d="M12 4l0 12" /></svg>
                                                @if (isLoadingImport)
                                                {

                                                    <span>Cargando...</span>
                                                }
                                                else
                                                {
                                                    <span>Subir Foto</span>
                                                }
                                            </button>

                                        }
                                        else
                                        {
                                            <button class="btn w-100"
                                            onclick="document.getElementById('cameraInput').click()"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:16px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2" />
                                                    <path d="M9 13a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                                                </svg>
                                                Tomar foto
                                            </button>

                                        }

                                    </div>
                                    <div class="col-7 d-flex">
                                        <InputFile class="d-none"
                                        id="fileInput"
                                        OnChange="HandleFileSelected"
                                        multiple
                                        accept="image/*" />
                                        @if (selectedFiles != null && selectedFiles?.Count > 0)
                                        {
                                            <button class="btn w-100"
                                            @onclick="UploadPhoto"
                                            disabled="@(!hasFileSelected || isLoadingImport)"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:16px; display:flex; justify-items:center; align-items:center;cursor:pointer;">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M15 8h.01" />
                                                    <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12" />
                                                    <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                                                    <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                                                </svg>
                                                Subir @selectedFiles.Count imagen(es) seleccionado(s)
                                            </button>
                                        }
                                        else
                                        {
                                            <label class="btn w-100" for="fileInput"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:16px; display:flex; justify-items:center; align-items:center;cursor:pointer;">
                                                <svg xmlns="http://www.w3.org/2000/svg" 
                                                width="24" 
                                                height="24" 
                                                viewBox="0 0 24 24" 
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M15 8h.01" />
                                                    <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12" />
                                                    <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                                                    <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                                                </svg>
                                                Seleccionar de galería
                                            </label>                                            
                                        }
                                    </div>
                                }

                                @if (ActiveTab == "video")
                                {
                                    <div class="col-5 d-flex">
                                        <InputFile class="d-none"
                                        id="videoCameraInput"
                                        OnChange="HandleFileSelected"
                                        accept="video/*"
                                        capture="environment" />

                                        @if (hasFileSelected || isLoadingImport)
                                        {
                                            <button class="btn w-100"
                                            @onclick="UploadPhoto"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:16px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><path d="M7 9l5 -5l5 5" /><path d="M12 4l0 12" /></svg>
                                                @if (isLoadingImport)
                                                {

                                                    <span>Cargando...</span>
                                                }
                                                else
                                                {
                                                    <span>Subir Video</span>
                                                }
                                            </button>

                                        }
                                        else
                                        {
                                            <button class="btn w-100"
                                            onclick="document.getElementById('videoCameraInput').click()"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" 
                                                width="24" 
                                                height="24" 
                                                viewBox="0 0 24 24" 
                                                fill="none" stroke="currentColor"
                                                stroke-width="1.5">
                                                    >
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M15 10l4.553 -2.276a1 1 0 0 1 1.447 .894v6.764a1 1 0 0 1 -1.447 .894l-4.553 -2.276v-4" />
                                                    <path d="M3 8a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2l0 -8" />
                                                </svg>
                                                Grabar reels
                                            </button>
                                        }
                                    </div>
                                    <div class="col-7 d-flex">
                                        <InputFile class="d-none"
                                        id="fileInputVideo"
                                        OnChange="HandleFileSelected"
                                        multiple
                                        accept="video/*" />
                                        @if (selectedFiles != null && selectedFiles?.Count > 0)
                                        {
                                            <button class="btn w-100" for="fileInputVideo"
                                            @onclick="UploadPhoto"
                                            disabled="@(!hasFileSelected || isLoadingImport)"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M15 8h.01" />
                                                    <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12" />
                                                    <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                                                    <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                                                </svg>
                                                Subir @selectedFiles.Count Video(s) seleccionado(s)
                                            </button>

                                        }
                                        else
                                        {
                                            <label class="btn w-100" for="fileInputVideo"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" 
                                                width="24" height="24" 
                                                viewBox="0 0 24 24" 
                                                fill="none" stroke="currentColor" 
                                                stroke-width="1.5"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 15h-3a3 3 0 0 1 -3 -3v-6a3 3 0 0 1 3 -3h6a3 3 0 0 1 3 3v3" /><path d="M9 12a3 3 0 0 1 3 -3h6a3 3 0 0 1 3 3v6a3 3 0 0 1 -3 3h-6a3 3 0 0 1 -3 -3l0 -6" /><path d="M3 12l2.296 -2.296a2.41 2.41 0 0 1 3.408 0l.296 .296" /><path d="M14 13.5v3l2.5 -1.5l-2.5 -1.5" /><path d="M7 6v.01" /></svg>
                                                Seleccionar de galería
                                            </label>

                                        }
                                    </div>
                                }

                                @if (ActiveTab == "audio")
                                {

                                    <div class="col-6 d-flex">
                                        @if (!string.IsNullOrWhiteSpace(recordedAudioUrl))
                                        {
                                            <button class="btn w-100"
                                            @onclick="DiscardRecording"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">

                                                <div>
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19.933 13.041a8 8 0 1 1 -9.925 -8.788c3.899 -1 7.935 1.007 9.425 4.747" /><path d="M20 4v5h-5" /></svg>
                                                    Re-grabar

                                                </div>


                                            </button>

                                        }
                                        else
                                        {
                                            <button class="btn w-100"
                                            @onclick="StartRecording"
                                            disabled="@isRecording"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">

                                                <!-- TIEMPO -->
                                                @if (isRecording)
                                                {
                                                    <div class="text-center">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#ab2c2c"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 5.072a8 8 0 1 1 -3.995 7.213l-.005 -.285l.005 -.285a8 8 0 0 1 3.995 -6.643z" /></svg>
                                                        Grabando: @recordingTime.ToString(@"mm\:ss")

                                                    </div>
                                                }
                                                else
                                                {
                                                    <div>
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#3C6A79"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 5.072a8 8 0 1 1 -3.995 7.213l-.005 -.285l.005 -.285a8 8 0 0 1 3.995 -6.643z" /></svg>
                                                        Grabar audio

                                                    </div>

                                                }

                                            </button>

                                        }
                                    </div>

                                    <div class="col-6 d-flex">
                                        @if (!string.IsNullOrWhiteSpace(recordedAudioUrl))
                                        {
                                            <button class="btn w-100" @onclick="UploadRecordedAudio"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><path d="M7 9l5 -5l5 5" /><path d="M12 4l0 12" /></svg>
                                                Subir audio
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn w-100"
                                            @onclick="StopRecording"
                                            disabled="@(!isRecording)"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#3C6A79"> <path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M17 4h-10a3 3 0 0 0 -3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3 -3v-10a3 3 0 0 0 -3 -3z" /></svg>
                                                Detener audio
                                            </button>

                                        }
                                    </div>
                                    <!-- PREVIEW -->
                                    @if (!string.IsNullOrWhiteSpace(recordedAudioUrl))
                                    {
                                        <div class="p-3 d-flex flex-column gap-3">

                                            <audio controls
                                            src="@recordedAudioUrl"
                                            style="width:100%;">
                                            </audio>
                                        </div>
                                    }
                                }

                                @if (ActiveTab == "texto")
                                {
                                    <div class="col-7 d-flex">
                                        @if (!isWriting)
                                        {
                                            <button class="btn w-100"
                                                    @onclick="WriteMessage"
                                            style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.5">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                                                    <path d="M13.5 6.5l4 4" />
                                                </svg>
                                                Escribir dedicatoria
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn w-100"
                                                    @onclick="WriteMessage"
                                                    style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 14l-4 -4l4 -4" /><path d="M5 10h11a4 4 0 1 1 0 8h-1" /></svg>
                                                Deshacer 
                                            </button>
                                        }

}
                                    </div>

                                    <div class="col-5 d-flex">
                                        <button class="btn w-100"
                                                @onclick="PublishMessage"
                                                disabled="@(
                                                !isWriting ||
                                                string.IsNullOrWhiteSpace(eventImageDTO?.Message) ||
                                                string.IsNullOrWhiteSpace(eventImageDTO?.Author)
                                                )"
                                                style="background:#f8f6f3;border:1px solid #ebe7e2;border-radius:12px;padding:16px; font-size:12px; gap:10px; display:flex; justify-items:center; align-items:center;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 14l11 -11" /><path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></svg>
                                            Publicar
                                        </button>
                                    </div>

                                    @if (isWriting)
                                    {
                                        <div class="mb-2 text-black small d-flex flex-column gap-2 mt-3">

                                            <textarea @bind="eventImageDTO!.Message"
                                                      @bind:event="oninput"
                                                      rows="5"
                                                      maxlength="200"
                                                      placeholder="Escribe tu dedicatoria aqui"
                                                      style="
                                                        width:100%;
                                                        background:#f8f6f3;
                                                        border:1px solid #ebe7e2;
                                                        border-radius:12px;
                                                        padding:16px;
                                                        font-size:13px;
                                                        color:#1f1f1f;
                                                        outline:none;
                                                        resize:none;
                                                        box-shadow:none;">

                                                    </textarea>
                                            <label style="justify-items:end">@(eventImageDTO?.Message?.Length ?? 0)/200</label>
                                            <input @bind="eventImageDTO!.Author"
                                                   @bind:event="oninput"
                                                   type="text"
                                                   maxlength="25"
                                                   placeholder="Tu Nombre"
                                                   style="
                                                    width:100%;
                                                    background:#f8f6f3;
                                                    border:1px solid #ebe7e2;
                                                    border-radius:12px;
                                                    padding:16px;
                                                    font-size:13px;
                                                    color:#1f1f1f;
                                                    outline:none;
                                                    box-shadow:none;" />

                                        </div>
                                    }
                                }

                            </div>
                           


                        </div>
                </div>
                <div style="min-height:80vw">
                @if (Event is not null && Event.AlbumPublic)
                    {
                        <div style="padding: 1rem; font-family: Arial, sans-serif;">
                            <!-- Header -->
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
                                <h2 style="margin: 0; color: #3C6A79;">Galería (@EventImages!.Count)</h2>
                            </div>

                            <!-- Cargando / vacío / imágenes -->
                            @if (EventImages == null)
                            {
                                <p style="color: #6c757d;">Cargando imágenes...</p>
                            }
                            else if (!EventImages.Any())
                            {
                                <div style="padding: 2rem; text-align: center; color: #6c757d; border: 1px dashed #dee2e6; border-radius: 0.25rem;">
                                    <p>No hay imágenes en este álbum aún.</p>
                                </div>
                            }
                            else
                            {
                                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
                                    @foreach (var image in EventImages)
                                    {
                                        <div style="
                                                overflow: hidden;
                                                border-radius: 10px;
                                                background: #f5f5f5;
                                                cursor: pointer;
                                                position: relative;
                                                ">

                                            @if (image.ImageType == "imagen")
                                            {
                                                <img src="@image.Url"
                                                     alt="Imagen"
                                                     loading="lazy"
                                                     @onclick="() => OpenPreview(image)"
                                                     style="
                                                            width: 100%;
                                                            height: 250px;
                                                            object-fit: cover;
                                                            display: block;" />
                                            }
                                            else if (image.ImageType == "video")
                                            {
                                                <div @onclick="() => OpenPreview(image)"
                                                     style="position: relative;">

                                                    <video style="
                                                        width: 100%;
                                                        height: 250px;
                                                        object-fit: cover;
                                                        display: block;
                                                                            ">
                                                        <source src="@image.Url" />
                                                    </video>

                                                    <div style="
                                                        position: absolute;
                                                        inset: 0;
                                                        display: flex;
                                                        align-items: center;
                                                        justify-content: center;
                                                        background: rgba(0,0,0,0.2);
                                                                            ">
                                                        <i class="bi bi-play-circle-fill"
                                                           style="
                                                                    font-size: 60px;
                                                                    color: white;
                                                                                "></i>
                                                    </div>
                                                </div>
                                            }
                                            else if (image.ImageType == "audio")
                                            {
                                                <div style="
                                                    height: 250px;
                                                    display: flex;
                                                    flex-direction: column;
                                                    align-items: center;
                                                    justify-content: center;
                                                    padding: 1rem;
                                                    background: #f8f9fa;
                                                                        ">

                                                    <i class="bi bi-music-note-beamed"
                                                       style="
                                                                font-size: 60px;
                                                                color: #3C6A79;
                                                                margin-bottom: 1rem;
                                                                            ">
                                                    </i>

                                                    <audio controls
                                                           style="width: 100%;">
                                                        <source src="@image.Url" type="audio/mpeg" />
                                                    </audio>
                                                </div>
                                            }
                                                else if (image.ImageType == "text")
                                                {
                                                    <div style="
                                                        background:#fcfaf8;
                                                        border:1px solid #f0ebe5;
                                                        border-radius:22px;
                                                        padding:24px;
                                                        position:relative;
                                                        box-shadow:0 2px 10px rgba(0,0,0,.03);
                                                        max-width:420px;
                                                        width:100%;
                                                        height:100%;
                                                        display:flex;
                                                        flex-direction:column;
                                                        justify-content:space-between;">

                                                        <!-- Icono -->
                                                        <div style="
                                                            color:#d6b07a;
                                                            font-size:42px;
                                                            line-height:1;
                                                            font-weight:bold;
                                                            margin-bottom:10px;">
                                                            “
                                                        </div>

                                                        <!-- Mensaje -->
                                                        <div style="
                                                            color:#5c5c5c;
                                                            font-size:22px;
                                                            line-height:1.6;
                                                            font-weight:500;
                                                            margin-top:-10px;">
                                                            @image.Message
                                                        </div>

                                                        <!-- Autor -->
                                                        <div style="
                                                                margin-top:24px;
                                                                display:flex;
                                                                justify-content:space-between;
                                                                align-items:center;">

                                                            <div style="
                                                                color:#b5b5b5;
                                                                font-size:20px;
                                                                font-weight:600;">
                                                                — @image.Author
                                                            </div>

                                                            <!-- Corazón -->
                                                            <div style="
                                                                        color:#d6b07a;
                                                                        display:flex;
                                                                        align-items:center;
                                                                        justify-content:center;">

                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                     width="26"
                                                                     height="26"
                                                                     viewBox="0 0 24 24"
                                                                     fill="none"
                                                                     stroke="currentColor"
                                                                     stroke-width="1.8">

                                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                                    <path d="M12 20l-7 -7a4 4 0 1 1 5.5 -5.5l1.5 1.5l1.5 -1.5a4 4 0 1 1 5.5 5.5l-7 7" />
                                                                </svg>

                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                        </div>
                                    }

                                </div>
                            }
                        </div>

                    }


                </div>
                </div>
            </div>
            
        </div>


        <!--Album Publico, si es publico carga todas las imagenes del album para que cualquiera la pueda descargar-->
    </div>
</div>


@if (PreviewImage != null && !string.IsNullOrEmpty(PreviewImage.Url))
{
    <div @onclick="ClosePreview"
         style="position: fixed;
                inset: 0;
                background-color: rgba(0,0,0,0.8);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 9999;">

        <!-- Contenedor de la imagen -->
        <div style="position: relative;" @onclick:stopPropagation>
            <!-- Imagen -->
            <img src="@PreviewImage.Url"
                 style="max-width: 90vw;
                        max-height: 90vh;
                        border-radius: 0.25rem;" />
        </div>
    </div>
}