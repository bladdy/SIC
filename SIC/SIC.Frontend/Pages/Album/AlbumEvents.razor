@page "/album-event"

<PageTitle>Álbum Eventos</PageTitle>
<PageHeader Icon="bi-images"
            Title="Álbum Eventos"
            Subtitle="Galería de eventos">
    <VolverButton />

</PageHeader>

<div class="d-flex gap-2 mb-3">
    <div class="sic-search">
        <i class="bi bi-search sic-search-icon"></i>
        <input type="text" class="form-control" placeholder="Buscar Evento..." @bind="Filter" />
    </div>
    <div class="sic-toolbar-actions">
        <InputDate class="form-control d-none" @bind-Value="DateSelectd" style="width:150px;" />
        <InputSelect class="form-select d-none" @bind-Value="SelectedEventType" style="width:300px;">
            <option value="">-- Selecciona un tipo de Evento --</option>
            @if (EventTypes != null)
            {
                @foreach (var type in EventTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            }
        </InputSelect>
        <InputSelect class="form-select d-none" @bind-Value="OrderBy" style="width:200px;">
            <option value="">-- Ordenar por --</option>
            <option value="FechaAsc">Fecha Ascendente </option>
            <option value="FechaDesc">Fecha Descendente</option>
            <option value="Nombre">Nombre Alfabético</option>
            <option value="Evento">Tipo de Evento</option>
            <option value="Estado">Estado</option>
        </InputSelect>
        <button type="button" class="btn btn-primary" @onclick="ApplyFilterAsync">
            <i class="bi bi-search"></i>
        </button>
        <button type="button" class="btn btn-primary" @onclick="CleanFilterAsync">
            <i class="bi bi-x-circle" />
        </button>
    </div>
</div>

<!-- Tabla principal -->
<GenericList MyList="Events">
    <Body>
        <div class="table-responsive d-none d-md-block">
            <table class="table sic-table mb-0">
                <thead>
                    <tr class="text-center">
                        <th class="text-start">Detalle del Evento</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Events != null && Events.Any())
                    {
                        @foreach (var even in Events)
                        {
                            <tr>
                                <td style="white-space: normal; vertical-align: top;">
                                    <div class="container-fluid">
                                        <div class="row g-3 small text-secondary">
                                            <div class="col-12 col-md-4 d-flex flex-column">
                                                <div class="mb-2">
                                                    <strong>Código:</strong>
                                                    <a class="text-decoration-none sic-text-primary">@even.Code</a>
                                                </div>
                                                <div><strong>Tipo:</strong> @even.EventType!.Name</div>
                                                <div><strong>@even.User!.UserType.GetDescription():</strong> @even.User!.FullName</div>
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div class="fw-bold fs-6 text-dark mb-1">@even.Name</div>
                                                @if (!string.IsNullOrWhiteSpace(even.SubTitle))
                                                {
                                                    <div class="text-muted small mb-2">@even.SubTitle</div>
                                                }
                                                <div class="fw-bold fs-6 text-dark mb-1">Imágenes (@even.Images.Count)</div>
                                            </div>
                                            <div class="col-12 col-md-4 d-flex flex-row flex-wrap align-items-center gap-1">
                                                <a href="/my-album/@even.Code" class="btn btn-custom w-100">Album</a>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge sic-badge @(even.Status == Status.Active ? "sic-badge-success" : even.Status == Status.Cancelled ? "sic-badge-danger" : "sic-badge-gray")">
                                        @even.Status.GetDescription()
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="fw-semibold text-dark">@even.Date.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-custom mb-1" @onclick="() => ShowEditModal(even)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-pencil"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" /><path d="M13.5 6.5l4 4" /></svg>
                                    </button>
                                    <button class="btn btn-sm btn-custom mb-1" @onclick="() => DeleteEvents(even.Code)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-trash"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 7l16 0" /><path d="M10 11l0 6" /><path d="M14 11l0 6" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No hay eventos registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-block d-md-none sic-mobile-card">
            @if (Events != null && Events.Any())
            {
                @foreach (var even in Events)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <h5 class="card-title fw-bold mb-0">@even.Name</h5>
                                <span class="sic-badge @(even.Status == Status.Active ? "sic-badge-success" : even.Status == Status.Cancelled ? "sic-badge-danger" : "sic-badge-gray")">
                                    @even.Status.GetDescription()
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(even.SubTitle))
                            {
                                <p class="card-subtitle text-muted small mb-2">@even.SubTitle</p>
                            }
                            <p class="mb-1"><strong>@even.User!.UserType.GetDescription():</strong> @even.User!.FullName</p>
                            <p class="mb-1"><strong>Código:</strong> @even.Code</p>
                            <p class="mb-1"><strong>Tipo:</strong> @even.EventType!.Name</p>
                            <p class="mb-1"><strong>Imágenes:</strong> @even.Images.Count</p>
                            <p class="mb-2"><strong>Fecha:</strong> @even.Date.ToString("dd/MM/yyyy")</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-custom flex-grow-1" @onclick="() => ShowEditModal(even)"><i class="bi bi-pencil-fill"></i> Editar</button>
                                <a href="/my-album/@even.Code" class="btn btn-custom w-100">Album</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-muted py-4">No hay eventos registrados.</p>
            }
        </div>

    </Body>
</GenericList>

<!-- Paginación -->
<div class="d-flex justify-content-center my-3">
    <Pagination CurrentPage="currentPage" TotalPages="totalPages" SelectedPage="SelectedPageAsync" />
</div>

<!-- Modal -->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-image me-2"></i>@((IsEditMode ? $"Editar Evento: {NewEvent.Code}" : "Crear Evento"))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-center align-items-center" style="height: 400px;">
                        <div class="d-flex flex-column gap-3" style="width: 400px;">
                            <div style="width:100%; height:300px; overflow:hidden;">
                                <img id="preview"
                                     src="@(!string.IsNullOrEmpty(NewEvent.CoverAlbumImageUrl)
                                        ? NewEvent.CoverAlbumImageUrl
                                        : "")" 
                                     style="max-width:100%; display:block;" />
                            </div>

                            <!-- InputFile oculto -->
                            <InputFile class="d-none" id="fileInput" OnChange="HandleFileSelected" accept="image/*" />

                            <!-- Label que actúa como botón -->
                            <label for="fileInput" class="form-control form-control-sm text-center" style="cursor:pointer;">
                                Elige una imagen
                            </label>

                            <!-- Botón de carga -->
                            <button class="btn btn-sm btn-custom w-100"
                                    @onclick="UploadPhoto" disabled="@(!hasFileSelected || isLoadingImport)">
                                @if (isLoadingImport)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Cargando...</span>
                                }
                                else
                                {
                                    <span>Subir Imagen</span>
                                }
                            </button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmModal IsVisible="IsConfirmVisible" IsVisibleChanged="OnConfirmVisibleChanged" Message="@ConfirmMessage" OnConfirmAction="ExecutePendingDelete" />
