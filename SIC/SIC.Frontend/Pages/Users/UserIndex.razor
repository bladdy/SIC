@page "/users"
@using SIC.Frontend.Shared.Modals

<PageTitle>Usuarios</PageTitle>

<div class="container-fluid px-2">

    <PageHeader Icon="bi-people" Title="Usuarios" Subtitle="Gestión de usuarios">
        <button class="btn btn-primary" @onclick="() => ShowCreateModal(true)">
            <i class="bi bi-plus-lg"></i> Crear Usuario
        </button>
    </PageHeader>

    <!-- Filtros -->
    <div class="sic-toolbar">
        <div class="sic-search">
            <i class="bi bi-search sic-search-icon"></i>
            <input type="text" class="form-control" placeholder="Buscar usuario..." @bind-value="Filter" />
        </div>
        <div class="sic-toolbar-actions">
            <button type="button" class="btn btn-primary" @onclick="ApplyFilterAsync">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            <button type="button" class="sic-clear" @onclick="CleanFilterAsync">
                <i class="bi bi-x-circle" /> Limpiar
            </button>
        </div>
    </div>
    <!-- ====== VERSIÓN DE ESCRITORIO ====== -->
    <div class="table-responsive d-none d-md-block">
        <table class="table sic-table mb-0">
            <thead>
                <tr class="text-center">
                    <th>Usuario</th>
                    <th>Teléfono</th>
                    <th>Tipo Usuario</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Users is null)
                {
                    <Loading />
                }
                else
                {
                    @foreach (var user in Users)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.PhoneNumber</td>
                            <td>@user.UserType.GetDescription()</td>
                            <td class="text-center">
                                <button @onclick="() => ShowEditModal(user)" class="btn btn-sm btn-custom me-2">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <!-- ✅ Vista móvil tipo “detalle” -->
    <div class="d-block d-md-none sic-mobile-card">
        @if (Users != null)
        {
            @foreach (var user in Users)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title mb-0">@user.FullName</h5>
                            <span class="sic-badge @(user.UserType == UserType.Admin ? "sic-badge-success" : user.UserType == UserType.WeddingPlanner ? "sic-badge-danger" : "sic-badge-gray")">
                                @user.UserType.GetDescription()
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <p class="mb-0"><strong>Teléfono:</strong> @user.PhoneNumber </p>

                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <p class="mb-0"><strong>Email:</strong> @user.Email</p>

                        </div>

                        <div class="d-flex flex-wrap justify-content-between gap-1 mt-3">
                            <button @onclick="() => ShowEditModal(user)" class="btn btn-custom d-flex align-items-center justify-content-center gap-1 flex-fill">
                                <i class="bi bi-pencil-fill"></i>Editar
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <!-- Paginación -->
    <div class="d-flex justify-content-center my-3">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPage" />
    </div>

</div>
<UserCreateModal Show="@ShowCreate"
                 ShowChanged="@((bool val) => ShowCreate = val)"
                 OnSaved="LoadUsers" />

<UserEditModal Show="@ShowEdit"
               ShowChanged="@((bool val) => ShowEdit = val)"
               UserModel="@SelectedUser"
               OnSaved="LoadUsers" />