@page "/my-events"
<PageTitle>Mis Eventos</PageTitle>
<h3 class="mb-2">Mis Eventos</h3>

<div class="mb-3">
    <!-- Admin -->
    <AuthorizeView Roles="Admin">
        <Authorized>
            <button class="btn btn-custom" @onclick="ShowCreateModal">
                Crear Evento
            </button>
        </Authorized>
    </AuthorizeView>

    <!-- Planner -->
    <AuthorizeView Roles="WeddingPlanner">
        <Authorized>
            <button class="btn btn-custom"
            @onclick="ShowCreateModal"
            disabled="@(AvailableCredits == 0)"
            title="@(AvailableCredits == 0 ? "No tienes créditos disponibles" : $"Tienes {AvailableCredits} créditos disponibles")">
                Crear Evento (@AvailableCredits)
            </button>
        </Authorized>
    </AuthorizeView>

</div>

<AuthorizeView Roles="WeddingPlanner,Admin">
    <Authorized>
        <div class="mb-2" style="display: flex; flex-wrap:wrap; align-items: center; gap: 10px;">
            <!-- Buscar por texto -->
            <input style="width:400px;" type="text" class="form-control focus:border-[#3C6A79]" placeholder="Buscar Evento..." @bind="Filter" />

            <!-- Fecha -->
            <InputDate class="form-control d-none" @bind-Value="DateSelectd" style="width:150px;" />

            <!-- Tipo de Evento -->
            <InputSelect class="form-select d-none" @bind-Value="SelectedEventType" style="width:300px;">
                <option value="">-- Selecciona un tipo de Evento --</option>
                @if (EventTypes != null)
                {
                    @foreach (var type in EventTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                }
            </InputSelect>

            <!-- Orden -->
            <InputSelect class="form-select d-none" @bind-Value="OrderBy" style="width:200px;">
                <option value="">-- Ordernar por --</option>
                <option value="FechaAsc">Fecha Ascendente </option>
                <option value="FechaDesc">Fecha Descendente</option>
                <option value="Nombre">Nombre Alfabetico</option>
                <option value="Evento">Tipo de Evento</option>
            </InputSelect>

            <!-- Botones -->
            <button type="button" class="btn btn-custom" @onclick="ApplyFilterAsync">
                <i class="bi bi-funnel" /> Filtrar
            </button>
            <button type="button" class="btn btn-custom" @onclick="CleanFilterAsync">
                <i class="bi bi-x-circle" /> Limpiar
            </button>
        </div>
    </Authorized>
</AuthorizeView>

<!-- Tabla principal -->
<GenericList MyList="Events">
    <Body>
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#3C6A79; color:white;">
                    <tr class="text-center">
                        <th class="text-start">Detalle del Evento</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        @if (_userRol == "WeddingPlanner")
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Events != null && Events.Any())
                    {
                        @foreach (var even in Events)
                        {
                            <tr class="border-top">
                                <td style="white-space: normal; vertical-align: top;">
                                    <div class="container-fluid">
                                        <div class="row g-3 small text-secondary">
                                            <div class="col-12 col-md-4 d-flex flex-column">
                                                <div class="fw-bold fs-6 text-dark mb-1">@even.Name</div>
                                                <div class="mb-2 d-none">
                                                    <strong>Código:</strong>
                                                    <a class="text-decoration-none text-primary">@even.Code</a>
                                                </div>
                                                <div><strong>Tipo:</strong> @even.EventType!.Name</div>
                                                <div class="d-none"><strong>@even.User!.UserType.GetDescription():</strong> @even.User!.FullName</div>
                                            </div> 
                                            <div class="col-12 col-md-4 d-none">
                                                @if (!string.IsNullOrWhiteSpace(even.SubTitle))
                                                {
                                                    <div class="text-muted small mb-2">@even.SubTitle</div>
                                                }
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <div class="d-flex flex-wrap gap-2">

                                                    @if (even.InvitationInvboxv)
                                                    {
                                                        <button class="btn btn-custom flex-fill"
                                                                style="min-width:180px"
                                                                @onclick="() => CopiarEventUrl(even.Code)"
                                                                disabled="@(CopyingEventCode == even.Code)">

                                                            @if (CopyingEventCode == even.Code)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"
                                                                      role="status"
                                                                      aria-hidden="true"></span>
                                                                <span>Copiando...</span>
                                                            }
                                                            else
                                                            {
                                                                <span>Formulario Inivitacion</span>
                                                            }
                                                        </button>

                                                        <a href="/event/@even.Code/requisitos/respuesta"
                                                           class="btn btn-custom flex-fill d-none"
                                                           style="min-width:180px">
                                                            Datos Invitación
                                                        </a>
                                                    }

                                                    <a href="@even.Url"
                                                       target="_blank"
                                                       class="btn btn-custom flex-fill"
                                                       style="min-width:180px">
                                                        Ver Invitación
                                                    </a>

                                                    <a href="/my-events/details/@even.Code"
                                                       class="btn btn-custom flex-fill"
                                                       style="min-width:180px">
                                                        Invitados
                                                    </a>

                                                    @if (even.HasAlbum)
                                                    {
                                                        <a href="/my-album/@even.Code"
                                                           class="btn btn-custom flex-fill"
                                                           style="min-width:180px">
                                                            Álbum
                                                        </a>
                                                    }
                                                    @if (_userRol == "WeddingPlanner")
                                                    {
                                                        <a href="/events/@even.Code/minute-by-minute"
                                                            class="btn btn-custom flex-fill"
                                                            style="min-width:180px">
                                                            Minuto a Minuto
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="px-3 py-2 fs-6 badge @(even.Status == Status.Active ? "bg-success" : even.Status == Status.Cancelled ? "bg-danger" : "bg-secondary")">
                                        @even.Status.GetDescription()
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="fw-semibold text-dark">@even.Date.ToString("dd/MM/yyyy")</div>
                                </td>
                                @if (_userRol == "WeddingPlanner")
                                {
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-custom mb-1" @onclick="() => ShowEditModal(even)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn btn-sm btn-custom mb-1 d-none" @onclick="() => ConfirmDelete(even)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No hay eventos registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-block d-md-none">
            @if (Events != null && Events.Any())
            {
                @foreach (var even in Events)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@even.Name</h5>
                            @if (!string.IsNullOrWhiteSpace(even.SubTitle))
                            {
                                <p class="card-subtitle text-muted small mb-2 d-none">@even.SubTitle</p>
                            }
                            <p class="mb-1 d-none"><strong>@even.User!.UserType.GetDescription():</strong> @even.User!.FullName</p>
                            <p class="mb-1 d-none"><strong>Código:</strong> @even.Code</p>
                            <p class="mb-1"><strong>Tipo:</strong> @even.EventType!.Name</p>
                            <p class="mb-1">
                                <strong>Estado:</strong>
                                <span class="badge @(even.Status == Status.Active ? "bg-success" : even.Status == Status.Cancelled ? "bg-danger" : "bg-secondary")">
                                    @even.Status.GetDescription()
                                </span>
                            </p>
                            <p class="mb-2"><strong>Fecha:</strong> @even.Date.ToString("dd/MM/yyyy")</p>
                            <div class="d-flex gap-2 flex-wrap">
                                @if (_userRol == "WeddingPlanner")
                                {
                                    <button class="btn btn-sm btn-custom flex-grow-1" @onclick="() => ShowEditModal(even)"><i class="bi bi-pencil-fill"></i> Editar</button>
                                    @if (even.InvitationInvboxv)
                                    {
                                        <button class="btn btn-custom flex-fill"
                                                style="min-width:180px"
                                                @onclick="() => CopiarEventUrl(even.Code)"
                                                disabled="@(CopyingEventCode == even.Code)">

                                            @if (CopyingEventCode == even.Code)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"
                                                      role="status"
                                                      aria-hidden="true"></span>
                                                <span>Copiando...</span>
                                            }
                                            else
                                            {
                                                <span>Formulario Inivitacion</span>
                                            }
                                        </button>
                                        <a href="/event/@even.Code/requisitos/respuesta" class="btn btn-sm btn-custom flex-grow-1 d-none"><i class="bi bi-eye"></i> Respuestas</a>

                                    }   
                                }
                                <button class="btn btn-sm btn-custom flex-grow-1 d-none" @onclick="() => ConfirmDelete(even)"><i class="bi bi-trash-fill"></i> Borrar</button>
                                @if (@even.OnlyAlbum == false)
                                {
                                    <a href="@even.Url" target="_blank" class="btn btn-sm btn-custom flex-grow-1">Ver Invitación</a>
                                    <a href="/my-events/details/@even.Code" class="btn btn-sm btn-custom flex-grow-1">Invitados</a>

                                }
                                @if (even.HasAlbum)
                                {
                                    <a href="/my-album/@even.Code" class="btn btn-custom w-100">Ver Album</a>
                                }
                                @if (_userRol == "WeddingPlanner")
                                {
                                    <a href="/events/@even.Code/minute-by-minute" class="btn btn-custom w-100">Minuto a Minuto</a>

                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center text-muted py-4">No hay eventos registrados.</p>
            }
        </div>

    </Body>
</GenericList>

<!-- paginacion-->
<div class="d-flex justify-content-center my-3">
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

</div>

<!-- Modal -->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((IsEditMode ? $"Editar Evento: {NewEvent.Code}" : "Crear Evento"))</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewEvent" OnValidSubmit="@SaveEvent">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <!-- Campos estándar -->
                        <div class="mb-3">
                            <label class="form-label">Tipo de Evento</label>
                            <InputSelect class="form-select" @bind-Value="NewEvent.EventTypeId">
                                <option value="">-- Selecciona un tipo --</option>
                                @if (EventTypes != null)
                                {
                                    @foreach (var type in EventTypes!)
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Anfitrión(es)</label>
                            <InputText class="form-control" @bind-Value="NewEvent.Name" placeholder="Ej. Fernanda & Raúl" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nombre del Evento</label>
                            <InputText class="form-control" @bind-Value="NewEvent.SubTitle" placeholder="Ej. Nuestra Boda" />
                        </div>
                        
                        <div class="mb-3 row">
                            <div class="col">
                                <label class="form-label">Fecha</label>
                                <InputDate class="form-control" @bind-Value="NewEvent.Date" readonly="@IsDateReadOnly"/>
                            </div>
                            <div class="col d-none">
                                <label class="form-label">Hora</label>
                                <InputTime CssClass="form-control" @bind-Value="NewEvent.Time" />
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">URL Invitación</label>
                            <InputText class="form-control" @bind-Value="NewEvent.Url" placeholder="Ej. https://mi-invitacion.com.." />
                        </div>
                        <div class="col-auto">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="NewEvent.InvitationInvboxv" />
                                <label class="form-check-label ms-1">
                                    Invitacion Invboxv 
                                    <small class="text-muted d-block mt-1">(Seleccione esta opción únicamente si la invitación será diseñada por INVBOXV).</small>
                                </label>

                            </div>
                        </div>
                        <CoverImageUploader @ref="CoverUploader" @bind-Value="NewEvent.CoverImageUrl" />
                        <div class="mb-3 row">
                            <div class="col">
                                <label class="form-label">Fecha Limite Para Confirmar Evento</label>
                                <InputDate class="form-control" @bind-Value="NewEvent.DeadLine" />
                            </div>
                            <div class="col d-none">
                                <label class="form-label">Hora</label>
                                <InputTime CssClass="form-control" @bind-Value="NewEvent.Time" />
                            </div>
                        </div>
                        <div class="mb-3 d-none">
                            <label class="form-label">Ubicación</label>
                            <InputText class="form-control" @bind-Value="NewEvent.Ubication" placeholder="Ej. https://www.google.com/maps/....." />
                        </div>
                        <div class="mb-3 row d-none">

                            <div class="col-auto">
                                <label class="form-label">Anfitrión</label>
                                <InputText class="form-control" @bind-Value="NewEvent.Host" />
                            </div>

                            <div class="col-auto">
                                <label class="form-label">Teléfono Anfitrión</label>
                                <InputText class="form-control" @bind-Value="NewEvent.HostPhone" />
                            </div>
                        </div>
                        <div class="mb-3 row d-none">
                            <div class="col-auto">
                                <label class="form-label">Planner</label>
                                <InputText class="form-control" placeholder="Nombre..." @bind-Value="NewEvent.Planner" />
                            </div>

                            <div class="col-auto">
                                <label class="form-label">Teléfono Planner</label>
                                <InputText class="form-control" placeholder="Numero celular..." @bind-Value="NewEvent.PlannerPhone" />
                            </div>
                        </div>
                        

                        <div class="mb-3 d-none">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="NewEvent.Status">
                                <option value="">-- Selecciona un Estado --</option>
                                @foreach (var status in Enum.GetValues<Status>())
                                {
                                    <option value="@status">@status.GetDescription()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => NewEvent.Status)" />
                        </div>

                        <!-- Footer -->
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom">Guardar</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

