<style>
    .steps-wrapper {
        background-color: #367B82;
        padding: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 12px;
    }

    /* Contenedor horizontal fijo */
    .steps-container {
        display: flex;
        flex-direction: row;
        gap: 12px;
        align-items: center;
        justify-content: center;
        flex-wrap: nowrap;
    }

    /* Círculo base (Desktop) */
    .step-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    /* Cuando fue enviado */
    .active-step {
        background-color: #098f09;
    }

    /* Cuando NO fue enviado */
    .inactive-step {
        background-color: #6c757d; /* secondary */
        opacity: 0.6;
    }

    .step-circle svg {
        width: 20px;
        height: 20px;
        stroke: white;
    }

    /* Hover */
    .step-circle:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
    }

    /* ===== Tablet ===== */
    @@media (max-width: 768px) {
        .steps-container {
            gap: 8px;
        }

        .step-circle {
            width: 32px;
            height: 32px;
        }

            .step-circle svg {
                width: 15px;
                height: 15px;
            }
    }

    /* ===== Mobile ===== */
    @@media (max-width: 480px) {
        .steps-container {
            gap: 6px;
        }


        .step-circle {
            width: 30px;
            height: 30px;
        }

            .step-circle svg {
                width: 20px;
                height: 20px;
            }
    }

</style>