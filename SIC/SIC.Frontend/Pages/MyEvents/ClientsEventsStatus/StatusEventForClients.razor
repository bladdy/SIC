            <button type="button" class="sic-clear" style="display: flex; align-items: center; gap: 4px;" @onclick="CleanFilterAsync"><i class="bi bi-x-circle" /> Limpiar</button>



        </div>
    </div>

    <!-- ====== VERSIÓN DE ESCRITORIO ====== -->
    <div class="table-responsive d-none d-md-block">
        <table class="table sic-table table-hover align-middle mb-0">
            <thead>
                <tr class="text-center">

                    <th class="text-start">Detalle del Invitado</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                @if (Invitations != null && Invitations.Any())
                {
                    @foreach (var invitation in Invitations)
                    {
                        <tr class="border-top">
                            <!-- ======== COLUMNA 1: INFORMACIÓN GENERAL ======== -->
                            <td style="white-space: normal; vertical-align: top;">
                                <div class="container-fluid">
                                    <div class="row g-3 small text-secondary">
                                        <!-- ===== COLUMNA 1 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-column">
                                            <div><h5><strong>@invitation.Name</strong></h5></div>
                                            <div><strong>Móvil:</strong> @invitation.PhoneNumber</div>
                                            <div><strong>Mesa:</strong> @invitation.Table</div>
                                        </div>

                                        <!-- ===== COLUMNA 2 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-column">
                                            @if (invitation.Guests.Any())
                                            {
                                                @foreach (var guest in invitation.Guests)
                                                {
                                                    <div>
                                                        <strong>@guest.GuestName</strong>
                                                        (@guest.GuestType.GetDescription())
                                                        <span class="badge rounded-pill"
                                                              style="@(guest.Status == Status.Attend
                                                                          ? "background-color:#E8F5EE !important; color:#239463;"
                                                                          : guest.Status == Status.NotAttend
                                                                              ? "background-color:#FAE0E3 !important; color:#DC3545;"
                                                                              : "background-color:#FFF6D9 !important; color:#FE8B00;")">
                                                            @guest.Status.GetDescription()
                                                        </span>
                                                    </div>

                                                }

                                            }
                                        </div>
                                        <div class="col-12 col-md-3 d-flex align-items-center">

                                            @{
                                                var sentTemplates = invitation.TemplateSents
                                                .Select(t => t.TemplateNumber)
                                                .ToList();
                                            }

                                            <div class="steps-wrapper">
                                                <div class="steps-container">

                                                    <div class="step-circle @(sentTemplates.Contains(1) ? "active-step" : "inactive-step")">
                                                        <!-- SVG 1 -->
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-number-1"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M10 10l2 -2v8" /></svg>
                                                    </div>

                                                    <div class="step-circle @(sentTemplates.Contains(2) ? "active-step" : "inactive-step")">
                                                        <!-- SVG 2 -->
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-number-2"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M10 8h3a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-2a1 1 0 0 0 -1 1v2a1 1 0 0 0 1 1h3" /></svg>
                                                    </div>

                                                    <div class="step-circle @(sentTemplates.Contains(3) ? "active-step" : "inactive-step")">
                                                        <!-- SVG 3 -->
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-number-3"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M10 9a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-2h2a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1" /></svg>
                                                    </div>

                                                    <div class="step-circle @(sentTemplates.Contains(4) ? "active-step" : "inactive-step")">
                                                        <!-- SVG 4 -->
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-circle-number-4"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M10 8v3a1 1 0 0 0 1 1h3" /><path d="M14 8v8" /></svg>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- ======== COLUMNA 2: ESTADO ======== -->
                            <td class="text-center">
                                <span class="px-3 py-2 fs-6 sic-badge @(invitation.Status == Status.Attend ? "sic-badge-success" : invitation.Status == Status.NotAttend ? "sic-badge-danger" : "sic-badge-gray")"
                                      style="@(invitation.Status == Status.Attend
                                          ? "background-color:#E8F5EE !important; color:#239463;"
                                          : invitation.Status == Status.NotAttend
                                              ? "background-color:#FAE0E3 !important; color:#DC3545;"
                                              : "background-color:#FFF6D9 !important; color:#FE8B00;")">
                                    @invitation.Status.GetDescription()
                                </span>
                            </td>

                        </tr>

                        <!-- ======== FILA PARA DEDICATORIA ======== -->
                        @if (!string.IsNullOrEmpty(invitation.Comments))
                        {
                            <tr>
                                <td colspan="3" class="text-secondary" style="word-wrap: break-word;">
                                    <strong>Dedicatoria:</strong> @invitation.Comments
                                </td>
                            </tr>
                        }

                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No hay invitados registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ✅ Vista móvil tipo “detalle” -->
    <div class="d-block d-md-none sic-mobile-card">


        @foreach (var invitation in Invitations!)
        {
            <div class="card mb-3">
