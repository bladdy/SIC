                                                        <button class="btn d-inline-flex align-items-center gap-2 text-white d-none"
                                                        style="background-color:#25d366;"
                                                        @onclick="() => AbrirWhatsapp(invitation.CountryCode+invitation.PhoneNumber , invitation.Code!, invitation.Id, 1)"
