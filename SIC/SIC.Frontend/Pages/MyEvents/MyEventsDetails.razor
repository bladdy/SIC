@if (IsModalExcelVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Importar Excel
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModalExcel"></button>
                </div>


                <div class="modal-body">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex flex-column gap-2">
                            <!-- InputFile oculto -->
                            <InputFile class="d-none" id="fileInput" OnChange="HandleFileSelected" />

                            <!-- Label que actúa como botón -->
                            <label for="fileInput" class="form-control form-control-sm w-100 text-center" style="cursor:pointer;">
                                Elige un archivo
                            </label>
                            <!-- Checkbox con label en la misma línea y centrado vertical -->
                            <div class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input custom" type="checkbox"
                                id="deleteRegisterCheck"
                                checked="@DeleteRegister"
                                @onchange="(e) => DeleteRegister = e.Value is bool value && value" />
                                <label class="form-check-label mb-0" for="deleteRegisterCheck">
                                    Eliminar los registros que no estén en el Excel.
                                </label>
                            </div>
                            <!-- Botón de carga -->
                            <button class="btn btn-sm btn-custom w-100"
                            @onclick="SubirExcel" disabled="@(!hasFileSelected || isLoadingImport)">
                                @if (isLoadingImport)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Cargando...</span>
                                }
                                else
                                {
                                    <span>Cargar Lista de Invitados</span>
                                }
                            </button>
                        </div>
                    </div>



                </div>
                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" @onclick="CloseModalExcel">
                        Cerrar
                    </button>
                </div>
            </div>

        </div>
    </div>
}
<!-- Modal -->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @((IsEditMode ? $"Editar Invitacion: {@NewInvitation.Code}" : "Crear Invitacion"))
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewInvitation" OnValidSubmit="@SaveInvitation">
                        <DataAnnotationsValidator />
                        <ValidationSummary />


                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="NewInvitation.Name" />
                            <ValidationMessage For="@(() => NewInvitation.Name)" />
                        </div>
                        <div class="mb-3 row">
                            <div class="col-auto d-none">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="NewInvitation.Email" placeholder="Como estará rotulada la invitacion" />
                                <ValidationMessage For="@(() => NewInvitation.Email)" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">WhatsApp</label>

                            <div class="input-group">

                                <!-- Country Code Select -->
                                <InputSelect class="form-select"
                                             style="max-width: 190px;"
                                             @bind-Value="NewInvitation.CountryCode">
                                    <option value="">Selecciona un País</option>
                                    <option value="+52">MX +52</option>
                                    <option value="+1">US +1</option>

                                </InputSelect>

                                <!-- Phone Number -->
                                <InputText class="form-control"
                                           @bind-Value="NewInvitation.PhoneNumber"
                                           placeholder="Número de WhatsApp" />

                            </div>

                            <ValidationMessage For="@(() => NewInvitation.CountryCode)" />
                            <ValidationMessage For="@(() => NewInvitation.PhoneNumber)" />
                        </div>
                        <div class="mb-3">
                            <div class="d-flex flex-row align-items-center gap-2 mb-3">
                                <label class="form-label fw-bold">Invitados</label>
                                <button type="button" class="btn btn-custom rounded-circle p-2" @onclick="AddGuest">

                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M5 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                                        <path d="M3 21v-2a4 4 0 0 1 4 -4h4c.96 0 1.84 .338 2.53 .901" />
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                        <path d="M16 19h6" />
                                        <path d="M19 16v6" />
                                    </svg>
                                </button>
                            </div>
                            @if (!IsEditMode)
                            {
                                @foreach (var guest in NewInvitation.Guests)
                                {
                                    <div class="d-flex align-items-center gap-2 mb-3">

                                        <!-- INPUT con menos prioridad -->
                                        <div style="flex: 1 1 160px;">
                                            <InputText class="form-control"
                                                       @bind-Value="guest.GuestName"
                                                       placeholder="Nombre del invitado" />
                                        </div>

                                        <!-- SELECT auto width -->
                                        <div style="flex: 0 0 auto;">
                                            <InputSelect class="form-select w-auto"
                                                         @bind-Value="guest.GuestType"
                                                         @bind-Value:after="OnGuestTypeChanged">
                                                @foreach (var status in Enum.GetValues<GuestType>())
                                                {
                                                    <option value="@status">
                                                        @status.GetDescription()
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div style="flex: 0 0 auto;" class="d-none">
                                            <InputSelect class="form-select w-auto"
                                                         @bind-Value="guest.Status">
                                                @foreach (var status in Enum.GetValues<Status>()
                                    .Where(s => s == Status.NotAttend || s == Status.Pending || s == Status.Attend))
                                                {
                                                    <option value="@status">@status.GetDescription()</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div>
                                            <button type="button" class="btn btn-danger rounded-circle p-2"
                                                    @onclick="() => RemoveGuest(guest)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M4 7l16 0" />
                                                    <path d="M10 11l0 6" />
                                                    <path d="M14 11l0 6" />
                                                    <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                                    <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                                </svg>
                                            </button>
                                        </div>

                                    </div>

                                }

                            }

                        </div>
                        <div class="mb-3 row col-12">
                            <div class="col-4">
                                <label class="form-label">Adultos</label>
                                <InputNumber class="form-control" @bind-Value="NewInvitation.NumberAdults" disabled="true" />
                                <ValidationMessage For="@(() => NewInvitation.NumberAdults)" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Jóvenes</label>
                                <InputNumber class="form-control" @bind-Value="NewInvitation.NumberYouths" disabled="true" />
                                <ValidationMessage For="@(() => NewInvitation.NumberYouths)" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Niños</label>
                                <InputNumber class="form-control" @bind-Value="NewInvitation.NumberChildren" disabled="true" />
                                <ValidationMessage For="@(() => NewInvitation.NumberChildren)" />
                            </div>
                        </div>
                        @if (IsEditMode)
                        {
                            <div class="dropdown-divider mb-2"></div>
                            <h5 class="mb-2">Respuesta de confirmación</h5>

                            <div class="mb-3">
                                <label class="form-label">Estado</label>
                                <InputSelect class="form-select" @bind-Value="NewInvitation.Status"
                                             @bind-Value:after="OnStatusChanged">
                                    <option value="">-- Selecciona un Estado --</option>
                                    @foreach (var status in Enum.GetValues<Status>()
                            .Where(s => s == Status.NotAttend || s == Status.Pending || s == Status.Attend || s == Status.Warned))
                                    {
                                        <option value="@status">@status.GetDescription()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => NewInvitation.Status)" />
                            </div>
                            @if (IsEditMode)
                            {
                                @foreach (var guest in NewInvitation.Guests)
                                {
                                    <div class="d-flex align-items-center gap-2 mb-3">

                                        <!-- INPUT con menos prioridad -->
                                        <div style="flex: 1 1 160px;">
                                            <InputText class="form-control"
                                                       @bind-Value="guest.GuestName"
                                                       placeholder="Nombre del invitado" />
                                        </div>

                                        <!-- SELECT auto width -->
                                        <div style="flex: 0 0 auto;">
                                            <InputSelect class="form-select w-auto"
                                                         @bind-Value="guest.GuestType"
                                                         @bind-Value:after="OnGuestTypeChanged">
                                                @foreach (var status in Enum.GetValues<GuestType>())
                                                {
                                                    <option value="@status">
                                                        @status.GetDescription()
                                                    </option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div style="flex: 0 0 auto;">
                                            <InputSelect class="form-select w-auto"
                                                         @bind-Value="guest.Status"
                                                         @bind-Value:after="OnGuestStatusChanged">
                                                @foreach (var status in Enum.GetValues<Status>()
                                .Where(s => s == Status.NotAttend || s == Status.Pending || s == Status.Attend))
                                                {
                                                    <option value="@status">@status.GetDescription()</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div>
                                            <button type="button" class="btn btn-danger rounded-circle p-2"
                                                    @onclick="() => RemoveGuest(guest)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M4 7l16 0" />
                                                    <path d="M10 11l0 6" />
                                                    <path d="M14 11l0 6" />
                                                    <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                                    <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                                </svg>
                                            </button>
                                        </div>

                                    </div>

                                }

                            }
                            <div class="mb-3 row col-12">
                                <div class="col-4">
                                    <label class="form-label">Adultos</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitation.NumberConfirmedAdults" disabled="true" />
                                    <ValidationMessage For="@(() => NewInvitation.NumberConfirmedAdults)" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Jóvenes</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitation.NumberConfirmedYouths" disabled="true" />
                                    <ValidationMessage For="@(() => NewInvitation.NumberConfirmedYouths)" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Niños</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitation.NumberConfirmedChildren" disabled="true" />
                                    <ValidationMessage For="@(() => NewInvitation.NumberConfirmedChildren)" />
                                </div>

                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mesa</label>
                                <InputText class="form-control" @bind-Value="NewInvitation.Table" />
                                <ValidationMessage For="@(() => NewInvitation.Table)" />
                            </div>


                            <div class="mb-3">
                                <label>Mesa</label>
                                <InputSelect class="form-select"
                                             @bind-Value="NewInvitation.TablesEventsId"
                                             disabled="@(NewInvitation.Status != Status.Attend)">
                                    <option value="">-- Selecciona la Mesa --</option>
                                    @foreach (var table in Tables)
                                    {
                                        <option value="@table.Id">
                                            @table.Name - Disponibles: @(table.Seats - table.OccupiedSeats)
                                        </option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => NewInvitation.TablesEventsId)" />
                            </div>


                            <div class="mb-3">
                                <label class="form-label">Dedicatoria</label>
                                <InputTextArea class="form-control" @bind-Value="NewInvitation.Comments" />
                                <ValidationMessage For="@(() => NewInvitation.Comments)" />
                            </div>
                        }

                        <!--Inhabilitar los botones hasta que termine de enviar-->
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom" disabled="@(isSavingInvitation)">
                                Guardar
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                                Cancelar
                            </button>
                            @if (IsEditMode)
                            {
                                <button type="button" class="btn btn-danger" @onclick="DeleteInvitation">
                                    Eliminar
                                </button>

                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .accordion-button::after {
        filter: brightness(0) invert(1);
    }
    .steps-wrapper {
        background-color: #3C6A79;
        padding: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 12px;
    }

    /* Contenedor horizontal fijo */
    .steps-container {
        display: flex;
        flex-direction: row;
        gap: 12px;
        align-items: center;
        justify-content: center;
        flex-wrap: nowrap;
    }

    /* Círculo base (Desktop) */
    .step-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    /* Cuando fue enviado */
    .active-step {
        background-color: #098f09;
    }

    /* Cuando NO fue enviado */
    .inactive-step {
        background-color: #6c757d; /* secondary */
        opacity: 0.6;
    }

        .step-circle svg {
            width: 20px;
            height: 20px;
            stroke: white;
        }

        /* Hover */
        .step-circle:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
        }

    /* ===== Tablet ===== */
    @@media (max-width: 768px) {
        .steps-container
    {
        gap: 8px;

    }

    .step-circle {
        width: 32px;
        height: 32px;
    }

        .step-circle svg {
            width: 15px;
            height: 15px;
        }

    }

    /* ===== Mobile ===== */
    @@media (max-width: 480px) {
        .steps-container

    {
        gap: 6px;
    }


    .step-circle {
        width: 30px;
        height: 30px;
    }

        .step-circle svg {
            width: 20px;
            height: 20px;
        }

    }

</style>