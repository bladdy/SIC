@page ﻿"/my-events/details/{Code}"
@using SIC.Frontend.Shared
<PageTitle>Detalles del Evento</PageTitle>
<!--
<h3 class="mb-2">Detalle del Evento</h3>-->
@if (EventDetail is null)
{
    <div class="alert alert-info">Cargando evento...</div>
}
else
{
    <div class="card shadow-lg border-0 rounded-3 mb-3 ">
        <!-- Header: título, subtítulo, tipo y estado -->
        <div class="card-header text-white position-relative" style="background-color:#3C6A79;">
            <div class="d-flex justify-content-between align-items-stretch flex-wrap">
                <div>
                    <h4 class="mb-0">@EventDetail.Name</h4>
                    <small>@EventDetail.SubTitle</small>
                    <div class="d-none"><strong>@EventDetail.User!.UserType.GetDescription():</strong> @EventDetail.User!.FullName</div>
                    <p class="mb-1 d-none"><strong>Evento:</strong> @EventDetail.EventType?.Name</p>
                    <p class="mb-1"><strong>Fecha:</strong> @EventDetail.Date.ToString("dd/MM/yyyy")</p>
                </div>

                <div class="text-end d-flex flex-column justify-content-end">
                    <p class="mb-1">
                        <strong>Estado:</strong>
                        <span class="badge bg-@(EventDetail.Status == Status.Active ? "success" : "secondary")">
                            @EventDetail.Status.GetDescription()
                        </span>
                    </p>
                </div>
            </div>

            <!-- Botón QR: versión escritorio -->
            <a href="/events/register-event/invitations-entries/@EventDetail.Code"
            class="btn btn-sm text-white position-absolute top-0 end-0 mt-2 me-2 d-none d-md-inline-flex align-items-center"
            style="background-color:#1F4854; border-color:white;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="me-1">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h3v3h3v3h-6z" />
                </svg>
                Scan QR
            </a>

            <!-- Botón QR: versión móvil -->
            <a href="/events/register-event/invitations-entries/@EventDetail.Code"
            class="btn btn-sm text-white mt-2 px-4 position-absolute bottom-0 end-0 mb-2 me-2 d-block d-md-none align-items-center"
            style="background-color:#1F4854; border-color:white;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="me-1">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h3v3h3v3h-6z" />
                </svg>
                Scan QR
            </a>

        </div>


        <!-- Body: Información detallada -->
        <div class="card-body">

            <div class="accordion" id="accordionPanelsStayOpenExample">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                        <button class="accordion-button collapsed" style="background-color:#3C6A79 !important; color:white;"
                        type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                            <div class="w-100 d-flex justify-content-between align-items-center me-3">

                                <strong class="text-uppercase">Invitados:</strong>
                                <span>@(EventDetail.NumberAdults + EventDetail.NumberYouths + EventDetail.NumberChildren)</span>
                            </div>
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingOne">
                        <div class="accordion-body row">
                            <div class="col-12 col-md-4">
                                <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                                    <strong>Adultos:</strong>
                                    <span>@EventDetail.NumberAdults</span>
                                </p>
                            </div>
                            <div class="col-12 col-md-4">
                                <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                                    <strong>Jóvenes:</strong>
                                    <span>@EventDetail.NumberYouths</span>
                                </p>
                            </div>

                            <!-- Niños -->
                            <div class="col-12 col-md-4">
                                <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                                    <strong>Niños:</strong>
                                    <span>@EventDetail.NumberChildren</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="panelsStayOpen-headingTwo">
                        <button class="accordion-button collapsed bg-success" style="color:white; margin-top: 2px;" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="false" aria-controls="panelsStayOpen-collapseTwo">
                            <div class="w-100 d-flex justify-content-between align-items-center me-3">

                                <strong>Total SÍ ASISTIRÉ:</strong>
                                <span>@(EventDetail.NumberAdultsConfirmed + EventDetail.NumberChildrenConfirmed + EventDetail.NumberYouthsConfirmed)</span>

                            </div>
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTwo">
                        <div class="accordion-body row">
                            <!-- Adultos (Sí asistiré) -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                                    <strong>Adultos:</strong>
                                    <span>@EventDetail.NumberAdultsConfirmed</span>
                                </p>
                            </div>

                            <!-- Jóvenes (Sí asistiré) -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                                    <strong>Jóvenes:</strong>
                                    <span>@EventDetail.NumberYouthsConfirmed</span>
                                </p>
                            </div>

                            <!-- Niños (Sí asistiré) -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                                    <strong>Niños:</strong>
                                    <span>@EventDetail.NumberChildrenConfirmed</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="panelsStayOpen-headingThree">
                        <button class="accordion-button collapsed bg-danger" style="color:white; margin-top: 2px;" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="false" aria-controls="panelsStayOpen-collapseThree">
                            <div class="w-100 d-flex justify-content-between align-items-center me-3">

                                <strong>Total NO ASISTIRÉ:</strong>
                                <span>@(EventDetail.NumberAdultsNotAttend + EventDetail.NumberChildrenNotAttend + EventDetail.NumberYouthNotAttend)</span>
                            </div>
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingThree">
                        <div class="accordion-body row">
                            <!-- No asistiré -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                                    <strong>Adultos:</strong>
                                    <span>@(EventDetail.NumberAdultsNotAttend)</span>
                                </p>
                            </div>
                            <!-- No asistiré -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                                    <strong>Jóvenes:</strong>
                                    <span>@(EventDetail.NumberYouthNotAttend)</span>
                                </p>
                            </div>

                            <!-- No asistiré -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                                    <strong>Niños:</strong>
                                    <span>@(EventDetail.NumberChildrenNotAttend)</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="panelsStayOpen-headingFour">
                        <button class="accordion-button collapsed bg-warning" type="button" style="color:white; margin-top: 2px;" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="false" aria-controls="panelsStayOpen-collapseFour">
                            <div class="w-100 d-flex justify-content-between align-items-center me-3">

                                <strong>Invitados PENDIENTES:</strong>
                                <span>@(EventDetail.NumberAdultsPending + EventDetail.NumberChildrenPending + EventDetail.NumberYouthPending)</span>

                            </div>
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse " aria-labelledby="panelsStayOpen-headingFour">
                        <div class="accordion-body row">
                            <!-- Invitados Pendientes -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning">
                                    <strong>Adultos:</strong>
                                    <span>@(EventDetail.NumberAdultsPending)</span>
                                </p>
                            </div>
                            <!-- Invitados Pendientes -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning">
                                    <strong>Jóvenes:</strong>
                                    <span>@(EventDetail.NumberYouthPending)</span>
                                </p>
                            </div>
                            <!-- Invitados Pendientes -->
                            <div class="col-12 col-md-4 m-0">
                                <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning">
                                    <strong>Niños:</strong>
                                    <span>@(EventDetail.NumberChildrenPending)</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-2">

                <div class="col-12 col-md-4 m-0">
                    <p class="d-flex justify-content-between px-3 py-3 text-black" style="background-color: whitesmoke;">
                        <strong>Invitaciones SIN CONFIRMAR :</strong>
                        <span>@(EventDetail.Pending)</span>
                    </p>
                </div>
            </div>

            <!-- ======================== -->
            <!-- SECCIÓN 2: Invitados -->
            <!-- ======================== -->
            <div class="row text-center align-items-stretch g-1 g-md-3 mt-0 d-none">
                <!-- Invitados -->
                <div class="col-12 col-md-3 mb-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white" style="background-color:#3C6A79;">
                        <strong>Invitados:</strong>
                        <span>@(EventDetail.NumberAdults + EventDetail.NumberYouths + EventDetail.NumberChildren)</span>
                    </p>
                </div>
                <!-- Adultos -->
                <div class="col-6 col-md-3">
                    <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                        <strong>Adultos:</strong>
                        <span>@EventDetail.NumberAdults</span>
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                        <strong>Jóvenes:</strong>
                        <span>@EventDetail.NumberYouths</span>
                    </p>
                </div>

                <!-- Niños -->
                <div class="col-6 col-md-3">
                    <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                        <strong>Niños:</strong>
                        <span>@EventDetail.NumberChildren</span>
                    </p>
                </div>

            </div>

            <!-- ======================== -->
            <!-- SECCIÓN 3: Confirmaciones -->
            <!-- ======================== -->
            <div class="row text-center align-items-stretch g-1 g-md-3 mt-0 d-none">
                <!-- (Sí asistiré) -->
                <div class="col-12 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success">
                        <strong>Total SÍ ASISTIRÉ:</strong>
                        <span>@(EventDetail.NumberAdultsConfirmed + EventDetail.NumberChildrenConfirmed + EventDetail.NumberYouthsConfirmed)</span>
                    </p>
                </div>

                <!-- Adultos (Sí asistiré) -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                        <strong>Adultos:</strong>
                        <span>@EventDetail.NumberAdultsConfirmed</span>
                    </p>
                </div>

                <!-- Jóvenes (Sí asistiré) -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                        <strong>Jóvenes:</strong>
                        <span>@EventDetail.NumberYouthsConfirmed</span>
                    </p>
                </div>

                <!-- Niños (Sí asistiré) -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                        <strong>Niños:</strong>
                        <span>@EventDetail.NumberChildrenConfirmed</span>
                    </p>
                </div>

                <!-- No asistiré -->
                <div class="col-12 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                        <strong>Total NO ASISTIRÉ:</strong>
                        <span>@(EventDetail.NumberAdultsNotAttend + EventDetail.NumberChildrenNotAttend + EventDetail.NumberYouthNotAttend)</span>
                    </p>
                </div>
                <!-- No asistiré -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                        <strong>Adultos:</strong>
                        <span>@(EventDetail.NumberAdultsNotAttend )</span>
                    </p>
                </div>
                <!-- No asistiré -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                        <strong>Jóvenes:</strong>
                        <span>@(EventDetail.NumberYouthNotAttend)</span>
                    </p>
                </div>

                <!-- No asistiré -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                        <strong>Niños:</strong>
                        <span>@(EventDetail.NumberChildrenNotAttend)</span>
                    </p>
                </div>
                <!-- Invitados Pendientes -->
                <div class="col-12 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning">
                        <strong>Invitados PENDIENTES:</strong>
                        <span>@(EventDetail.NumberAdultsPending + EventDetail.NumberChildrenPending + EventDetail.NumberYouthPending)</span>
                    </p>
                </div>
                <!-- Invitados Pendientes -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning">
                        <strong>Adultos:</strong>
                        <span>@(EventDetail.NumberAdultsPending )</span>
                    </p>
                </div>
                <!-- Invitados Pendientes -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning">
                        <strong>Jóvenes:</strong>
                        <span>@( EventDetail.NumberYouthPending)</span>
                    </p>
                </div>
                <!-- Invitados Pendientes -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning">
                        <strong>Niños:</strong>
                        <span>@( EventDetail.NumberChildrenPending)</span>
                    </p>
                </div>
                <!-- Invitaciones Pendientes -->
                <div class="col-12 col-md-4 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-black" style="background-color:whitesmoke;">
                        <strong>Invitaciones SIN CONFIRMAR :</strong>
                        <span>@(EventDetail.Pending)</span>
                    </p>
                </div>
            </div>

        </div>

        <!-- Footer: Botones de acción -->
        <div class="card-footer d-flex justify-content-center flex-wrap gap-2">
            <div class="text-center">
                <!-- Título centrado arriba -->
                <h4 class="mb-1">Crear Lista de Invitados</h4>

                <!-- Contenedor responsive -->
                <div class="d-flex flex-column flex-lg-row justify-content-center align-items-center  gap-2 mt-2">
                    <!-- En mobile: los botones se apilan como indicas -->
                    <!-- En PC: se ponen en una fila juntos debajo del título -->
                    <div class="d-flex justify-content-center gap-2 mb-2 mb-lg-0">
                        <button class="btn btn-sm btn-custom" @onclick="DescargarExcel" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span> Generando... </span>
                            }
                            else
                            {
                                <span>Exportar Excel</span>
                            }
                        </button>
                        <button class="btn btn-sm btn-custom" @onclick="ShowModalExcel">Importar Excel</button>
                    </div>

                    <!-- Botón que en móvil queda debajo, pero en escritorio en la misma fila -->
                    <div>
                        <button class="btn btn-sm btn-custom" @onclick="ShowCreateModal">Agregar Invitado</button>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-custom" @onclick="NavegateToControlTables">Asignar Mesas</button>
                    </div>
                    @if (EventDetail.User.UserType == UserType.WeddingPlanner || EventDetail.User.UserType == UserType.Admin)
                    {
                        <div class="d-flex justify-content-center gap-2 mb-2 mb-lg-0">
                            <button class="btn btn-sm btn-custom" @onclick="CopiarEventUrl" disabled="@IsCopyURl">
                                @if (IsCopyURl)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span> Copiando... </span>
                                }
                                else
                                {
                                    <span>Compartir Evento</span>
                                }
                            </button>
                        </div>

                    }
                    @if (EventDetail.User.UserType == UserType.WeddingPlanner || EventDetail.User.UserType == UserType.User)
                    {
                        <div class="d-flex justify-content-center gap-2 mb-2 mb-lg-0">
                            <button class="btn btn-sm btn-custom" @onclick="GeneratedPDF" disabled="@IsProcessList">
                                @if (IsProcessList)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span> Generando lista... </span>
                                }
                                else
                                {
                                    <span>Lista de asistentes (PDF)</span>
                                }
                            </button>
                        </div>

                    }
                </div>
            </div>

        </div>
    </div>

    <h4 class="mb-0">Lista de Invitados</h4>
    ﻿﻿
    <!--<Filter PlaceHolder="Buscar Invitacion..." Callback=@FilterCallBack /> 25d366-->
    ﻿﻿<div class="mb-2 gap-2" style="display: flex; flex-wrap:wrap; align-items: center;">
        <input style="width:400px;" type="text" class="form-control" placeholder="Buscar Invitacion..." @bind-value="Filter">
        <div style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center; justify-content: start;">
            <button type="button" class="btn btn-custom" style="display: flex; align-items: center; gap: 4px;" @onclick="ApplyFilterAsync"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-search"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg> Buscar</button>
            <button type="button" class="btn btn-custom" style="display: flex; align-items: center; gap: 4px;" @onclick="CleanFilterAsync"><i class="bi bi-x-circle" /> Limpiar</button>
            @if (usarWhatsApp)
            {
                @if (EventDetail.User.UserWhatsAppConfigs == null)
                {
                    <button type="button" class="btn btn-custom mt-2 mt-lg-0" style="display: flex; align-items: center; gap: 4px;" @onclick="NavegateToMessage"> <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>Mensajes</button>
                }

            }

        </div>
        <div class="form-check form-switch">
            <input class="form-check-input btn-custom" type="checkbox" id="chkUsarWhatsApp" @bind="usarWhatsApp" />
            <label class="form-check-label fw-bold" for="chkUsarWhatsApp">
                @(usarWhatsApp ? "Modo: Enviar por WhatsApp" : "Modo: Copiar al Portapapeles")
            </label>
        </div>
        @if (EventDetail.User.UserWhatsAppConfigs != null && usarWhatsApp)
        {
            @if (Templates != null && Templates.Any())
            {
                <div class="dropdown">
                    <button class="btn btn-success dropdown-toggle d-flex align-items-center gap-2"
                    type="button"
                    data-bs-toggle="dropdown"
                    disabled="@(!HasSelectedInvitations || IsSendingMassive)">
                        @if (IsSendingMassive)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <i class="bi bi-whatsapp"></i>
                            <span>Enviar seleccionados</span>
                        }
                    </button>
                    <ul class="dropdown-menu">
                        @if (Templates != null)
                        {
                            @foreach (var template in Templates)
                            {
                                <li>
                                    <button type="button"
                                    class="dropdown-item"
                                    @onclick="() => EnviarInvitacionesMasivas(template)">
                                        @template.DisplayName
                                    </button>
                                </li>
                            }
                        }
                    </ul>
                </div>
            }
        }

    </div>

    <!-- ====== VERSIÓN DE ESCRITORIO ====== -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#3C6A79; color:white;">
                <tr class="text-center">
                    @if (EventDetail.User.UserWhatsAppConfigs != null)
                    {
                        <th>
                            <input type="checkbox"
                            class="form-check-input"
                            checked="@SelectAll"
                            @onchange="e => ToggleSelectAll((bool)e.Value!)" />

                        </th>
                    }
                    <th class="text-start">Detalle del Invitado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Invitations != null && Invitations.Any())
                {
                    @foreach (var invitation in Invitations)
                    {
                        <tr class="border-top">
                            @if (EventDetail.User.UserWhatsAppConfigs != null)
                            {
                                <td class="text-center">
                                    <input type="checkbox" @key="invitation.Id"
                                    class="form-check-input"
                                    checked="@SelectedInvitations[invitation.Id]"
                                    @onchange="e => OnItemSelectionChanged(invitation.Id, (bool)e.Value!)" />

                                </td>
                            }
                            <!-- ======== COLUMNA 1: INFORMACIÓN GENERAL ======== -->
                            <td style="white-space: normal; vertical-align: top;">
