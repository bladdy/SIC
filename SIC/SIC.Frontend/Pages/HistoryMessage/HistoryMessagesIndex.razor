@page "/my-history-messages"
<PageTitle>Historial de mensajes</PageTitle>
<PageHeader Icon="bi-clock-history"
            Title="Historial de mensajes"
            Subtitle="Consulta el historial de envíos de WhatsApp">
</PageHeader>
<div class="sic-toolbar">
    <div class="d-flex gap-2">
        <div class="sic-search">
            <i class="bi bi-search sic-search-icon"></i>
            <input type="text" class="form-control" placeholder="Buscar Evento..." @bind:event="oninput" @bind="Filter" />
        </div>
        <InputSelect class="form-select" @bind-Value="SelectedPageSize" style="width:100px;">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </InputSelect>

        <button type="button" class="btn btn-primary" @onclick="ApplyFilterAsync">
            <i class="bi bi-funnel"></i> Filtrar
        </button>
        <button type="button" class="btn btn-primary" @onclick="CleanFilterAsync">
            <i class="bi bi-x-circle" /> Limpiar
        </button>
    </div>
</div>

<GenericList MyList="HistoryMessages">
    <Body>
        
        <div class="table-responsive d-none d-md-block">
            <table class="table sic-table mb-0">
                <thead>
                    <tr class="text-center">
                        <th>Nombre</th>
                        <th>Invitación</th>
                        <th>Teléfono</th>
                        <th>Evento</th>
                        <th>Fecha Envío</th>
                        <th>Enviado</th>
                        <th>Entregado</th>
                        <th>Error</th>
                        <th style="min-width:300px;">Mensaje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var HistoryMessage in HistoryMessages!)
                    {
                        <tr>

                            <td>@HistoryMessage.Invitation.Name</td>

                            <td>
                                    @HistoryMessage.Invitation.Code
                               
                            </td>

                            <td>
                                (@HistoryMessage.Invitation.CountryCode) @HistoryMessage.Invitation.PhoneNumber
                                
                            </td>

                            <td>@HistoryMessage.Event.Name</td>

                            <td style="white-space:nowrap;">
                                @HistoryMessage.SendDate.ToDateLocal12h()
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Send)
                                {
                                    <span class="sic-badge sic-badge-success">Sí</span>
                                }
                                else
                                {
                                    <span class="sic-badge sic-badge-danger">No</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Delivered)
                                {
                                    <span class="sic-badge sic-badge-success">Sí</span>
                                }
                                else
                                {
                                    <span class="sic-badge sic-badge-danger">No</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Error)
                                {
                                    <span class="sic-badge sic-badge-warning">Sí</span>
                                }
                                else
                                {
                                    <span class="sic-badge sic-badge-success">No</span>
                                }
                            </td>

                            <td style="
                        max-width:350px;
                        overflow:hidden;
                        text-overflow:ellipsis;
                        white-space:wrap;">
                                @HistoryMessage.Message
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-block d-md-none sic-mobile-card">
            @if (HistoryMessages is not null)
            {
                @foreach (var hm in HistoryMessages)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <!-- Recipient Name and Code -->
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h5 class="card-title fw-bold mb-0">@hm.Invitation.Name</h5>
                                <span class="sic-badge sic-badge-gray">@hm.Invitation.Code</span>
                            </div>

                            <!-- Event Name -->
                            <p class="mb-2 text-muted" style="font-size: 0.9rem;">
                                <strong>Evento:</strong> @hm.Event.Name
                            </p>

                            <!-- Phone and Date -->
                            <div class="row g-2 mb-2" style="font-size: 0.9rem;">
                                <div class="col-6">
                                    <strong>Teléfono:</strong> <br />
                                    (@hm.Invitation.CountryCode) @hm.Invitation.PhoneNumber
                                </div>
                                <div class="col-6">
                                    <strong>Fecha Envío:</strong> <br />
                                    @hm.SendDate.ToDateLocal12h()
                                </div>
                            </div>

                            <!-- Badges/Statuses -->
                            <div class="d-flex flex-wrap gap-3 mb-3 border-top pt-2" style="font-size: 0.85rem;">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">Enviado:</span>
                                    @if (hm.Send)
                                    {
                                        <span class="sic-badge sic-badge-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="sic-badge sic-badge-danger">No</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">Entregado:</span>
                                    @if (hm.Delivered)
                                    {
                                        <span class="sic-badge sic-badge-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="sic-badge sic-badge-danger">No</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">Error:</span>
                                    @if (hm.Error)
                                    {
                                        <span class="sic-badge sic-badge-warning">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="sic-badge sic-badge-success">No</span>
                                    }
                                </div>
                            </div>

                            <!-- Message Body -->
                            <div class="border-top pt-2">
                                <strong style="font-size: 0.9rem;">Mensaje:</strong>
                                <p class="mb-0 mt-1 text-secondary" style="font-size: 0.85rem; word-break: break-word; white-space: pre-wrap;">
                                    @hm.Message
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="d-flex justify-content-center my-3">
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPage" />
        </div>

    </Body>
</GenericList>