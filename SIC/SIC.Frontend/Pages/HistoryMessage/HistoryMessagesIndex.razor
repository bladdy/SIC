@page "/my-history-messages"
<PageTitle>Historial de mensajes</PageTitle>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="mb-2 mb-md-0">Historial de mensajes</h1>
</div>
<div class="d-flex flex-wrap gap-2 align-items-end mb-4">
    <div class="flex-grow-1" style="min-width:250px; max-width:400px;">
        <label class="form-label font-weight-bold mb-1">Buscar Evento</label>
        <input type="text"
               class="form-control"
               placeholder="Buscar Evento..."
               @bind:event="oninput" @bind="Filter" />
    </div>

    <div style="width:120px;">
        <label class="form-label font-weight-bold mb-1">Mostrar</label>
        <InputSelect class="form-select"
                     @bind-Value="SelectedPageSize">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </InputSelect>
    </div>

    <div class="d-flex gap-2">
        <button type="button"
                class="btn btn-custom d-flex align-items-center justify-content-center gap-1"
                style="min-width:110px;"
                @onclick="ApplyFilterAsync">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                <path d="M21 21l-6 -6" />
            </svg>
            Buscar
        </button>

        <button type="button"
                class="btn btn-custom d-flex align-items-center justify-content-center gap-1"
                style="min-width:110px;"
                @onclick="CleanFilterAsync">
            <i class="bi bi-x-circle"></i>
            Limpiar
        </button>
    </div>
</div>

<GenericList MyList="HistoryMessages">
    <Body>
        
        <div class="table-responsive d-none d-md-block">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead style="background-color:#3C6A79; color:white;">
                    <tr class="text-center">
                        <th>Nombre</th>
                        <th>Invitación</th>
                        <th>Teléfono</th>
                        <th>Evento</th>
                        <th>Fecha Envío</th>
                        <th>Enviado</th>
                        <th>Entregado</th>
                        <th>Error</th>
                        <th style="min-width:300px;">Mensaje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var HistoryMessage in HistoryMessages!)
                    {
                        <tr>

                            <td>@HistoryMessage.Invitation.Name</td>

                            <td>
                                    @HistoryMessage.Invitation.Code
                               
                            </td>

                            <td>
                                (@HistoryMessage.Invitation.CountryCode) @HistoryMessage.Invitation.PhoneNumber
                                
                            </td>

                            <td>@HistoryMessage.Event.Name</td>

                            <td style="white-space:nowrap;">
                                @HistoryMessage.SendDate.ToDateLocal12h()
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Send)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Delivered)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Error)
                                {
                                    <span class="badge bg-warning text-dark">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">No</span>
                                }
                            </td>

                            <td style="
                        max-width:350px;
                        overflow:hidden;
                        text-overflow:ellipsis;
                        white-space:wrap;">
                                @HistoryMessage.Message
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-block d-md-none">
            @if (HistoryMessages is not null)
            {
                @foreach (var hm in HistoryMessages)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <!-- Recipient Name and Code -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0" style="font-weight: 600;">@hm.Invitation.Name</h5>
                                <span class="badge bg-secondary">@hm.Invitation.Code</span>
                            </div>

                            <!-- Event Name -->
                            <p class="mb-2 text-muted" style="font-size: 0.9rem;">
                                <strong>Evento:</strong> @hm.Event.Name
                            </p>

                            <!-- Phone and Date -->
                            <div class="row g-2 mb-2" style="font-size: 0.9rem;">
                                <div class="col-6">
                                    <strong>Teléfono:</strong> <br />
                                    (@hm.Invitation.CountryCode) @hm.Invitation.PhoneNumber
                                </div>
                                <div class="col-6">
                                    <strong>Fecha Envío:</strong> <br />
                                    @hm.SendDate.ToDateLocal12h()
                                </div>
                            </div>

                            <!-- Badges/Statuses -->
                            <div class="d-flex flex-wrap gap-3 mb-3 border-top pt-2" style="font-size: 0.85rem;">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">Enviado:</span>
                                    @if (hm.Send)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">No</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">Entregado:</span>
                                    @if (hm.Delivered)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">No</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted">Error:</span>
                                    @if (hm.Error)
                                    {
                                        <span class="badge bg-warning text-dark">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">No</span>
                                    }
                                </div>
                            </div>

                            <!-- Message Body -->
                            <div class="border-top pt-2">
                                <strong style="font-size: 0.9rem;">Mensaje:</strong>
                                <p class="mb-0 mt-1 text-secondary" style="font-size: 0.85rem; word-break: break-word; white-space: pre-wrap;">
                                    @hm.Message
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="d-flex justify-content-center my-3">
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPage" />
        </div>

    </Body>
</GenericList>