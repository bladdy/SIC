@page "/my-history-messages"

<h3>Historial de mensajes</h3>

<GenericList MyList="HistoryMessages">
    <Body>
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="" style="background-color:#3C6A79; color: white;">
                <tr class="text-center">
                    <th>Nombre</th>
                    <th>Invitacion</th>
                    <th>Evento</th>
                    <th>Fecha Envio</th>
                    <th>Enviado</th>
                    <th>Entregado</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var HistoryMessage in HistoryMessages!)
                {
                    <tr class="align-middle">

                        <td>@HistoryMessage.Invitation.Name</td>
                        <td>@HistoryMessage.Invitation.Code</td>
                        <td>@HistoryMessage.Event.Name</td>

                        <td>@HistoryMessage.SendDate.ToString("dd/MM/yyyy")</td>
                        <td>@HistoryMessage.Send</td>
                        <td>@HistoryMessage.Delivered</td>
                        <td>@HistoryMessage.Error</td>
                        
                    </tr>
                }
            </tbody>
        </table>

    </Body>
</GenericList>