@page "/my-history-messages"

<h3 class="mb-4"
    style="font-size:clamp(1.3rem,2vw,2rem);">
    Historial de mensajes
</h3>

<div class="mb-3"
     style="display:flex;
            flex-wrap:wrap;
            gap:10px;
            align-items:end;">

    <div style="flex:1 1 300px; min-width:250px;">
        <label class="form-label">Buscar Evento</label>
        <input type="text"
               class="form-control"
               placeholder="Buscar Evento..."
               @bind="Filter" />
    </div>

    <div style="min-width:120px;">
        <label class="form-label">Mostrar</label>
        <InputSelect class="form-select"
                     @bind-Value="SelectedPageSize">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </InputSelect>
    </div>

    <button type="button"
            class="btn btn-custom"
            style="min-width:120px;"
            @onclick="ApplyFilterAsync">

        <svg xmlns="http://www.w3.org/2000/svg"
             width="20"
             height="20"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round">

            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
            <path d="M21 21l-6 -6" />
        </svg>

        Buscar
    </button>

    <button type="button"
            class="btn btn-custom"
            style="min-width:120px;"
            @onclick="CleanFilterAsync">
        <i class="bi bi-x-circle"></i>
        Limpiar
    </button>

</div>

<GenericList MyList="HistoryMessages">
    <Body>
        
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead style="background-color:#3C6A79; color:white;">
                    <tr class="text-center">
                        <th>Nombre</th>
                        <th>Invitación</th>
                        <th>Teléfono</th>
                        <th>Evento</th>
                        <th>Fecha Envío</th>
                        <th>Enviado</th>
                        <th>Entregado</th>
                        <th>Error</th>
                        <th style="min-width:300px;">Mensaje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var HistoryMessage in HistoryMessages!)
                    {
                        <tr>

                            <td>@HistoryMessage.Invitation.Name</td>

                            <td>
                                    @HistoryMessage.Invitation.Code
                               
                            </td>

                            <td>
                                (@HistoryMessage.Invitation.CountryCode) @HistoryMessage.Invitation.PhoneNumber
                                
                            </td>

                            <td>@HistoryMessage.Event.Name</td>

                            <td style="white-space:nowrap;">
                                @HistoryMessage.SendDate.ToDateLocal12h()
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Send)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Delivered)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (HistoryMessage.Error)
                                {
                                    <span class="badge bg-warning text-dark">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">No</span>
                                }
                            </td>

                            <td style="
                        max-width:350px;
                        overflow:hidden;
                        text-overflow:ellipsis;
                        white-space:wrap;">
                                @HistoryMessage.Message
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-center my-3">
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPage" />
        </div>

    </Body>
</GenericList>