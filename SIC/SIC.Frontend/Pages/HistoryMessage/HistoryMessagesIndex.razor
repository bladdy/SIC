@page "/my-history-messages"

<h3>Historial de mensajes</h3>

<GenericList MyList="HistoryMessages">
    <Body>
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="" style="background-color:#3C6A79; color: white;">
                <tr class="text-center">
                    <th>Nombre</th>
                    <th>Invitacion</th>
                    <th>Telefono</th>
                    <th>Evento</th>
                    <th>Fecha Envio</th>
                    <th>Enviado</th>
                    <th>Entregado</th>
                    <th>Error</th>
                    <th>Mensaje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var HistoryMessage in HistoryMessages!)
                {
                    <tr class="align-middle">

                        <td>@HistoryMessage.Invitation.Name</td>
                        <td>@HistoryMessage.Invitation.Code</td>
                        <td>@HistoryMessage.Invitation.PhoneNumber</td>
                        <td>@HistoryMessage.Event.Name</td>

                        <td>@HistoryMessage.SendDate.ToDateLocal12h()</td>
                        <td>
                            @if (HistoryMessage.Send)
                            {
                                <span class="badge bg-success">Si</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                        <td>
                            @if (HistoryMessage.Delivered)
                            {
                                <span class="badge bg-success">Si</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                        <td>
                            @if (HistoryMessage.Error)
                            {
                                <span class="badge bg-success" >Si</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                            </td>
                        <td>@HistoryMessage.Message</td>
                        
                    </tr>
                }
            </tbody>
        </table>

    </Body>
</GenericList>