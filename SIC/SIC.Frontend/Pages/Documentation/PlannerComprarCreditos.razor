    .alert-callout { display: flex; gap: 1.5rem; padding: 2rem; border-radius: 20px; background: linear-gradient( 135deg, #fefce8, #fef3c7 ); border: 1px solid #fde68a; margin-bottom: 2rem; }
        .alert-callout h3 { margin-bottom: .5rem; color: #2c6368; }
        .alert-callout p { margin: 0; line-height: 1.8; }
    .callout-icon { font-size: 2.5rem; }
    .success-callout h3 { margin-bottom: .5rem; color: #2c6368; }
    .success-callout p { margin: 0; line-height: 1.8; }
