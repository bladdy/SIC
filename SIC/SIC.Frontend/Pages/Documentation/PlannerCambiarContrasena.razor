    .welcome-hero h1 { font-size: 3rem; font-weight: 800; line-height: 1.1; margin-bottom: 1rem; color: #111827; }
    .welcome-description { font-size: 1.15rem; color: #6b7280; max-width: 750px; line-height: 1.8; }
    .welcome-card { background: white; border: 1px solid #e5e7eb; border-radius: 20px; padding: 2rem; margin-bottom: 2rem; }
    .section-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
    .section-number { width: 42px; height: 42px; border-radius: 50%; background: #367B82; color: white; display: flex; justify-content: center; align-items: center; font-weight: 700; }
    .section-header h2 { margin: 0; font-size: 1.8rem; color: #111827; }
    .welcome-card p { font-size: 1rem; line-height: 2; color: #374151; margin-bottom: 1rem; }
    .success-callout { display: flex; gap: 1.5rem; padding: 2rem; border-radius: 20px; background: linear-gradient( 135deg, #EAF4F5, #D7E8EA ); border: 1px solid #CFDFE2; margin-bottom: 2rem; }
    .alert-callout { display: flex; gap: 1.5rem; padding: 2rem; border-radius: 20px; background: linear-gradient( 135deg, #fefce8, #fef3c7 ); border: 1px solid #fde68a; margin-bottom: 2rem; }
        .alert-callout h3 { margin-bottom: .5rem; color: #2c6368; }
        .alert-callout p { margin: 0; line-height: 1.8; }
    .callout-icon { font-size: 2.5rem; }
    .success-callout h3 { margin-bottom: .5rem; color: #2c6368; }
    .success-callout p { margin: 0; line-height: 1.8; }
