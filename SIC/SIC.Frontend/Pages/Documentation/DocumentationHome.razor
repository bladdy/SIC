@page "/documentation/welcome"
@using SIC.Frontend.Models
@using SIC.Frontend.Services
@layout DocumentationLayout
@inject DocumentationState DocumentationState

<PageTitle>Panel de Bienvenida</PageTitle>

<div class="welcome-page">

    <div class="welcome-hero">


        <h1 id="welcome">
            👋 Bienvenido a INVBOXV APP
        </h1>

        <p class="welcome-description">
            Gracias por formar parte de nuestra comunidad de planners y profesionales
            de eventos. Esta documentación te ayudará a aprovechar todas las herramientas
            disponibles dentro de la plataforma.
        </p>

    </div>

    <div class="welcome-card">

        <div class="section-header" id="gracias">

            <h2>
                Gracias por ser parte de la familia de INVBOXV APP
            </h2>

        </div>

        <p>
            Queremos agradecerte sinceramente por confiar en nosotros y formar parte de
            nuestra comunidad de <strong>Planners</strong>.
        </p>

        <p>
            Tu confianza nos impulsa a seguir innovando y desarrollando herramientas que
            te permitan ofrecer una mejor experiencia a tus clientes.
        </p>

        <p>
            Nos sentimos orgullosos de acompañarte en cada celebración y de contribuir
            a que tu trabajo sea más eficiente, profesional y memorable.
        </p>

        <p>
            Seguiremos trabajando constantemente en nuevas funciones, mejoras y
            actualizaciones para que siempre cuentes con herramientas que te ayuden a
            ahorrar tiempo, simplificar procesos y brindar un servicio excepcional.
        </p>

        <p>
            Te invitamos a aprovechar cada actualización del sistema, ya que cada mejora
            está pensada para facilitar tu trabajo y ayudarte a seguir creciendo.
        </p>

        <p>
            Gracias por confiar en <strong>INVBOXV APP</strong> y por permitirnos ser parte de tu éxito.
        </p>

    </div>

    <div class="success-callout">

        <div class="callout-icon">
            🚀
        </div>

        <div>

            <h3>
                Juntos seguimos creciendo
            </h3>

            <p>
                Seguimos creando experiencias inolvidables para los eventos de tus
                clientes mediante herramientas que simplifican la organización,
                automatizan procesos y mejoran la experiencia de tus invitados.
            </p>

        </div>

    </div>

    <div class="alert-callout">

        <div class="callout-icon">
            ⚠️
        </div>

        <div>

            <h3>
                Tomar en cuenta lo siguiente
            </h3>

            <p>
                Si vas a enviar por IPhone tu invitación, hazlo por medio de Google Chrome (Safari no permite realizar enlaces del panel al whatsapp) Google Chorme (SI) Safari(NO).
            </p>
            <p>
                La respuesta de confirmación llegará directamente a tu panel.
            </p>
            <p>
                Cuando tus invitados envían su respuesta, ellos reciben en automático un mensaje que su respuesta fue enviada.
            </p>
            <p>
                También en automático el panel les genera un Código QR a tus invitados por si en un momento dado quisieras hacer uso del código el día de tu evento.
            </p>


        </div>

    </div>

    <div class="next-step">

        <span>Siguiente sección</span>

        <h4>Inicio</h4>

        <p>
            Conoce el dashboard principal y aprende a monitorear tus eventos en tiempo real.
        </p>

    </div>

    @code {

    protected override void OnInitialized()
    {
        DocumentationState.Set(new DocumentationContext
        {
            Breadcrumbs =
            [
                new()
                {
                    Text = "Panel de Bienvenida",
                    Url = "/documentation/welcome"
                }
            ],

            TocItems =
            [
                new()
                {
                    Text = "Bienvenido a INVBOXV APP",
                    Anchor = "#welcome"
                },
                new()
                {
                    Text = "Gracias por ser parte de INVBOXV APP",
                    Anchor = "#gracias"
                }
            ],

            NextPage = new()
            {
                Text = "Inicio",
                Url = "/documentation/home"
            }
        });
    }

}
</div>
<style>
    .welcome-page {
        max-width: 1000px;
        margin: 0 auto;
        padding-bottom: 4rem;
    }

    .welcome-hero {
        margin-bottom: 3rem;
    }

    .welcome-badge {
        display: inline-flex;
        align-items: center;
        padding: .4rem .9rem;
        border-radius: 999px;
        background: #eef2ff;
        color: #4338ca;
        font-size: .8rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .welcome-hero h1 {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1rem;
        color: #111827;
    }

    .welcome-description {
        font-size: 1.15rem;
        color: #6b7280;
        max-width: 750px;
        line-height: 1.8;
    }

    .welcome-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .section-number {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #2563eb;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 700;
    }

    .section-header h2 {
        margin: 0;
        font-size: 1.8rem;
        color: #111827;
    }

    .welcome-card p {
        font-size: 1rem;
        line-height: 2;
        color: #374151;
        margin-bottom: 1rem;
    }

    .success-callout {
        display: flex;
        gap: 1.5rem;
        padding: 2rem;
        border-radius: 20px;
        background: linear-gradient( 135deg, #eff6ff, #dbeafe );
        border: 1px solid #bfdbfe;
        margin-bottom: 2rem;
    }

    .alert-callout {
        display: flex;
        gap: 1.5rem;
        padding: 2rem;
        border-radius: 20px;
        background: linear-gradient( 135deg, #fefce8, #fef3c7 );
        border: 1px solid #fde68a;
        margin-bottom: 2rem;
    }

        .alert-callout h3 {
        margin-bottom: .5rem;
        color: #1e40af;
    }

        .alert-callout p {
        margin: 0;
        line-height: 1.8;
    }
    .callout-icon {
        font-size: 2.5rem;
    }

    .success-callout h3 {
        margin-bottom: .5rem;
        color: #1e40af;
    }

    .success-callout p {
        margin: 0;
        line-height: 1.8;
    }

    .next-step {
        border-top: 1px solid #e5e7eb;
        padding-top: 2rem;
    }

        .next-step span {
            font-size: .85rem;
            text-transform: uppercase;
            color: #9ca3af;
            letter-spacing: .1em;
        }

        .next-step h4 {
            margin-top: .5rem;
            margin-bottom: .5rem;
            font-size: 1.4rem;
        }

        .next-step p {
            color: #6b7280;
        }
</style>