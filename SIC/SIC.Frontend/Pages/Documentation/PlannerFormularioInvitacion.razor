        font-size: 1.15rem;
        color: #6b7280;
        max-width: 750px;
        line-height: 1.8;
    }

    .welcome-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

