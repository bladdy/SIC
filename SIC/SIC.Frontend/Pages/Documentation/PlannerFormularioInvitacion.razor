        border-radius: 50%;
        background: #367B82;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 700;
    }

    .section-header h2 {
        margin: 0;
        font-size: 1.8rem;
        color: #111827;
    }

    .welcome-card p {
        font-size: 1rem;
        line-height: 2;
        color: #374151;
        margin-bottom: 1rem;
    }

    .success-callout {
        display: flex;
        gap: 1.5rem;
        padding: 2rem;
        border-radius: 20px;
        background: linear-gradient( 135deg, #EAF4F5, #D7E8EA );
        border: 1px solid #CFDFE2;
        margin-bottom: 2rem;
    }

    .alert-callout {
        display: flex;
        gap: 1.5rem;
        padding: 2rem;
        border-radius: 20px;
        background: linear-gradient( 135deg, #fefce8, #fef3c7 );
        border: 1px solid #fde68a;
        margin-bottom: 2rem;
    }

        .alert-callout h3 {
            margin-bottom: .5rem;
            color: #2c6368;
        }

        .alert-callout p {
            margin: 0;
            line-height: 1.8;
        }

    .callout-icon {
        font-size: 2.5rem;
    }

    .success-callout h3 {
        margin-bottom: .5rem;
        color: #2c6368;
    }

    .success-callout p {
