@page "/ResetPassword"
@layout LoginLayout
<EditForm Model="resetPasswordDTO" OnValidSubmit="ResetAsync">
    <div class="min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-lg border-0 rounded-4" style="max-width: 500px; width: 100%;">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <h3 class="fw-bold" style="color:#3C6A79;">Nueva contraseña</h3>
                    <h6 class="text-muted small mt-2">Elige una nueva contraseña para tu cuenta.</h6>
                </div>

                <DataAnnotationsValidator />

                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold">Nueva contraseña</label>
                    <InputText type="password" class="form-control form-control-lg rounded-3" @bind-Value="@resetPasswordDTO.NewPassword" />
                    <ValidationMessage For="@(() => resetPasswordDTO.NewPassword)" />
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold">Confirmar contraseña</label>
                    <InputText type="password" class="form-control form-control-lg rounded-3" @bind-Value="@confirmPassword" />
                </div>

                <button class="btn w-100 py-2 rounded-3 fw-semibold btn-custom" type="submit">
                    Guardar nueva contraseña
                </button>

                <div class="mt-3 text-center">
                    <a class="text-decoration-none" style="color:#3C6A79;" href="/login">Volver al inicio de sesión</a>
                </div>
            </div>
        </div>
    </div>
</EditForm>