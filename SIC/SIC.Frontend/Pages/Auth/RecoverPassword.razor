@page "/RecoverPassword"
@layout LoginLayout
<EditForm Model="recoverPasswordDTO" OnValidSubmit="RecoverAsync">
    <div class="min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-lg border-0 rounded-4" style="max-width: 500px; width: 100%;">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <h3 class="fw-bold" style="color:#3C6A79;">Recuperar contraseña</h3>
                    <h6 class="text-muted small mt-2">Ingresa tu número de teléfono y te enviaremos un enlace para restablecer tu contraseña.</h6>
                </div>

                <DataAnnotationsValidator />

                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold">Teléfono</label>
                    <InputText class="form-control form-control-lg rounded-3" @bind-Value="@recoverPasswordDTO.PhoneNumber" />
                    <ValidationMessage For="@(() => recoverPasswordDTO.PhoneNumber)" />
                </div>

                <button class="btn w-100 py-2 rounded-3 fw-semibold btn-custom" type="submit">
                    Enviar enlace de recuperación
                </button>

                <div class="mt-3 text-center">
                    <a class="text-decoration-none" style="color:#3C6A79;" href="/login">Volver al inicio de sesión</a>
                </div>
            </div>
        </div>
    </div>
</EditForm>