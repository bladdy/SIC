@page "/services"
<PageTitle>Servicios</PageTitle>
<PageHeader Icon="bi-tools" Title="Servicios" Subtitle="Gestión de servicios">
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i class="bi bi-plus-lg"></i> Crear Servicio
    </button>
</PageHeader>

<GenericList MyList="Items">
    <Body>
        <table class="table sic-table mb-0">
            <thead>
                <tr class="text-center">
                    <th>Servicios</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var Item in Items!)
                {
                    <tr class="align-middle">
                        <td>@Item.Name</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-custom me-2" @onclick="() => ShowEditModal(Item)">
                                <i class="bi bi-pencil-fill"></i> Editar
                            </button>
                            <button class="btn btn-sm btn-custom" @onclick="() => ConfirmDelete(Item)">
                                <i class="bi bi-trash-fill"></i> Borrar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </Body>
</GenericList>

<!-- Modal -->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(IsEditMode ? "bi-pencil-square me-2" : "bi-tools me-2")"></i>@((IsEditMode ? "Editar Servicio" : "Crear Servicio"))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewItem" OnValidSubmit="@SaveItem">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="NewItem.Name" />
                            <ValidationMessage For="@(() => NewItem.Name)" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom btn-sm"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModal">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmModal IsVisible="IsConfirmVisible" IsVisibleChanged="OnConfirmVisibleChanged" Message="ConfirmMessage" OnConfirmAction="ExecutePendingDelete" />
