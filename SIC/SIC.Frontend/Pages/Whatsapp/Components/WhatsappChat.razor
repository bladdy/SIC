
<div class="chat-container">

    <!-- HEADER -->
    <div class="chat-header">
        <div class="chat-avatar">
            @PhoneNumber.Substring(Math.Max(0, PhoneNumber.Length - 2))

        </div>

        <div>
            <div style="font-weight:600;">@Messages!.FirstOrDefault()?.Name</div>
            <div style="font-size:12px; opacity:.8;">En línea</div>
        </div>
    </div>

    <!-- BODY -->
    <div class="chat-body" @ref="ChatBodyRef">
        @foreach (var msg in Messages)
        {
            <div class="chat-message"
                 style="justify-content:@(msg.Direction == "IN" ? "flex-start" : "flex-end")">
                <div class="chat-bubble"
                     style="background:@(msg.Direction == "IN" ? "#ffffff" : "#dcf8c6")">

                    @if (!string.IsNullOrEmpty(msg.Imagen))
                    {
                        <img src="@msg.Imagen" class="chat-image" />
                    }

                    <div class="chat-content">
                        @(FormatWhatsAppText(msg.Content))
                    </div>

                    <div class="chat-time">
                        @msg.Timestamp.ToLocal12h()
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- INPUT -->
    <div class="chat-input">
        <input placeholder="Escribe un mensaje…"
               @bind="NewMessage"
               @bind:event="oninput"
               @onkeydown="HandleEnter" />

        <button @onclick="SendMessage">➤</button>
    </div>

</div>
