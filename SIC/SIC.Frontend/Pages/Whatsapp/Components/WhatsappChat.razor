<style>
    .chat-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #efeae2;
    font-family: Segoe UI, Arial, sans-serif;
    overflow: hidden;
    }

    .chat-header {
    display: flex;
    align-items: center;
    padding: 12px;
    background: #075e54;
    color: white;
    box-shadow: 0 1px 3px rgba(0,0,0,.2);
    gap: 10px;
    }

    .chat-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #25d366;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    flex-shrink: 0;
    }

    .chat-body {
    flex: 1;
    padding: 12px;
    overflow-y: auto;
    background-color: #3C6A79;
    background-size: contain;
    }

    .chat-message {
    display: flex;
    margin-bottom: 8px;
    }

    .chat-bubble {
    max-width: 75%;
    padding: 8px 10px;
    border-radius: 8px;
    box-shadow: 0 1px 1px rgba(0,0,0,.15);
    font-size: 14px;
    word-wrap: break-word;
    }

    .chat-input {
    display: flex;
    padding: 10px;
    background: #f0f0f0;
    align-items: center;
    gap: 8px;
    }

    .chat-input input {
    flex: 1;
    padding: 10px 14px;
    border-radius: 20px;
    border: 1px solid #ccc;
    outline: none;
    font-size: 14px;
    }

    .chat-input button {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: none;
    background: #25d366;
    color: white;
    font-size: 18px;
    cursor: pointer;
    flex-shrink: 0;
    }

    /* 📱 MOBILE */
    @@media (max-width: 768px) {
    .chat-header

    {
    padding: 10px;
    }

    .chat-avatar {
    width: 36px;
    height: 36px;
    font-size: 14px;
    }

    .chat-bubble {
    max-width: 90%;
    font-size: 15px;
    }

    .chat-input input {
    font-size: 16px; /* evita zoom en iOS */
    }

    }
</style>

<div class="chat-container">

    <!-- HEADER -->
    <div class="chat-header">
        <div class="chat-avatar">
            @PhoneNumber.Substring(Math.Max(0, PhoneNumber.Length - 2))

        </div>

        <div>
            <div style="font-weight:600;">@Messages!.FirstOrDefault()?.Name</div>
            <div style="font-size:12px; opacity:.8;">En línea</div>
        </div>
    </div>

    <!-- BODY -->
    <div class="chat-body" @ref="ChatBodyRef">
        @foreach (var msg in Messages)
        {
            <div class="chat-message"
                 style="justify-content:@(msg.Direction == "IN" ? "flex-start" : "flex-end")">

                <div class="chat-bubble"
                     style="background:@(msg.Direction == "IN" ? "#ffffff" : "#dcf8c6")">

                    <div>@msg.Content</div>

                    <div style="
                        font-size:11px;
                        text-align:right;
                        color:#666;
                        margin-top:4px;">
                        @msg.Timestamp.ToLocal12h()
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- INPUT -->
    <div class="chat-input">
        <input placeholder="Escribe un mensaje…"
               @bind="NewMessage"
               @bind:event="oninput"
               @onkeydown="HandleEnter" />

        <button @onclick="SendMessage">➤</button>
    </div>

</div>
