@page "/whatsapp/inbox"
@using SIC.Frontend.Pages.Whatsapp.Components

<div class="wap-container position-relative @(SelectedEventCode != null ? "inbox-open" : "")">
    <div style="position: absolute; top: 8px; right: 12px; z-index: 2000;">
        <VolverButton />
    </div>

    <!-- EVENTOS -->
    <div class="wap-events">
        <div class="wap-events-header">Eventos</div>
        <div class="wa-inbox-list">
            @foreach (var ev in Inbox)
            {
                <div class="wa-inbox-item @(SelectedEventCode == ev.EventCode ? "active" : "")"
                     @onclick="() => SelectEvent(ev.EventCode!)">
                    <div class="wa-avatar">
                        @(string.IsNullOrEmpty(ev.EventCode)
                            ? ""
                            : ev.EventCode.Length <= 2
                            ? ev.EventCode
                            : ev.EventCode[^2..])
                    </div>
                    <div class="wa-text">
                        <span class="wa-title">@ev.EventName</span>
                        <div class="wa-preview">@ev.EventCode</div>
                    </div>
                    @if (ev.UnreadCount > 0)
                    {
                        <span class="wa-unread-badge">@ev.UnreadCount</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- PANEL DERECHO: solo existe en DOM si hay evento seleccionado (mobile) o siempre (desktop) -->
    <div class="wap-inbox-panel">
        @if (SelectedEventCode != null)
        {
            <WhatsappInbox EventCode="@SelectedEventCode"
                           OwnerPhone="@OwnerPhone"
                           OnBack="BackToEvents" />
        }
        else
        {
            <div class="wap-empty-desktop">Selecciona un evento</div>
        }
    </div>

</div>