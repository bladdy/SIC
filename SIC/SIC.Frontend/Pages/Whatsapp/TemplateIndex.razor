@page "/whatsapp_templates"
@using SIC.Shared.DTOs
<PageTitle>Plantillas</PageTitle>
<PageHeader Icon="bi-file-earmark-richtext"
Title="Plantillas"
Subtitle="Plantillas de mensajes de WhatsApp">
    <VolverButton />

    <a href="/whatsapp_templates/template-builder" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Crear Plantilla
    </a>
    <button class="btn btn-primary"
    @onclick="GenerateTemplates"
    disabled="@(isGenerating || hasGeneratedSuggested)"
    title="@(hasGeneratedSuggested ? "Ya generaste tus plantillas sugeridas." : "")">
        @(isGenerating
                ? "Iniciando..."
                : hasGeneratedSuggested
                    ? "Plantillas generadas"
                    : "Generar plantillas sugeridas")
    </button>
</PageHeader>

<div class="table-responsive d-none d-md-block">
    <table class="table sic-table mb-0">
        <thead>
            <tr>
                <th>Nombre de la plantilla</th>
                <th>Categoria</th>
                <th>Idioma</th>
                <th>Estado</th>
                <th>Accion</th>
            </tr>
        </thead>
        <tbody>
            @if (WhatsappTemplates?.Data != null && WhatsappTemplates.Data.Any())
            {
                @foreach (var template in WhatsappTemplates.Data)
                {
                    <tr>
                        <td>@template.Name</td>
                        <td>@template.Category</td>
                        <td>@template.Language</td>
                        <td>
                            @if (template.Status == "APPROVED")
                            {
                                <span class="sic-badge sic-badge-success">Aprobada</span>
                            }
                            else if (template.Status == "PENDING")
                            {
                                <span class="sic-badge sic-badge-warning">Pendiente</span>
                            }
                            else
                            {
                                <span class="sic-badge sic-badge-danger">@template.Status</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-start gap-2">
                                
                                <button class="btn btn-custom" @onclick="() => OpenTemplatePreview(template)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                    <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                                </button>
                                @if (!TemplateImages.Contains(template.Name))
                                {
                                    <button class="btn btn-danger" @onclick="() => DeleteTemplate(template)">
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="24"
                                             height="24"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round"
                                             class="icon icon-tabler icons-tabler-outline icon-tabler-trash">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M4 7l16 0" />
                                            <path d="M10 11l0 6" />
                                            <path d="M14 11l0 6" />
                                            <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                            <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No hay plantillas registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-block d-md-none sic-mobile-card">
    @if (WhatsappTemplates?.Data != null && WhatsappTemplates.Data.Any())
    {
        @foreach (var template in WhatsappTemplates.Data)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Nombre:</strong>
                        <span>@template.Name</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Categoria:</strong>
                        <span>@template.Category</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Idioma:</strong>
                        <span>@template.Language</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Estado:</strong>
                        @if (template.Status == "APPROVED")
                        {
                            <span class="sic-badge sic-badge-success">Aprobada</span>
                        }
                        else if (template.Status == "PENDING")
                        {
                            <span class="sic-badge sic-badge-warning">Pendiente</span>
                        }
                        else
                        {
                            <span class="sic-badge sic-badge-danger">@template.Status</span>
                        }
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <div class="d-flex justify-content-end gap-2">

                            <button class="btn btn-custom" 
                            @onclick="() => OpenTemplatePreview(template)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" 
                                height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" 
                                class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                    <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                                </svg>
                            </button>
                            @if (!TemplateImages.Contains(template.Name))
                            {
                                <button class="btn btn-danger" @onclick="() => DeleteTemplate(template)">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="24"
                                         height="24"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         class="icon icon-tabler icons-tabler-outline icon-tabler-trash">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M4 7l16 0" />
                                        <path d="M10 11l0 6" />
                                        <path d="M14 11l0 6" />
                                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                    </svg>
                                </button>
                            }
                        </div>
                        
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted py-4">
            No hay plantillas registradas
        </div>
    }
</div>

@if (SelectedTemplate != null)
{
    <div class="template-backdrop" @onclick="CloseTemplatePreview"></div>
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85);">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation style="max-width: 380px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; background: white;">
                <div class="modal-header border-0 pb-2" style="background-color: #075e54; border-radius: 16px 16px 0 0;">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <span class="fw-bold text-white me-2">@SelectedTemplate.Name</span>
                        
                        <button type="button" class="btn-close btn-close-white ms-2" @onclick="CloseTemplatePreview"></button>
                    </div>
                </div>
                <div class="modal-body p-3" style="background-color: #367B82;">
                    <div class="template-bubble">
                        @if (HasImage(SelectedTemplate))
                        {
                            <div class="template-header-image">
                                <img src="@GetHeaderImageUrl(SelectedTemplate)" alt="Header"/>
                            </div>
                        }

                        @foreach (var component in (SelectedTemplate.Components ?? new List<Component>()))
                        {
                            if (string.Equals(component.Type, "BODY", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="template-body">
                                    @RenderBodyText(component)
                                </div>
                            }
                            else if (string.Equals(component.Type, "FOOTER", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="template-footer">
                                    @component.Text
                                </div>
                            }
                        }

                        @if (HasButtons(SelectedTemplate))
                        {
                            <div class="template-buttons mt-3">
                                <button class="template-btn">Boton(es)</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmModal IsVisible="IsConfirmVisible" IsVisibleChanged="OnConfirmVisibleChanged" Message="@ConfirmMessage" OnConfirmAction="ExecutePendingDelete" />
