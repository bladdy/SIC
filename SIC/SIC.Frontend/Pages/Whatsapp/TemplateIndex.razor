@page "/whatsapp_templates"
<PageTitle>Plantillas</PageTitle>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h3 class="mb-2 mb-md-0">Plantillas</h3>
    <div>
        <a href="/whatsapp_templates/template-builder" class="btn btn-custom mt-2 mt-md-0">
            <i class="oi oi-plus"></i> Crear Plantilla
        </a>
        <button class="btn btn-custom mt-2 mt-md-0"
                @onclick="GenerateTemplates"
                disabled="@isGenerating">
            @(isGenerating ? "Iniciando..." : "Generar plantillas sugeridas")
        </button>
    </div>
</div>

<div class="table-responsive d-none d-md-block">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nombre de la plantilla</th>
                <th>Categoria</th>
                <th>Idioma</th>
                <th>Estado</th>
                <th>Imagen</th>
            </tr>
        </thead>
        <tbody>
            @if (WhatsappTemplates?.Data != null && WhatsappTemplates.Data.Any())
            {
                @foreach (var template in WhatsappTemplates.Data)
                {
                    <tr>
                        <td>@template.Name</td>
                        <td>@template.Category</td>
                        <td>@template.Language</td>
                        <td>
                            @if (template.Status == "APPROVED")
                            {
                                <span class="badge bg-success">Aprobada</span>
                            }
                            else if (template.Status == "PENDING")
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">@template.Status</span>
                            }
                        </td>
                        <td><button class="btn btn-custom" @onclick="() => OpenTemplateImage(template)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg></button> </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No hay plantillas registradas
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-block d-md-none">
    @if (WhatsappTemplates?.Data != null && WhatsappTemplates.Data.Any())
    {
        @foreach (var template in WhatsappTemplates.Data)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Nombre:</strong>
                        <span>@template.Name</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Categoria:</strong>
                        <span>@template.Category</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Idioma:</strong>
                        <span>@template.Language</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Estado:</strong>
                        @if (template.Status == "APPROVED")
                        {
                            <span class="badge bg-success">Aprobada</span>
                        }
                        else if (template.Status == "PENDING")
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@template.Status</span>
                        }
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <strong>Ver Plantilla:</strong>
                        <button class="btn btn-custom" @onclick="() => OpenTemplateImage(template)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-eye"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg></button>
                        
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted py-4">
            No hay plantillas registradas
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(SelectedImageUrl))
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.8);" @onclick="CloseTemplateImage">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation>
            <div class="modal-content bg-transparent border-0">
                <div class="modal-header border-0">
                    <small class="text-white text-truncate me-2">@SelectedImageName</small>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseTemplateImage"></button>
                </div>
                <div class="modal-body text-center p-0">
                    <img src="@SelectedImageUrl" alt="@SelectedImageName" class="img-fluid" style="max-height:75vh;" />
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-secondary" @onclick="CloseTemplateImage">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}
