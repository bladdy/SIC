@page "/whatsapp_templates"
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
    <h3 class="mb-0">Plantillas</h3>
    <a href="/whatsapp_templates/template-builder" class="btn btn-custom mt-2 mt-md-0">
        <i class="oi oi-plus"></i> Crear Plantilla
    </a>
</div>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nombre de la plantilla</th>
            <th>Categoría</th>
            <th>Idioma</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @if (WhatsappTemplates?.Data != null && WhatsappTemplates.Data.Any())
        {
            @foreach (var template in WhatsappTemplates.Data)
            {
                <tr>
                    <td>@template.Name</td>
                    <td>@template.Category</td>
                    <td>@template.Language</td>
                    <td>
                        @if (template.Status == "APPROVED")
                        {
                            <span class="badge bg-success">Aprobada</span>
                        }
                        else if (template.Status == "PENDING")
                        {
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@template.Status</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">
                    No hay plantillas registradas
                </td>
            </tr>
        }

    </tbody>

</table>
