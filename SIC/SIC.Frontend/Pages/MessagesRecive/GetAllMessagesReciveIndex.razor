@page "/my-messages-recive"

<PageHeader Icon="bi-inbox"
            Title="Recibidos de mensajes"
            Subtitle="Mensajes recibidos de los invitados">
</PageHeader>

<GenericList MyList="MessagesRecive">
    <Body>
        <table class="table sic-table mb-0">
            <thead>
                <tr class="text-center">
                    <th>Nombre</th>
                    <th>Invitacion</th>
                    <th>Evento</th>
                    <th>Desde</th>
                    <th>Mensaje</th>
                    <th>Fecha Envio</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var messagesReciveDTO in MessagesRecive!)
                {
                    <tr class="align-middle">

                        <td>@messagesReciveDTO.InvitationName</td>
                        <td>@messagesReciveDTO.InvitationCode</td>
                        <td>@messagesReciveDTO.EventName</td>
                        <td>@messagesReciveDTO.From</td>
                        <td>@messagesReciveDTO.Message</td>
                        <td>@messagesReciveDTO.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>

    </Body>
</GenericList>