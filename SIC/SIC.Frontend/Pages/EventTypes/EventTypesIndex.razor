@page "/events-types"
<PageTitle>Tipos de Eventos</PageTitle>
<PageHeader Icon="bi-tags"
            Title="Tipos de Eventos"
            Subtitle="Catálogo de tipos">
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i class="bi bi-plus-lg"></i> Crear Tipo de Evento
    </button>
</PageHeader>

<GenericList MyList="EventsType">
    <Body>
        <div class="table-responsive">
            <table class="table sic-table mb-0">
                <thead>
                    <tr class="text-center">
                        <th class="text-start">Tipos de eventos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
            <tbody>
                @foreach (var EventType in EventsType!)
                {
                    <tr class="align-middle">
                        <td>@EventType.Name</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-custom me-2" @onclick="() => ShowEditModal(EventType)">
                                <i class="bi bi-pencil-fill"></i> Editar
                            </button>
                            <button class="btn btn-sm btn-custom" @onclick="() => ConfirmDelete(EventType)">
                                <i class="bi bi-trash-fill"></i> Borrar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

    </Body>
</GenericList>

<!-- Modal -->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(IsEditMode ? "bi-pencil-square me-2" : "bi-tag me-2")"></i>@((IsEditMode ? "Editar Tipo de de Evento" : "Crear Tipo de de Evento"))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewEventType" OnValidSubmit="@SaveEventTypes">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="NewEventType.Name" />
                            <ValidationMessage For="@(() => NewEventType.Name)" />
                        </div>                        
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom btn-sm"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModal">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmModal IsVisible="IsConfirmVisible" IsVisibleChanged="OnConfirmVisibleChanged" Message="ConfirmMessage" OnConfirmAction="ExecutePendingDelete" />
