@page "/events/details/{Code}"
@using SIC.Frontend.Shared
<PageTitle>Detalles del Evento</PageTitle>
<!--
<h3 class="mb-2">Detalle del Evento</h3>-->
@if (EventDetail is null)
{
    <div class="alert alert-info">Cargando evento...</div>
}
else
{
    <div class="card shadow-lg border-0 rounded-3 mb-3 ">
        <!-- Header: título, subtítulo, tipo y estado -->
        <div class="card-header text-white position-relative" style="background-color:#3C6A79;">
            <div class="d-flex justify-content-between align-items-stretch flex-wrap">
                <div>
                    <h4 class="mb-0">@EventDetail.Name</h4>
                    <small>@EventDetail.SubTitle</small>
                    <div><strong>@EventDetail.User!.UserType.GetDescription():</strong> @EventDetail.User!.FullName</div>
                    <p class="mb-1"><strong>Evento:</strong> @EventDetail.EventType?.Name</p>
                    <p class="mb-1"><strong>Fecha:</strong> @EventDetail.Date.ToString("dd/MM/yyyy")</p>
                </div>

                <div class="text-end d-flex flex-column justify-content-end">
                    <p class="mb-1">
                        <strong>Estado:</strong>
                        <span class="badge bg-@(EventDetail.Status == Status.Active ? "success" : "secondary")">
                            @EventDetail.Status.GetDescription()
                        </span>
                    </p>
                </div>
            </div>

            <!-- Botón QR: versión escritorio -->
            <a href="/events/register-event/invitations-entries/@EventDetail.Code"
            class="btn btn-sm text-white position-absolute top-0 end-0 mt-2 me-2 d-none d-md-inline-flex align-items-center"
            style="background-color:#1F4854; border-color:white;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="me-1">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h3v3h3v3h-6z" />
                </svg>
                Scan QR
            </a>

            <!-- Botón QR: versión móvil -->
            <a href="/events/register-event/invitations-entries/@EventDetail.Code"
            class="btn btn-sm text-white mt-2 px-4 position-absolute bottom-0 end-0 mb-2 me-2 d-block d-md-none align-items-center"
            style="background-color:#1F4854; border-color:white;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="me-1">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h3v3h3v3h-6z" />
                </svg>
                Scan QR
            </a>

        </div>


        <!-- Body: Información detallada -->
        <div class="card-body">

            <!-- ======================== -->
            <!-- SECCIÓN 2: Invitados -->
            <!-- ======================== -->
            <div class="row text-center align-items-stretch g-1 g-md-3 mt-0">
                <!-- Invitados -->
                <div class="col-12 col-md-3 mb-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white" style="background-color:#3C6A79;">
                        <strong>Invitados:</strong>
                        <span>@(EventDetail.NumberAdults + EventDetail.NumberChildren)</span>
                    </p>
                </div>
                <!-- Adultos -->
                <div class="col-6 col-md-3">
                    <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                        <strong>Adultos:</strong>
                        <span>@EventDetail.NumberAdults</span>
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                        <strong>Jóvenes:</strong>
                        <span>@EventDetail.NumberYouths</span>
                    </p>
                </div>

                <!-- Niños -->
                <div class="col-6 col-md-3">
                    <p class="d-flex justify-content-between px-3 py-1 text-white " style="background-color:#3C6A79;">
                        <strong>Niños:</strong>
                        <span>@EventDetail.NumberChildren</span>
                    </p>
                </div>

            </div>

            <!-- ======================== -->
            <!-- SECCIÓN 3: Confirmaciones -->
            <!-- ======================== -->
            <div class="row text-center align-items-stretch g-1 g-md-3 mt-0">
                <!-- (Sí asistiré) -->
                <div class="col-12 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success">
                        <strong>Total SÍ ASISTIRÉ:</strong>
                        <span>@(EventDetail.NumberAdultsConfirmed + EventDetail.NumberChildrenConfirmed + EventDetail.NumberYouthsConfirmed)</span>
                    </p>
                </div>

                <!-- Adultos (Sí asistiré) -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                        <strong>Adultos:</strong>
                        <span>@EventDetail.NumberAdultsConfirmed</span>
                    </p>
                </div>

                <!-- Jóvenes (Sí asistiré) -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                        <strong>Jóvenes:</strong>
                        <span>@EventDetail.NumberYouthsConfirmed</span>
                    </p>
                </div>

                <!-- Niños (Sí asistiré) -->
                <div class="col-6 col-md-3 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-success ">
                        <strong>Niños:</strong>
                        <span>@EventDetail.NumberChildrenConfirmed</span>
                    </p>
                </div>

                <!-- No asistiré -->
                <div class="col-12 col-md-4 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-danger ">
                        <strong>Total NO ASISTIRÉ:</strong>
                        <span>@(EventDetail.NumberAdultsNotAttend + EventDetail.NumberChildrenNotAttend + EventDetail.NumberYouthNotAttend)</span>
                    </p>
                </div>

                <!-- Pendientes -->
                <div class="col-12 col-md-4 m-0">
                    <p class="d-flex justify-content-between px-3 py-1 text-white bg-warning ">
                        <strong>Pendientes:</strong>
                        <span>@(EventDetail.NumberAdultsPending + EventDetail.NumberChildrenPending + EventDetail.NumberYouthPending)</span>
                    </p>
                </div>
            </div>

        </div>

        <!-- Footer: Botones de acción -->
        <div class="card-footer d-flex justify-content-center flex-wrap gap-2">
            <div class="text-center">
                <!-- Título centrado arriba -->
                <h4 class="mb-1">Crear Lista de Invitados</h4>

                <!-- Contenedor responsive -->
                <div class="d-flex flex-column flex-lg-row justify-content-center align-items-center  gap-2 mt-2">
                    <!-- En mobile: los botones se apilan como indicas -->
                    <!-- En PC: se ponen en una fila juntos debajo del título -->
                    <div class="d-flex justify-content-center gap-2 mb-2 mb-lg-0">
                        <button class="btn btn-sm btn-custom" @onclick="DescargarExcel" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span> Generando... </span>
                            }
                            else
                            {
                                <span>Exportar Excel</span>
                            }
                        </button>
                        <button class="btn btn-sm btn-custom" @onclick="ShowModalExcel">Importar Excel</button>
                    </div>

                    <!-- Botón que en móvil queda debajo, pero en escritorio en la misma fila -->
                    <div>
                        <button class="btn btn-sm btn-custom" @onclick="ShowCreateModal">Agregar Invitado</button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <h4 class="mb-0">Lista de Invitados</h4>
    ﻿﻿
    <!--<Filter PlaceHolder="Buscar Invitacion..." Callback=@FilterCallBack /> 25d366-->
    ﻿﻿<div class="mb-2 gap-2" style="display: flex; flex-wrap:wrap; align-items: center;">
        <input style="width:400px;" type="text" class="form-control" placeholder="Buscar Invitacion..." @bind-value="Filter">
        <div style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center; justify-content: start;">
            <button type="button" class="btn btn-custom" style="display: flex; align-items: center; gap: 4px;" @onclick="ApplyFilterAsync"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-search"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg> Buscar</button>
            <button type="button" class="btn btn-custom" style="display: flex; align-items: center; gap: 4px;" @onclick="CleanFilterAsync"><i class="bi bi-x-circle" /> Limpiar</button>
            <button type="button" class="btn btn-custom mt-2 mt-lg-0" style="display: flex; align-items: center; gap: 4px;" @onclick="NavegateToMessage"> <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>Mensajes</button>

        </div>
        <div class="form-check form-switch">
            <input class="form-check-input btn-custom" type="checkbox" id="chkUsarWhatsApp" @bind="usarWhatsApp" />
            <label class="form-check-label fw-bold" for="chkUsarWhatsApp">
                @(usarWhatsApp ? "Modo: Enviar por WhatsApp" : "Modo: Copiar al Portapapeles")
            </label>
        </div>
    </div>

    <!-- ====== VERSIÓN DE ESCRITORIO ====== -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#3C6A79; color:white;">
                <tr class="text-center">
                    <th class="text-start">Detalle del Invitado</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Invitations != null && Invitations.Any())
                {
                    @foreach (var invitation in Invitations)
                    {
                        <tr class="border-top">
                            <!-- ======== COLUMNA 1: INFORMACIÓN GENERAL ======== -->
                            <td style="white-space: normal; vertical-align: top;">
                                <div class="container-fluid">
                                    <div class="row g-3 small text-secondary">
                                        <!-- ===== COLUMNA 1 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-column">
                                            <div>
                                                <strong>Código:</strong>
                                                <a style="color:#3C6A79; cursor:pointer;" @onclick="() => ShowEditModal(invitation)">
                                                    @invitation.Code
                                                </a>
                                            </div>
                                            <div><strong>Nombre:</strong> @invitation.Name</div>
                                            <div><strong>Móvil:</strong> @invitation.PhoneNumber</div>
                                            <div><strong>Mesa:</strong> @invitation.Table</div>
                                        </div>

                                        <!-- ===== COLUMNA 2 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-column">
                                            @if (invitation.Guests.Any())
                                            {
                                                @foreach (var guest in invitation.Guests)
                                                {
                                                    <div><strong>@guest.GuestName</strong> (@guest.GuestType.GetDescription())</div>
                                                
                                                }
                                                
                                            }
                                        </div>

                                        <!-- ===== COLUMNA 3 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-wrap align-items-center gap-2">
                                            @if (usarWhatsApp)
                                            {
                                                
                                                <button class="btn d-inline-flex align-items-center gap-2 text-white"
                                                        style="background-color:#25d366;"
                                                        @onclick="() => EnviarInvitacion(invitation.Code!)"
                                                        disabled="@(isLoadingWhatsapp == true)">
                                                    @if (isLoadingWhatsapp == true)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                        <span>Invitando...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-whatsapp"></i>
                                                        <span>Invitar</span>
                                                    }
                                                </button>
                                                <!--
                                                <button class="btn d-inline-flex align-items-center gap-2 text-white"
                                                        style="background-color:#25d366;"
                                                        @onclick="() => AbrirWhatsapp(invitation.PhoneNumber, invitation.Code!, invitation.Id, 1)"
                                                        disabled="@(loadingWhatsappId1 == invitation.Id)">
                                                    @if (loadingWhatsappId1 == invitation.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                        <span>Invitando...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-whatsapp"></i>
                                                        <span>Invitar</span>
                                                    }
                                                </button> -->

                                                <button class="btn d-inline-flex align-items-center gap-2 text-white d-none"
                                                        style="background-color:#25d366;"
                                                        @onclick="() => AbrirWhatsapp(invitation.PhoneNumber, invitation.Code!, invitation.Id, 1)"
                                                        disabled="@(loadingWhatsappId1 == invitation.Id)">
                                                    @if (loadingWhatsappId1 == invitation.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                        <span>Invitando...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-whatsapp"></i>
                                                        <span>Invitar</span>
                                                    }
                                                </button>

                                                <button class="btn d-inline-flex align-items-center gap-2 text-white"
                                                        style="background-color:#25d366;"
                                                        @onclick="() => AbrirWhatsapp(invitation.PhoneNumber, invitation.Code!, invitation.Id, 2)"
                                                        disabled="@(loadingWhatsappId2 == invitation.Id)">
                                                    @if (loadingWhatsappId2 == invitation.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                        <span>Avisando...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-whatsapp"></i>
                                                        <span>Avisar</span>
                                                    }
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-info d-inline-flex align-items-center gap-2 text-white"
                                                        @onclick="() => CopiarInvitacion(invitation.Code!, invitation.Id, 1)"
                                                        disabled="@(copyingId1 == invitation.Id)">
                                                    @if (copyingId1 == invitation.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                        <span>Copiando...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-clipboard"></i>
                                                        <span>Invitar</span>
                                                    }
                                                </button>

                                                <button class="btn btn-info d-inline-flex align-items-center gap-2 text-white"
                                                        @onclick="() => CopiarInvitacion(invitation.Code!, invitation.Id, 2)"
                                                        disabled="@(copyingId2 == invitation.Id)">
                                                    @if (copyingId2 == invitation.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                        <span>Copiando...</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-clipboard"></i>
                                                        <span>Avisar</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- ======== COLUMNA 2: ESTADO ======== -->
                            <td class="text-center">
                                <span class="px-3 py-2 fs-6 badge @(invitation.Status == Status.Attend ? "bg-success" : invitation.Status == Status.NotAttend ? "bg-danger" : "bg-secondary")">
                                    @invitation.Status.GetDescription()
                                </span>
                            </td>

                            <!-- ======== COLUMNA 3: ACCIONES VACÍA PARA ALINEAR ======== -->
                            <td>
                                <button class="btn btn-custom" @onclick="() => ShowEditModal(invitation)">
                                    <i class="bi bi-pencil-fill"></i> Editar
                                </button>
                            </td>
                        </tr>

                        <!-- ======== FILA PARA DEDICATORIA ======== -->
                        @if (!string.IsNullOrEmpty(invitation.Comments))
                        {
                            <tr>
                                <td colspan="3" class="text-secondary" style="word-wrap: break-word;">
                                    <strong>Dedicatoria:</strong> @invitation.Comments
                                </td>
                            </tr>
                        }

                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No hay invitados registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ✅ Vista móvil tipo “detalle” -->
    <div class="d-block d-md-none">
        @foreach (var invitation in Invitations!)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">@invitation.Name</h5>
                        <span class="badge bg-@(invitation.Status == Status.Attend ? "success" : invitation.Status == Status.NotAttend ? "danger" : "secondary")">
                            @invitation.Status.GetDescription()
                        </span>
                    </div>
                    <div class="row justify-content-between align-items-center">
                        @if (invitation.Guests.Any())
                        {
                            @foreach (var guest in invitation.Guests)
                            {
                                <div><strong>@guest.GuestName</strong> (@guest.GuestType.GetDescription())</div>

                            }

                        }
                    </div>
                    <p class="mb-1"><strong>Mesa:</strong> @invitation.Table</p>
                    <p class="mb-1"><strong>Dedicatoria:</strong> @invitation.Comments</p>

                    <div class="d-flex flex-wrap gap-1 mt-3">
                        @if (usarWhatsApp)
                        {
                            <button class="btn d-flex align-items-center gap-1 flex-fill" style="background-color:#25d366; color:white;"
                                    @onclick="() => AbrirWhatsapp(invitation.PhoneNumber, invitation.Code!, invitation.Id, 1)">
                                <i class="bi bi-whatsapp"></i> Invitar
                            </button>
                            <button class="btn d-flex align-items-center gap-1 flex-fill" style="background-color:#25d366; color:white;"
                                    @onclick="() => AbrirWhatsapp(invitation.PhoneNumber, invitation.Code!, invitation.Id, 2)">
                                <i class="bi bi-whatsapp"></i> Aviso
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-info d-flex align-items-center gap-1 flex-fill text-white"
                                    @onclick="() => CopiarInvitacion(invitation.Code!, invitation.Id, 1)">
                                <i class="bi bi-clipboard"></i> Invitar
                            </button>
                            <button class="btn btn-info fd-flex align-items-center gap-1 flex-fill text-white"
                                    @onclick="() => CopiarInvitacion(invitation.Code!, invitation.Id, 2)">
                                <i class="bi bi-clipboard"></i> Aviso
                            </button>
                        }

                        <button class="btn btn-custom d-flex align-items-center gap-1 flex-fill" @onclick="() => ShowEditModal(invitation)">
                            <i class="bi bi-pencil-fill"></i>Editar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center my-3">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPageAsync" />

    </div>
}
@if (IsModalExcelVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Importar Excel
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModalExcel"></button>
                </div>


                <div class="modal-body">
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex flex-column gap-2">
                            <!-- InputFile oculto -->
                            <InputFile class="d-none" id="fileInput" OnChange="HandleFileSelected" />

                            <!-- Label que actúa como botón -->
                            <label for="fileInput" class="form-control form-control-sm w-100 text-center" style="cursor:pointer;">
                                Elige un archivo
                            </label>
                            <!-- Checkbox con label en la misma línea y centrado vertical -->
                            <div class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input custom" type="checkbox"
                                       id="deleteRegisterCheck"
                                       checked="@DeleteRegister"
                                       @onchange="(e) => DeleteRegister = e.Value is bool value && value" />
                                <label class="form-check-label mb-0" for="deleteRegisterCheck">
                                    Eliminar los registros que no estén en el Excel.
                                </label>
                            </div>
                            <!-- Botón de carga -->
                            <button class="btn btn-sm btn-custom w-100"
                                    @onclick="SubirExcel" disabled="@(!hasFileSelected || isLoadingImport)">
                                @if (isLoadingImport)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Cargando...</span>
                                }
                                else
                                {
                                    <span>Cargar Lista de Invitados</span>
                                }
                            </button>
                        </div>
                    </div>



                </div>
                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" @onclick="CloseModalExcel">
                        Cerrar
                    </button>
                </div>
            </div>

        </div>
    </div>
}
<!-- Modal -->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @((IsEditMode ? $"Editar Invitacion: {@NewInvitation.Code}" : "Crear Invitacion"))
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewInvitation" OnValidSubmit="@SaveInvitation">
                        <DataAnnotationsValidator />
                        <ValidationSummary />


                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="NewInvitation.Name" />
                            <ValidationMessage For="@(() => NewInvitation.Name)" />
                        </div>
                        <div class="mb-3 row">
                            <div class="col-auto d-none">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="NewInvitation.Email" placeholder="Como estará rotulada la invitacion" />
                                <ValidationMessage For="@(() => NewInvitation.Email)" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">WhatsApp</label>
                            <InputText class="form-control" @bind-Value="NewInvitation.PhoneNumber" placeholder="Número de WhasApp" />
                            <ValidationMessage For="@(() => NewInvitation.PhoneNumber)" />
                        </div>
                        <div class="mb-3">
                            <div class="d-flex flex-row align-items-center gap-2 mb-3">
                                <label class="form-label fw-bold">Invitados</label>
                                <button type="button" class="btn btn-custom rounded-circle p-2" @onclick="AddGuest">

                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" 
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" 
                                    stroke-linecap="round" stroke-linejoin="round" >
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M5 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                                    <path d="M3 21v-2a4 4 0 0 1 4 -4h4c.96 0 1.84 .338 2.53 .901" />
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                    <path d="M16 19h6" />
                                    <path d="M19 16v6" />
                                </svg>
                                </button>
                            </div>

                            @foreach (var guest in NewInvitation.Guests)
                            {
                                <div class=" d-flex flex-row align-items-center gap-2 mb-3">
                                    <div class="flex-grow-1">
                                        <InputText class="form-control" @bind-Value="guest.GuestName" placeholder="Nombre del invitado" />
                                    </div>
                                    <div >
                                        <InputSelect class="form-select" @bind-Value="guest.GuestType" @bind-Value:after="OnGuestTypeChanged">
                                            @foreach (var status in Enum.GetValues<GuestType>())
                                            {
                                                <option value="@status" selected="@(status.Equals(Enum.GetValues<GuestType>().First()))">
                                                    @status.GetDescription()
                                                </option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div >
                                        <button type="button" class="btn btn-danger rounded-circle p-2" @onclick="() => RemoveGuest(guest)">

                                            <svg xmlns="http://www.w3.org/2000/svg" 
                                            width="24" height="24" viewBox="0 0 24 24" 
                                            fill="none" stroke="currentColor" 
                                            stroke-width="2" stroke-linecap="round" 
                                            stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M4 7l16 0" /><path d="M10 11l0 6" />
                                            <path d="M14 11l0 6" />
                                            <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                            <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                        </svg>
                                        </button>
                                    </div>
                                </div>
                            }

                        </div>
                        <div class="mb-3 row col-12">
                            <div class="col-4">
                                <label class="form-label">Adultos</label>
                                <InputNumber class="form-control" @bind-Value="NewInvitation.NumberAdults" />
                                <ValidationMessage For="@(() => NewInvitation.NumberAdults)" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Jóvenes</label>
                                <InputNumber class="form-control" @bind-Value="NewInvitation.NumberYouths" />
                                <ValidationMessage For="@(() => NewInvitation.NumberYouths)" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">Niños</label>
                                <InputNumber class="form-control" @bind-Value="NewInvitation.NumberChildren" />
                                <ValidationMessage For="@(() => NewInvitation.NumberChildren)" />
                            </div>
                        </div>
                        @if (IsEditMode)
                        {
                            <div class="dropdown-divider mb-2"></div>
                            <h5 class="mb-2">Respuesta de confirmación</h5>

                            <div class="mb-3">
                                <label class="form-label">Estado</label>
                                <InputSelect class="form-select" @bind-Value="NewInvitation.Status">
                                    <option value="">-- Selecciona un Estado --</option>
                                    @foreach (var status in Enum.GetValues<Status>()
                            .Where(s => s == Status.NotAttend || s == Status.Pending || s == Status.Attend || s == Status.Warned))
                                    {
                                        <option value="@status">@status.GetDescription()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => NewInvitation.Status)" />
                            </div>

                            <div class="mb-3 row col-12">
                                <div class="col-4">
                                    <label class="form-label">Adultos</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitation.NumberConfirmedAdults" />
                                    <ValidationMessage For="@(() => NewInvitation.NumberConfirmedAdults)" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Jóvenes</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitation.NumberConfirmedYouths" />
                                    <ValidationMessage For="@(() => NewInvitation.NumberConfirmedYouths)" />
                                </div>
                                <div class="col-4">
                                    <label class="form-label">Niños</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitation.NumberConfirmedChildren" />
                                    <ValidationMessage For="@(() => NewInvitation.NumberConfirmedChildren)" />
                                </div>

                            </div>


                            <div class="mb-3">
                                <label class="form-label">Mesa</label>
                                <InputText class="form-control" @bind-Value="NewInvitation.Table" />
                                <ValidationMessage For="@(() => NewInvitation.Table)" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Dedicatoria</label>
                                <InputTextArea class="form-control" @bind-Value="NewInvitation.Comments" />
                                <ValidationMessage For="@(() => NewInvitation.Comments)" />
                            </div>
                        }

                        <!--Inhabilitar los botones hasta que termine de enviar-->
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom" disabled="@(isSavingInvitation)">
                                Guardar
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                                Cancelar
                            </button>
                            @if (IsEditMode)
                            {
                                <button type="button" class="btn btn-danger" @onclick="DeleteInvitation">
                                    Eliminar
                                </button>

                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}