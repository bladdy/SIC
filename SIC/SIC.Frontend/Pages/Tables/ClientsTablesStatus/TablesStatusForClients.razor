@page "/status-tables/{Code}"
@layout LoginLayout


<PageTitle>Detalles de las Mesas</PageTitle>


@if (Tables is null)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-custom mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <div class="text-muted">Cargando mesas...</div>
        </div>
    </div>
}
else
{
    <div class="container-fluid p-0 p-md-4">

        <PageHeader Icon="bi-tools-kitchen-2" Title="@(Tables.FirstOrDefault()?.Event?.Name ?? "")" Subtitle="Mis mesas" />

        <!-- Encabezado -->
        <div class="row g-1 text-center my-3">
            <div class="col">
                <h5 class="fw-bold mb-0">@totalTables</h5>
                <small class="text-muted">Total</small>
            </div>
            <div class="col">
                <h5 class="fw-bold mb-0">@totalSeats</h5>
                <small class="text-muted">Lugares</small>
            </div>
            <div class="col">
                <h5 class="fw-bold mb-0">@availableSeats</h5>
                <small class="text-muted">Disponibles</small>
            </div>
            <div class="col">
                <h5 class="fw-bold mb-0">@occupiedSeats</h5>
                <small class="text-muted">Ocupados</small>
            </div>
        </div>

        <!-- Tarjetas -->
        <div class="row g-4">

            @foreach (var mesa in Tables)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card mesa-card h-100" style="border: 2px solid #367B82; border-radius: 15px;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <small class="text-muted">@mesa.Description</small>
                                    <h3 class="fw-bold mb-0" style="font-size: 1.8rem;">Mesa: @mesa.Name</h3>
                                </div>
                                <span class="badge @GetTableStatusClass(mesa)">@GetTableStatusLabel(mesa)</span>
                            </div>

                            <!-- Progress bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">@mesa.OccupiedSeats / @mesa.Seats lugares</small>
                                    <small class="text-muted">@(mesa.Seats > 0 ? (int)((double)mesa.OccupiedSeats / mesa.Seats * 100) : 0)%</small>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar @GetTableStatusClass(mesa)"
                                         style="width: @(mesa.Seats > 0 ? (int)Math.Min((double)mesa.OccupiedSeats / mesa.Seats * 100, 100) : 0)%">
                                    </div>
                                </div>
                                <small class="text-muted">@(mesa.Seats - mesa.OccupiedSeats) lugares disponibles</small>
                            </div>

                            <!-- Guests list -->
                            <div style="max-height: 300px; overflow-y: auto;">
                                @foreach (var invitacion in mesa.Invitations)
                                {
                                    <div class="card mb-1">
                                        <div class="card-body p-2 p-sm-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <h6 class="fw-bold mb-0 small">@invitacion.Name</h6>
                                            </div>
                                            @if (invitacion.Guests?.Any() == true)
                                            {
                                                @foreach (var guest in invitacion.Guests.Where(g => g.Status == SIC.Shared.Enums.Status.Attend && (g.TablesEventsId == null || g.TablesEventsId == mesa.Id)))
                                                {
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <small>@guest.GuestName</small>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <small class="text-muted small">Sin invitados confirmados</small>
                                            }
                                        </div>
                                    </div>
                                }

                                @{
                                    var directGuestsByInvitation = mesa.Guests?
                                        .Where(g => g.TablesEventsId == mesa.Id && g.Status == SIC.Shared.Enums.Status.Attend && g.Invitation != null && !mesa.Invitations.Any(i => i.Id == g.InvitationId))
                                        .GroupBy(g => g.InvitationId)
                                        .ToList();
                                }
                                @if (directGuestsByInvitation?.Any() == true)
                                {
                                    @foreach (var group in directGuestsByInvitation)
                                    {
                                        var firstGuest = group.First();
                                        <div class="card mb-1">
                                            <div class="card-body p-2 p-sm-3">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <h6 class="fw-bold mb-0 small">@firstGuest.Invitation!.Name</h6>
                                                </div>
                                                @foreach (var guest in group)
                                                {
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <small>@guest.GuestName</small>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- Paginación -->
        <div class="d-flex justify-content-center my-3 d-none">
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPageAsync" />

        </div>

    </div>

}

<style>
    .mesa-card {
        transition: .2s;
    }

        .mesa-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,.10);
        }

    .btn-circle {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>