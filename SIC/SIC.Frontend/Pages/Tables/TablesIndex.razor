@page "/events/tables/{Code}"
@using SIC.Frontend.Shared
<PageTitle>Mesas del Evento</PageTitle>
@if (Tables is null)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-custom mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <div class="text-muted">Cargando mesas...</div>
        </div>
    </div>
}
else
{
    <div class="container-fluid p-0 p-md-4">

    <div class="col-6 col-sm-3 col-md-2 text-start">
        @if (!string.IsNullOrWhiteSpace(eventName))
        {
            <h3>@eventName</h3>
        }
    </div>

    <!-- Encabezado -->
        <div class="row align-items-center mb-4 mt-4 g-3">
        <div class="col-12 col-sm-6 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text"
                class="form-control"
                placeholder="Buscar por mesa o nombre de invitado..." />
            </div>
        </div>

        <div class="col-6 col-sm-3 col-md-2 text-center text-sm-start text-md-center">
            <h5 class="mb-0 d-flex align-items-center justify-content-center justify-content-sm-start justify-content-md-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3C6A79" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-tools-kitchen-2 flex-shrink-0"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M19 3v12h-5c-.023 -3.681 .184 -7.406 5 -12m0 12v6h-1v-3m-10 -14v17m-3 -17v3a3 3 0 1 0 6 0v-3" /></svg>
                <span class="">Mis mesas</span>
            </h5>
        </div>

        <div class="col-12">
            <div class="row g-1 text-center">

                <div class="col">
                    <h5 class="fw-bold mb-0">@totalTables</h5>
                    <small class="text-muted">Total</small>
                </div>

                <div class="col">
                    <h5 class="fw-bold mb-0">@totalSeats</h5>
                    <small class="text-muted">Lugares</small>
                </div>

                <div class="col">
                    <h5 class="fw-bold mb-0">@availableSeats</h5>
                    <small class="text-muted">Disponibles</small>
                </div>

                <div class="col">
                    <h5 class="fw-bold mb-0">@occupiedSeats</h5>
                    <small class="text-muted">Ocupados</small>
                </div>

            </div>
        </div>

        <div class="col-12 col-sm-3 col-md-2 text-center text-sm-end">
            <div class="d-flex gap-1 justify-content-end justify-content-sm-end">
                <button class="btn btn-sm btn-custom" @onclick="GeneratePdfAsync" disabled="@(isGeneratingPdf || IsBusy)">
                    @if (isGeneratingPdf)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-pdf"></i>
                    }
                    <span class="">PDF</span>
                </button>
                <button class="btn btn-sm btn-custom" @onclick="() => ShowModaCrearMesa()" disabled="@IsBusy">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M9 12h6" />
                        <path d="M12 9v6" />
                        <path d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14" />
                    </svg>
                    <span class="">Mesa</span>
                </button>
                <button class="btn btn-sm btn-custom" @onclick="() => ModaGenerarMesa()" disabled="@IsBusy">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M7 5.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667l0 -8.666" />
                        <path d="M4.012 7.26a2.005 2.005 0 0 0 -1.012 1.737v10c0 1.1 .9 2 2 2h10c.75 0 1.158 -.385 1.5 -1" />
                        <path d="M11 10h6" />
                        <path d="M14 7v6" />
                    </svg>
                    <span class="">Mesas</span>
                </button>
            </div>
        </div>

    </div>

    <!-- Tarjetas -->
    <div class="position-relative">
    <div class="row g-4">

        @foreach (var mesa in Tables)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                <div class="card mesa-card h-100" style="border: 2px solid #3C6A79; border-radius: 15px;">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start">

                            <small class="text-muted">
                                @mesa.Description
                            </small>

                            <div class="d-flex">
                                <button class="btn btn-sm btn-custom rounded-circle me-1 btn-circle"
                                        @onclick="() => ShowModaEditaMesa(mesa)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>

                                <button class="btn btn-sm btn-custom rounded-circle btn-circle" @onclick="() => ConfirmDelete(mesa)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M4 7l16 0" />
                                        <path d="M10 11l0 6" />
                                        <path d="M14 11l0 6" />
                                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                    </svg>
                                </button>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="fw-bold mt-2" style="font-size: 1.8rem;">
                                Mesa: @mesa.Name
                            </h3>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @GetTableStatusClass(mesa)">@GetTableStatusLabel(mesa)</span>
                                <button class="btn btn-sm btn-custom rounded-circle me-1 btn-circle" @onclick="() => ModaAsignarMes(mesa)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" 
                                    viewBox="0 0 24 24" fill="none" stroke="currentColor" 
                                    stroke-width="1.5" stroke-linecap="round" 
                                    stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-square-plus">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M9 12h6" />
                                        <path d="M12 9v6" />
                                        <path d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Progress bar -->
                        <div class="mb-3 mt-2">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="fw-semibold">@mesa.OccupiedSeats / @mesa.Seats lugares</small>
                                <small class="text-muted">@(mesa.Seats > 0 ? (int)((double)mesa.OccupiedSeats / mesa.Seats * 100) : 0)%</small>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @GetTableStatusClass(mesa)"
                                     style="width: @(mesa.Seats > 0 ? Math.Min((double)mesa.OccupiedSeats / mesa.Seats * 100, 100) : 0)%">
                                </div>
                            </div>
                            <small class="text-muted">@(mesa.Seats - mesa.OccupiedSeats) lugares disponibles</small>
                        </div>

                        <div class="mt-1" style="max-height: 300px; overflow-y: auto;">

                            @foreach (var invitacion in mesa.Invitations)
                            {
                                <div class="card mb-1">
                                    <div class="card-body p-2 p-sm-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="fw-bold mb-0 small">
                                                @invitacion.Name
                                            </h6>

                                            <button class="btn btn-sm btn-custom rounded-circle btn-circle" @onclick="() => ConfirmDeleteAssign(invitacion)">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     width="14"
                                                     height="14"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="1.5"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M4 7l16 0" />
                                                    <path d="M10 11l0 6" />
                                                    <path d="M14 11l0 6" />
                                                    <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                                    <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                                </svg>
                                            </button>
                                        </div>

                                        @if (invitacion.Guests?.Any() == true)
                                        {
                                            @foreach (var guest in invitacion.Guests.Where(g => g.Status == Status.Attend && (g.TablesEventsId == null || g.TablesEventsId == mesa.Id)))
                                            {
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small>@guest.GuestName</small>
                                                    @if (guest.TablesEventsId.HasValue)
                                                    {
                                                        <div class="d-flex align-items-center gap-1">
                                                            <small class="badge bg-info text-white" style="font-size:0.6rem;">Individual</small>
                                                            <button class="btn btn-sm btn-outline-danger rounded-circle"
                                                                    style="width:22px;height:22px;padding:0;font-size:0.6rem;"
                                                                    @onclick="() => UnassignGuest(guest)">
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <small class="badge bg-secondary" style="font-size:0.6rem;">Invitacion</small>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <small class="text-muted small">
                                                Sin invitados confirmados
                                            </small>
                                        }

                                    </div>
                                </div>
                            }

                            @{
                                var directGuestsByInvitation = mesa.Guests?
                                    .Where(g => g.TablesEventsId == mesa.Id && g.Status == Status.Attend && g.Invitation != null && !mesa.Invitations.Any(i => i.Id == g.InvitationId))
                                    .GroupBy(g => g.InvitationId)
                                    .ToList();
                            }
                            @if (directGuestsByInvitation?.Any() == true)
                            {
                                @foreach (var group in directGuestsByInvitation)
                                {
                                    var firstGuest = group.First();
                                    <div class="card mb-1">
                                        <div class="card-body p-2 p-sm-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <h6 class="fw-bold mb-0 small">
                                                    @firstGuest.Invitation!.Name
                                                </h6>
                                            </div>

                                            @foreach (var guest in group)
                                            {
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <small>@guest.GuestName</small>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <small class="badge bg-info text-white" style="font-size:0.6rem;">Individual</small>
                                                        <button class="btn btn-sm btn-outline-danger rounded-circle"
                                                                style="width:22px;height:22px;padding:0;font-size:0.6rem;"
                                                                @onclick="() => UnassignGuest(guest)">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (IsBusy)
    {
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
             style="background: rgba(255,255,255,0.7); z-index: 1050; border-radius: 15px;">
            <div class="text-center">
                <div class="spinner-border text-custom mb-2" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Actualizando...</span>
                </div>
                <div class="text-muted">@busyMessage</div>
            </div>
        </div>
    }
    </div>

    <!-- Paginación -->
    <div class="d-flex justify-content-center my-3 d-none">
        <Pagination CurrentPage="currentPage"
        TotalPages="totalPages"
        SelectedPage="SelectedPageAsync" />

    </div>

</div>
    
}


@if (modaCrearOrEditaMesa)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <EditForm Model="@createOrEditTablesDto" OnValidSubmit="@SaveMesa">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Crear Mesa
                    </h5>
                        <button type="button" class="btn-close" @onclick="CloseModaCrearOrEditaMesa"></button>
                </div>
                <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Mesa</label>
                            <InputText class="form-control" @bind-Value="createOrEditTablesDto.Name" />
                            <ValidationMessage For="@(() => createOrEditTablesDto.Name)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripcion</label>
                            <InputText class="form-control" @bind-Value="createOrEditTablesDto.Description" />
                            <ValidationMessage For="@(() => createOrEditTablesDto.Description)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Lugares</label>
                            <InputNumber class="form-control" @bind-Value="createOrEditTablesDto.Seats" />
                            <ValidationMessage For="@(() => createOrEditTablesDto.Seats)" />
                        </div>
                </div>
                <div class="modal-footer">

                        <button type="submit" class="btn btn-custom">Asignar</button>
                        <button type="button" class="btn btn-secondary" @onclick="CloseModaCrearOrEditaMesa">
                        Cerrar
                    </button>
                </div>
            </div>
                    </EditForm>
        </div>
    </div>
    
}
@if (modaAsignarMesa && Table != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Asignar a mesa: @Table.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseModaAsignarMesa"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(asignacionModo == "herencia" ? "active" : "")"
                                    @onclick='() => asignacionModo = "herencia"'>Invitacion</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(asignacionModo == "individual" ? "active" : "")"
                                    @onclick='() => asignacionModo = "individual"'>Individual</button>
                        </li>
                    </ul>

                    @if (asignacionModo == "herencia")
                    {
                        <div class="mb-2 d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                Disponibles: @(Table.Seats - Table.OccupiedSeats) lugares
                            </small>
                            <small class="text-muted">Seleccionados: @selectedInvitationIds.Count</small>
                        </div>
                        <input type="text" class="form-control mb-2"
                                placeholder="Filtrar invitacion..."
                                @bind="filterText"
                                @bind:event="oninput" />
                        <div style="max-height: 300px; overflow-y: auto;">
                            @foreach (var inv in FilteredInvitation)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                            checked="@(selectedInvitationIds.Contains(inv.Id))"
                                            @onchange="() => ToggleInvitationSelection(inv.Id)" />
                                    <label class="form-check-label">
                                        @inv.Name
                                        <small class="text-muted">
                                            - Confirmados: @(inv.Guests?.Count(g => g.Status == Status.Attend) ?? 0)
                                        </small>
                                    </label>
                                </div>
                            }
                            @if (!FilteredInvitation.Any())
                            {
                                <small class="text-muted d-block text-center py-2">No hay invitaciones disponibles</small>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mb-2 d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                Disponibles: @(Table.Seats - Table.OccupiedSeats) lugares
                            </small>
                            <small class="text-muted">Seleccionados: @selectedGuestIds.Count</small>
                        </div>
                        <input type="text" class="form-control mb-2"
                                placeholder="Filtrar invitado..."
                                @bind="filterGuestText"
                                @bind:event="oninput" />
                        <div style="max-height: 300px; overflow-y: auto;">
                            @{
                                var groupedGuests = FilteredGuestsForAssignment
                                    .GroupBy(g => g.InvitationId)
                                    .Select(g => new
                                    {
                                        InvitationName = invitationsById.TryGetValue(g.Key, out var inv) ? inv.Name : "Sin invitacion",
                                        Guests = g
                                    })
                                    .OrderBy(g => g.InvitationName);
                            }
                            @foreach (var group in groupedGuests)
                            {
                                <div class="card mb-2">
                                    <div class="card-body p-2">
                                        <h6 class="fw-bold mb-2 small">@group.InvitationName</h6>
                                        @foreach (var guest in group.Guests)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                        checked="@(selectedGuestIds.Contains(guest.Id))"
                                                        @onchange="() => ToggleGuestSelection(guest.Id)" />
                                                <label class="form-check-label">
                                                    @guest.GuestName
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!groupedGuests.Any())
                            {
                                <small class="text-muted d-block text-center py-2">No hay invitados disponibles</small>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-custom" disabled="@(asignacionModo == "herencia" ? selectedInvitationIds.Count == 0 : selectedGuestIds.Count == 0)" @onclick="AssignTable">
                        Asignar@(asignacionModo == "herencia"
                            ? (selectedInvitationIds.Count > 0 ? $" ({selectedInvitationIds.Count})" : "")
                            : (selectedGuestIds.Count > 0 ? $" ({selectedGuestIds.Count})" : ""))
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseModaAsignarMesa">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}
@if (modaGenerarMesa)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <EditForm Model="@GenerateTablesDto" OnValidSubmit="@GenerarMesa">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            Generar Mesas
                        </h5>
                        <button type="button" class="btn-close" @onclick="CloseModaGenerarMesa"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Cantidad de Mesas</label>
                            <InputNumber class="form-control" @bind-Value="GenerateTablesDto.NumbersTables" />
                            <ValidationMessage For="@(() => GenerateTablesDto.NumbersTables)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Lugares en cada mesa</label>
                            <InputNumber class="form-control" @bind-Value="GenerateTablesDto.NumberOfSeats" />
                            <ValidationMessage For="@(() => GenerateTablesDto.NumberOfSeats)" />
                        </div>
                    </div>
                    <div class="modal-footer">

                        <button type="submit" class="btn btn-custom">Generar</button>
                        <button type="button" class="btn btn-secondary" @onclick="CloseModaGenerarMesa">
                            Cerrar
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

}




<style>
    .mesa-card {
        transition: .2s;
    }

        .mesa-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,.10);
        }

    .btn-circle {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>