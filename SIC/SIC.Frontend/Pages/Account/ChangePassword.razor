@page "/change-password"

<PageTitle>Cambiar Contraseña</PageTitle>

<div class="container py-4">
    <PageHeader Icon="bi-shield-lock" Title="Cambiar Contraseña" Subtitle="Actualiza la contraseña de tu cuenta." />
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 520px; margin: 0 auto;">
        <div class="card-body p-4 p-lg-5">
            <EditForm Model="ChangePasswordModel" OnValidSubmit="ChangePasswordAsync">
                <DataAnnotationsValidator />

                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold">Contraseña actual</label>
                    <div class="input-group">
                        <input type="@CurrentPasswordInputType" class="form-control form-control-lg rounded-start-3" @bind="ChangePasswordModel.CurrentPassword" @bind:event="oninput" placeholder="Ingresa tu contraseña actual" />
                        <button type="button" class="btn btn-outline-secondary rounded-end-3" @onclick="ToggleCurrentPassword">
                            <i class="bi @(ShowCurrentPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => ChangePasswordModel.CurrentPassword)" />
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label fw-semibold">Contraseña nueva</label>
                    <div class="input-group">
                        <input type="@NewPasswordInputType" class="form-control form-control-lg rounded-start-3" @bind="ChangePasswordModel.NewPassword" @bind:event="oninput" placeholder="Mínimo 6 caracteres" />
                        <button type="button" class="btn btn-outline-secondary rounded-end-3" @onclick="ToggleNewPassword">
                            <i class="bi @(ShowNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => ChangePasswordModel.NewPassword)" />
                    @if (NewPasswordTooShort)
                    {
                        <div class="text-muted small">La contraseña debe tener al menos 6 caracteres.</div>
                    }
                </div>

                <div class="mb-4 text-start">
                    <label class="form-label fw-semibold">Confirmar contraseña nueva</label>
                    <div class="input-group">
                        <input type="@ConfirmPasswordInputType" class="@ConfirmPasswordInputClass" @bind="ConfirmPassword" @bind:event="oninput" placeholder="Repite la contraseña nueva" />
                        <button type="button" class="btn btn-outline-secondary rounded-end-3" @onclick="ToggleConfirmPassword">
                            <i class="bi @(ShowConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                    @if (ConfirmPasswordMismatch)
                    {
                        <div class="invalid-feedback">La contraseña nueva y su confirmación no coinciden.</div>
                    }
                </div>

                <button class="btn btn-primary w-100 py-2 rounded-3 fw-semibold" type="submit" disabled="@(!CanChangePassword)">
                    Cambiar Contraseña
                </button>
            </EditForm>
        </div>
    </div>
</div>
