@page "/event-requirements/available"
<PageTitle>Catálogo de Requisitos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
<h3>Requisitos Disponibles</h3>
    <button class="btn btn-custom" @onclick="ShowCreateModal">
        <i class="oi oi-plus"></i> Crear Requisito
    </button> 
</div>

<GenericList MyList="Requirements">
    <Body>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#3C6A79; color:white;">
                    <tr class="text-center">
                        <th>Nombre</th>
                        <th>Sección</th>
                        <th>Tipo</th>
                        <th>Obligatorio</th>
                        <th>Activo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Requirements!)
                    {
                        <tr>
                            <td>@req.Name</td>
                            <td>@req.Section</td>
                            <td>@req.InputType.GetDescription()</td>
                            <td class="text-center">
                                @if (req.IsRequired)
                                {
                                    <span class="badge bg-danger">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (req.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-custom me-1" @onclick="() => ShowEditModal(req)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button class="btn btn-sm btn-custom" @onclick="() => ConfirmDelete(req)">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Body>
</GenericList>

@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsEditMode ? "Editar Requisito" : "Crear Requisito")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewRequirement" OnValidSubmit="@SaveRequirement">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Nombre</label>
                                    <InputText class="form-control" @bind-Value="NewRequirement.Name" />
                                    <ValidationMessage For="@(() => NewRequirement.Name)" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Sección</label>
                                    <InputText class="form-control" @bind-Value="NewRequirement.Section" placeholder="Ej. Información General" />
                                    <ValidationMessage For="@(() => NewRequirement.Section)" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <InputTextArea class="form-control" @bind-Value="NewRequirement.Description" />
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Tipo de Entrada</label>
                                    <InputSelect class="form-select" @bind-Value="NewRequirement.InputType">
                                        @foreach (var type in Enum.GetValues<RequirementInputType>())
                                        {
                                            <option value="@type">@type.GetDescription()</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Orden</label>
                                    <InputNumber class="form-control" @bind-Value="NewRequirement.SortOrder" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Placeholder</label>
                                    <InputText class="form-control" @bind-Value="NewRequirement.Placeholder" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3 form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="NewRequirement.IsRequired" />
                                    <label class="form-check-label">Obligatorio</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3 form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="NewRequirement.IsActive" />
                                    <label class="form-check-label">Activo</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">Min. Imágenes</label>
                                    <InputNumber class="form-control" @bind-Value="NewRequirement.MinImages" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">Max. Imágenes</label>
                                    <InputNumber class="form-control" @bind-Value="NewRequirement.MaxImages" />
                                </div>
                            </div>
                        </div>

                        @if (NewRequirement.InputType == RequirementInputType.ImagenConTitulo)
                        {
                            <hr />
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label fw-semibold mb-0">
                                        Opciones de Imagen / Título
                                        <small class="text-muted d-block fw-normal">El usuario deberá elegir una de las siguientes imágenes.</small>
                                    </label>
                                    <button type="button" class="btn btn-sm btn-custom" @onclick="AddImageOption">
                                        <i class="bi bi-plus-lg"></i> Agregar Opción
                                    </button>
                                </div>

                                @if (ImageOptions.Count == 0)
                                {
                                    <div class="text-muted border rounded p-3 text-center">
                                        No hay opciones configuradas. Haz clic en "Agregar Opción".
                                    </div>
                                }

                                @for (int i = 0; i < ImageOptions.Count; i++)
                                {
                                    var optionIndex = i;
                                    var previewUrl = ImageOptions[optionIndex].ImageUrl;
                                    var hasLocalFile = IsOptionImageLocal(optionIndex);

                                    <div class="border rounded p-2 mb-2 d-flex align-items-center gap-3">
                                        <div class="text-center flex-shrink-0">
                                            @if (!string.IsNullOrEmpty(previewUrl))
                                            {
                                                <img src="@previewUrl" alt="Vista previa" style="max-height:70px; max-width:90px; border-radius:6px;" class="border" />
                                            }
                                            else
                                            {
                                                <div class="border rounded d-flex align-items-center justify-content-center text-muted"
                                                     style="height:70px; width:90px;">
                                                    Sin imagen
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <InputFile class="form-control form-control-sm mb-1"
                                                       accept="image/*"
                                                       OnChange="e => HandleOptionImageUpload(optionIndex, e)" />
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Título de la opción"
                                                   value="@ImageOptions[optionIndex].Title"
                                                   @onchange="e => UpdateOptionTitle(optionIndex, e.Value?.ToString())" />
                                            @if (hasLocalFile)
                                            {
                                                <small class="text-muted">Archivo pendiente por subir</small>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger flex-shrink-0"
                                                @onclick="() => RemoveImageOption(optionIndex)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            <hr />
                        }

                        @if (NewRequirement.InputType == RequirementInputType.Button)
                        {
                            <hr />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Nombre del Botón</label>
                                        <InputText class="form-control" @bind-Value="NewRequirement.ButtonName" placeholder="Ej. Ver Catálogo" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">URL</label>
                                        <InputText class="form-control" @bind-Value="NewRequirement.ButtonUrl" placeholder="https://..." />
                                        <small class="text-muted">El botón abrirá este enlace en una pestaña nueva.</small>
                                    </div>
                                </div>
                            </div>
                            <hr />
                        }

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom" disabled="@Saving">
                                @if (Saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Guardar
                            </button>
                            <button type="button" class="btn btn-secondary" disabled="@Saving" @onclick="CloseModal">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
