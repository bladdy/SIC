@page "/event-requirements"
<PageTitle>Requisitos por Tipo de Evento</PageTitle>
<h3>Requisitos por Tipo de Evento</h3>

<p class="text-muted">Administra los requisitos (formulario dinámico) que cada tipo de evento necesita del cliente.</p>

<GenericList MyList="EventTypes">
    <Body>
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#3C6A79; color:white;">
                    <tr class="text-center">
                        <th class="text-start">Tipo de Evento</th>
                        <th>Cantidad de Requisitos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (EventTypes != null)
                    {
                        @foreach (var eventType in EventTypes)
                        {
                            var count = RequirementCounts.GetValueOrDefault(eventType.Id, 0);
                            <tr>
                                <td class="fw-semibold">@eventType.Name</td>
                                <td class="text-center">
                                    <span class="badge" style="background:#3C6A79;">@count requisito(s)</span>
                                </td>
                                <td class="text-center">
                                    <a href="/event-requirements/@eventType.Id" class="btn btn-sm btn-custom">
                                        <i class="bi bi-gear-fill"></i> Gestionar Requisitos
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-block d-md-none">
            @if (EventTypes != null)
            {
                @foreach (var eventType in EventTypes)
                {
                    var count = RequirementCounts.GetValueOrDefault(eventType.Id, 0);
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title fw-bold mb-1">@eventType.Name</h6>
                                <span class="badge bg-info">@count requisito(s)</span>
                            </div>
                            <a href="/event-requirements/@eventType.Id" class="btn btn-sm btn-custom">
                                <i class="bi bi-gear-fill"></i> Gestionar
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </Body>
</GenericList>
