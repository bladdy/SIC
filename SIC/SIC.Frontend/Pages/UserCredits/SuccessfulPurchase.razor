@page "/successful-Purchase"
@inject NavigationManager NavigationManager

<PageTitle>Comprar Exitosa</PageTitle>
<div style="
    max-width:700px;
    margin:80px auto;
    padding:50px 40px;
    text-align:center;
    background:#ffffff;
    border:3px solid #367B82;
    border-radius:20px;
    box-shadow:0 10px 25px rgba(0,0,0,.08);">

    <div class="d-flex justify-content-start mb-3">
        <VolverButton />
    </div>

    <div style="
        width:90px;
        height:90px;
        margin:0 auto 25px auto;
        border-radius:50%;
        background:#E8F5EE;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:45px;">
        ✅
    </div>

    <h2 style="
        color:#367B82;
        font-weight:700;
        margin-bottom:20px;
        text-transform:uppercase;">
        ¡Compra Exitosa!
    </h2>

    <p style="
        font-size:18px;
        color:#7A858E;
        line-height:1.7;
        margin-bottom:15px;">
        Gracias por tu compra.
    </p>

    <p style="
        font-size:16px;
        color:#7A858E;
        line-height:1.7;
        margin-bottom:35px;">
        Tus créditos han sido acreditados correctamente en tu cuenta y ya están disponibles para ser utilizados en tus próximos eventos.
    </p>

    <button class="btn btn-primary" @onclick="goToHome">
        Volver al inicio
    </button>

</div>

@code {
    private void goToHome()
    {
        NavigationManager.NavigateTo("/");
    }
}
