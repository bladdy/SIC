@page "/users-credits"
@using SIC.Frontend.Shared.Component.Modals
<PageTitle>Usuarios</PageTitle>
<span>
    <button class="btn btn-custom float-end" @onclick="() => OpenModal()"><i class="oi oi-plus"></i>Nuevo Credito</button>
</span>
<div class="mb-2" style="display: flex; flex-wrap:wrap; align-items: center;">
    <div>
        <input style="width: 400px;" type="text" class="form-control" id="titulo" placeholder="Buscar usuario..." />
    </div>
    <div class="mx-1">
        <button type="button" class="btn btn-custom" @onclick="ApplyFilterAsync"><i class="oi oi-layers" /> Filtrar</button>
        <button type="button" class="btn btn-custom" @onclick="CleanFilterAsync"><i class="oi oi-ban" /> Limpiar</button>
    </div>
</div>
<AddCreditModal @ref="addCreditModal" OnCreditsAdded="RefreshCreditsList" />

<GenericList MyList="UserCredits">
    <Body>
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="" style="background-color:#3C6A79; color: white;">
                <tr class="text-center">
                    <th>Usuario</th>
                    <th>Creditos</th>
                    <th>Consumidos</th>
                    <th>Pendiente</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (UserCredits is null)
                {
                    <Loading />
                }
                else
                {
                    @foreach (var user in UserCredits)
                    {
                        <tr class="text-center">

                            <td>@user.FullName</td>
                            <td>@user.AvailableCredits</td>
                            <td>@user.ConsumedCredits</td>
                            <td>@user.PendingCredits</td>
                            <td>@user.TotalCredits</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-custom me-2" @onclick="() => OpenModal(user)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-credit-card-pay"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 19h-6a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v4.5" /><path d="M3 10h18" /><path d="M16 19h6" /><path d="M19 16l3 3l-3 3" /><path d="M7.005 15h.005" /><path d="M11 15h2" /></svg>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-center my-3">
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPage" />

        </div>

    </Body>
</GenericList>