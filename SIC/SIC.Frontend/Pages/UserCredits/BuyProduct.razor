@page "/buy-product"
@inject NavigationManager NavigationManager

<div class="container py-5">

    <div class="text-center mb-5">
        <h3 class="page-title">
            PAQUETES DE ACUERDO A TUS NECESIDADES
        </h3>
    </div>

    <div class="row justify-content-center g-4">

        @if (StrpeProducts != null)
        {
            @foreach (var product in StrpeProducts)
            {
                <div class="col-12 col-sm-10 col-md-6 col-lg-4 d-flex justify-content-center">

                    <div class="package-card">

                        <div class="text-center mb-3">
                            <img src="@product.URLImagen"
                                 alt="@product.Name"
                                 class="package-image" />
                        </div>

                        <h4 class="package-title">
                            @product.Name
                        </h4>

                        <div class="flex-grow-1">
                            @foreach (var item in product.Items)
                            {
                                <div class="package-item">
                                    @item
                                </div>
                            }
                        </div>

                        <button class="btn btn-custom btn-lg mt-4 w-100"
                                @onclick="() => Pay(product.Id)">
                            @product.PriceTotal.ToString("$#,##0")
                            / @product.Amount CRÉDITO
                        </button>

                    </div>

                </div>
            }
        }
        else
        {
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-12 col-sm-10 col-md-6 col-lg-4 d-flex justify-content-center">

                    <div class="package-card">

                        <div class="skeleton skeleton-image"></div>

                        <div class="skeleton skeleton-title"></div>

                        <div class="skeleton skeleton-line"></div>
                        <div class="skeleton skeleton-line"></div>
                        <div class="skeleton skeleton-line"></div>
                        <div class="skeleton skeleton-line"></div>

                        <div class="skeleton skeleton-button"></div>

                    </div>

                </div>
            }
        }

    </div>

    <div class="text-center mt-5">

        <p class="info-text">
            Antes de comprar te recomendamos dar clic en el botón y leer todo el contenido para que estés informado de cómo funcionan los créditos y los eventos.
        </p>

        <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mt-4">
            <button class="btn btn-custom"
                    @onclick="goToPurchasingPolicy">
                POLÍTICAS DE COMPRA
            </button>

            <button class="btn btn-custom"
                    @onclick="goToTermsConditions">
                TÉRMINOS Y CONDICIONES
            </button>
        </div>

    </div>

</div>

<style>
    .page-title {
        text-transform: uppercase;
        font-weight: bold;
        color: #3f6d78;
    }

    .package-card {
        border: 4px solid #3f6d78;
        border-radius: 20px;
        padding: 30px 20px;
        background: white;
        width: 100%;
        max-width: 400px;
        min-height: 600px;
        display: flex;
        flex-direction: column;
    }

    .package-image {
        width: 180px;
        max-width: 100%;
        height: auto;
    }

    .package-title {
        color: #3f6d78;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 20px;
        text-align: center;
    }

    .package-item {
        border-bottom: 2px solid #3C6A79;
        padding: 12px;
        text-align: center;
    }

    .info-text {
        max-width: 800px;
        margin: auto;
        color: #3C6A79;
    }

    /* Skeleton Loading */
    .skeleton {
        background: linear-gradient( 90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75% );
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: 8px;
    }

    .skeleton-image {
        height: 150px;
        margin-bottom: 20px;
    }

    .skeleton-title {
        height: 30px;
        margin-bottom: 20px;
    }

    .skeleton-line {
        height: 20px;
        margin-bottom: 15px;
    }

    .skeleton-button {
        height: 50px;
        margin-top: 30px;
    }

    @@keyframes loading {
        0%

    {
        background-position: 200% 0;
    }

    100% {
        background-position: -200% 0;
    }

    }

    /* Mobile */
    @@media (max-width: 768px) {
        .package-card

    {
        min-height: auto;
        padding: 25px 15px;
    }

    .package-title {
        font-size: 1.2rem;
    }

    .package-image {
        width: 140px;
    }

    .btn-custom {
        width: 100%;
    }

    }
</style>