@page "/buy-product"
@inject NavigationManager NavigationManager
<div class="container py-5">

    <div class="text-center mb-4">
        <h3 style="text-transform: uppercase; font-weight: bold; color: #3f6d78;">
            PAQUETES DE ACUERDO A TUS NECESIDADES
        </h3>
    </div>
    <div class="row justify-content-center mt-5">
        @if (StrpeProducts != null)
        {

            @foreach (var products in StrpeProducts!)
            {
                <!-- Card 1 -->
                <div class="col-lg-4 col-md-6 mb-4">

                    <div style="
                    border:4px solid #3f6d78;
                    border-radius:20px;
                    padding:35px 25px;
                    text-align:center;
                    height:600px;
                    width:400px;
                    background:white;">

                        <div style="font-size:60px; margin-bottom:20px;">
                            @if (@products.Description.Substring(0, 1) =="1")
                            {
                                <img src="credit1.png" alt="Logo" class="mb-3" style="width: 200px; height: auto;" />
                            }
                            @if (@products.Description.Substring(0, 1) == "3")
                            {
                                <img src="credit2.png" alt="Logo" class="mb-3" style="width: 200px; height: auto;" />
                            }
                            @if (@products.Description.Substring(0, 1) == "5")
                            {
                                <img src="credit3.png" alt="Logo" class="mb-3" style="width: 200px; height: auto;" />
                                
                            }
                        </div>

                    <h4 style="
                        color:#3f6d78;
                        font-weight:bold;
                        text-transform:uppercase;
                        margin-bottom:30px;">
                        @products.Name
                    </h4>

                    <div style="border-bottom:2px solid #3C6A79; padding:10px;">
                            Crear @products.Description.Substring(0, 1) evento
                    </div>

                    <div style="border-bottom:2px solid #3C6A79; padding:10px;">
                        Subir lista de invitados en la app
                    </div>

                    <div style="border-bottom:2px solid #3C6A79; padding:10px;">
                        Crear plantillas para mensaje de envío
                    </div>
                    <div style="border-bottom:2px solid #3C6A79; padding:10px;">
                        Enviar invitaciones masivas
                    </div>

                    <div style="padding:10px;">
                       Lista de asistentes en PDF
                    </div>

                        <button style="margin-top:35px;" class="btn btn-custom btn-lg"
                                @onclick="() => Pay(products.DefaultPrice!.Id)">
                            @((products.DefaultPrice.UnitAmount / 100m)
                                .ToString("$#,##0")) / @products.Description.Substring(0, 1) CREDITO
                    </button>
                    <!--

                        <div style="margin-top:35px;">
                            <button class="btn btn-custom btn-lg">
                                $997 / 1 CREDITO
                            </button>
                        </div>

                    -->
                </div>

            </div>
            
        }

        }
