@page "/events/message-events/{Code}"
<PageTitle>Mensajes del evento</PageTitle>
<div class="d-flex justify-content-center my-4 px-3">
    @if (NewMessage != null)
    {
        <EditForm Model="@NewMessage" OnValidSubmit="HandleValidSubmit" class="w-100">
            <h3>Datos del Evento</h3>
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3 row">
                <div class="form-group col-12 col-md-6 d-flex align-items-center">
                    <h5>Codigo: </h5>
                    <h5 class="ms-2">@Code</h5>
                </div>
            </div>

            <div class="mb-3 row">
                <div class="form-group col-12 col-md-6 mb-3 mb-md-0">
                    <label for="titulo" class="form-label">Título:</label>
                    <InputText id="titulo" class="form-control" @bind-Value="NewMessage!.Title" />
                </div>

                <div class="form-group col-12 col-md-6">
                    <label for="subtitulo" class="form-label">Subtítulo:</label>
                    <InputText id="subtitulo" class="form-control" @bind-Value="NewMessage.SubTitle" />
                </div>
            </div>

            <h3>Mensajes para WhatsApp</h3>
            <div class="mb-3 row">
                <div class="form-group col-12 col-md-4 mb-3 mb-md-0">
                    <label for="textoInvitacion" class="form-label">Texto de invitación:</label>
                    <InputTextArea id="textoInvitacion" class="form-control" @bind-Value="NewMessage.MessageInvitation" style="height: 25em;" />
                </div>

                <div class="form-group col-12 col-md-4">
                    <label for="mensajeConfirmacion" class="form-label">Mensaje de confirmación:</label>
                    <InputTextArea id="mensajeConfirmacion" class="form-control" @bind-Value="NewMessage.MessageConfirmation" style="height: 25em;" />
                </div>
                <div class="form-group col-12 col-md-4">
                    <h3>Tokens que puede usar en mensajes:</h3>
                    <div class="token-list">

                        <h5>👤 Información del Invitado</h5>
                        <ul>
                            <li><strong>{nombre_invitacion}</strong> - Nombre del invitado.</li>
                        </ul>

                        <h5>👥 Invitados Asignados</h5>
                        <ul>
                            <li><strong>{numero_de_lugares}</strong> - Cantidad de adultos invitados.</li>
                            <li><strong>{invitados_menores}</strong> - Cantidad de niños invitados.</li>
                            <li><strong>{numberYouths}</strong> - Cantidad de jóvenes invitados.</li>
                            <li><strong>{totalInvitados}</strong> - Total de personas invitadas (adultos + jóvenes + niños).</li>
                        </ul>

                        <h5>✅ Confirmación de asistencia</h5>
                        <ul>
                            <li><strong>{NumberConfirmedAdults}</strong> - Número de adultos confirmados.</li>
                            <li><strong>{NumberConfirmedChildren}</strong> - Número de niños confirmados.</li>
                            <li><strong>{numberConfirmedYouths}</strong> - Número de jóvenes confirmados.</li>
                        </ul>

                        <h5>🎉 Información del evento</h5>
                        <ul>
                            <li><strong>{evento_titulo}</strong> - Anfitrión(es).</li>
                            <li><strong>{evento_subtitulo}</strong> - Tipo de evento.</li>
                            <li><strong>{evento_fecha}</strong> - Fecha del evento.</li>
                        </ul>

                        <h5>🔗 Enlaces</h5>
                        <ul>
                            <li><strong>{linkinvitacion}</strong> - Enlace de la invitación.</li>
                            <li><strong>{linkconfirmacion}</strong> - Enlace para confirmar asistencia.</li>
                        </ul>

                        <h5>🪑 Asignación</h5>
                        <ul>
                            <li><strong>{mesa_asignada}</strong> - Mesa asignada al invitado.</li>
                        </ul>

                        <h5>✨ Formato</h5>
                        <p>
                            Para mostrar cualquier token en <strong>negritas</strong>, simplemente escríbelo entre llaves.
                        </p>

                        <div class="alert alert-light border">
                            <strong>Ejemplo:</strong><br />
                            <code>{nombre_invitacion}</code><br />
                            <code>{evento_titulo}</code><br />
                            <code>{totalInvitados}</code>
                        </div>

                    </div>

                </div>
            </div>


            <div class="form-group mt-3 d-flex justify-content-end gap-2 flex-wrap">
                <button type="submit" class="btn btn-custom" disabled="@(isLoading)">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Cargando... </span>
                    }
                    else
                    {
                        <span>Guardar Mensajes</span>
                    }
                </button>

                <button type="button" class="btn btn-secondary" @onclick="BackToEvent">
                    Cancelar
                </button>
            </div>

        </EditForm>
    }
    else
    {
        <p>Cargando datos...</p>
    }
</div>