@page "/events/register-event/invitations-entries/{Code}"
@*/events/register-intations-by-event/{Code}"*@
<PageTitle>Registro de invitaciones</PageTitle>

<h4 class="mb-2">Registro de Invitados</h4>
<div class="mb-2">
    <button class="btn btn-custom" @onclick="ShowCreateModal">
        Registrar Invitación (Escanear QR)
    </button>
</div>
@if (InvitationEntries is null)
{
    <div class="alert alert-info">Cargando Registro de Invitados...</div>
}
else
{
    ﻿﻿
    <!--<Filter PlaceHolder="Buscar Invitacion..." Callback=@FilterCallBack /> 25d366-->
    ﻿﻿<div class="mb-2" style="display: flex; flex-wrap:wrap; align-items: center;">
        <input style="width:400px;" type="text" class="form-control" placeholder="Buscar Invitacion..." @bind-value="Filter">
        <button type="button" class="btn btn-custom  mx-1" @onclick="ApplyFilterAsync"><i class="bi bi-funnel" /> Filtrar</button>
        <button type="button" class="btn btn-custom " @onclick="CleanFilterAsync"><i class="bi bi-x-circle" /> Limpiar</button>
    </div>

    <!-- ====== VERSIÓN DE ESCRITORIO ====== -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle mb-0">
            <thead style="background-color:#3C6A79; color:white;">
                <tr class="text-center">
                    <th class="text-start">Detalle del Invitado</th>
                    <th>Mesa</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (InvitationEntries != null && InvitationEntries.Any())
                {
                    @foreach (var invitation in InvitationEntries)
                    {
                        <tr class="border-top">
                            <!-- ======== COLUMNA 1: INFORMACIÓN GENERAL ======== -->
                            <td style="white-space: normal; vertical-align: top;">
                                <div class="container-fluid">
                                    <div class="row g-3 small text-secondary">

                                        <!-- ===== COLUMNA 1 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-column">
                                            <div>
                                                <strong>Código:</strong>
                                                <a style="color:#3C6A79; cursor:pointer;">
                                                    @invitation.Code
                                                </a>
                                            </div>
                                            <div><strong>Nombre:</strong> @invitation.Invitation?.Name</div>
                                            <div><strong>Móvil:</strong> @invitation.Invitation?.PhoneNumber</div>
                                        </div>

                                        <!-- ===== COLUMNA 2 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-column">
                                            <div><strong>Adultos:</strong> @invitation.Invitation?.NumberConfirmedAdults</div>
                                            <div><strong>Niños:</strong> @invitation.Invitation?.NumberConfirmedChildren</div>

                                        </div>

                                        <!-- ===== COLUMNA 3 ===== -->
                                        <div class="col-12 col-md-4 d-flex flex-column">
                                            <div><strong>Asist. Adultos:</strong> @invitation.AdultsEntered</div>
                                            <div><strong>Asist. Niños:</strong> @invitation.ChildrenEntered</div>
                                        </div>


                                    </div>
                                </div>
                            </td>

                            <!-- ======== COLUMNA 2: ESTADO ======== -->
                            <td class="text-center">
                                <span class="px-3 py-2 fs-6 badge bg-secondary">
                                    @invitation.Invitation?.Table
                                </span>
                            </td>

                            <!-- ======== COLUMNA 3: ACCIONES VACÍA PARA ALINEAR ======== -->
                            <td>
                                <button class="btn btn-custom" @onclick="() => ShowEditModal(invitation)">
                                    <i class="bi bi-pencil-fill"></i> Editar
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No hay invitados registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ✅ Vista móvil tipo “detalle” -->
    <div class="d-block d-md-none">
        @if (InvitationEntries != null && InvitationEntries.Any())
        {
            @foreach (var invitation in InvitationEntries)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title mb-0">@invitation.Invitation?.Name</h5>
                            <span class="badge bg-secondary">
                                @invitation.Invitation?.Table
                            </span>
                        </div>
                        <p class="mb-1"><strong>Código:</strong> @invitation.Code</p>
                        <p class="mb-1"><strong>Móvil:</strong> @invitation.Invitation?.PhoneNumber</p>
                        <p class="mb-1"><strong>Adultos:</strong> @invitation.Invitation?.NumberAdults (@invitation.AdultsEntered Asistentes)</p>
                        <p class="mb-1"><strong>Niños:</strong> @invitation.Invitation?.NumberChildren (@invitation.ChildrenEntered Asistentes)</p>

                    </div>
                </div>
            }
            
        }
        else
        {
            <div>
                <p class="text-center text-muted py-4">No hay invitados registrados.</p>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center my-3">
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    SelectedPage="SelectedPageAsync" />

    </div>
}
@if (IsModalEditVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Registrar Invitados
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">


                    <EditForm Model="@NewInvitationEntry" OnValidSubmit="@SaveInvitationEntry">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="row g-1 mb-2">
                            <div class="col-12 col-md-6 d-flex flex-column">
                                <div class="col-12 ">
                                    <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                        <strong>Estado:</strong>
                                        <span>@EditedInvitationEntry.Invitation?.Status.GetDescription()</span>
                                    </p>
                                </div>
                                <div class="col-12">
                                    <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                        <strong>Evento:</strong>
                                        <span>@EditedInvitationEntry.Invitation?.Event?.Name</span>
                                    </p>
                                </div>


                            </div>
                            <!-- Estado -->
                            <div class="col-12 col-md-6 d-flex flex-column">

                                <!-- Adutlos Confirmados -->
                                <div class="col-12">
                                    <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                        <strong>Adultos Confirmados:</strong>
                                        <span>@EditedInvitationEntry.Invitation?.NumberConfirmedAdults</span>
                                    </p>
                                </div>
                                <!-- Niños Confirmados -->
                                <div class="col-12">
                                    <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                        <strong>Niños Confirmados:</strong>
                                        <span>@EditedInvitationEntry.Invitation?.NumberConfirmedChildren</span>
                                    </p>
                                </div>
                            </div>
                            <div class="col-12 d-flex flex-column">
                                <!-- Nombres -->
                                <div class="col-12 ">
                                    <p class="d-flex justify-content-between align-items-center px-3 py-1 ">
                                        <strong>Nombres:</strong>
                                        <span>@EditedInvitationEntry.Invitation?.Name</span>
                                    </p>
                                </div>
                            </div>

                        </div>

                        <div class="mb-3">
                            <label class="form-label">Adultos Asistentes</label>
                            <InputNumber class="form-control" @bind-Value="EditedInvitationEntry.AdultsEntered" min="0" max="@Invitation?.NumberConfirmedAdults" />
                            <ValidationMessage For="@(() => EditedInvitationEntry.AdultsEntered)" />
                            <small class="text-muted">Máximo permitido: @EditedInvitationEntry.Invitation?.NumberConfirmedAdults</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Niños Asistentes</label>
                            <InputNumber class="form-control" @bind-Value="EditedInvitationEntry.ChildrenEntered" min="0" max="@Invitation?.NumberConfirmedChildren" />
                            <ValidationMessage For="@(() => EditedInvitationEntry.ChildrenEntered)" />
                            <small class="text-muted">Máximo permitido: @EditedInvitationEntry.Invitation?.NumberConfirmedChildren</small>
                        </div>
                    </EditForm>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-custom" @onclick="UpdateInvitationEntry">
                        Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
<!-- Modal-->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Registrar Invitados
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div id="reader" style="width:auto; height:100%;"></div>
                    @if (!isScannerRunning)
                    {
                        @if (Invitation is not null)
                        {
                            <div class="row g-1 mb-2">
                                <div class="col-12 col-md-6 d-flex flex-column">
                                    <div class="col-12 ">
                                        <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                            <strong>Estado:</strong>
                                            <span>@Invitation?.Status.GetDescription()</span>
                                        </p>
                                    </div>
                                    <div class="col-12">
                                        <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                            <strong>Evento:</strong>
                                            <span>@Invitation?.Event?.Name</span>
                                        </p>
                                    </div>


                                </div>
                                <!-- Estado -->
                                <div class="col-12 col-md-6 d-flex flex-column">

                                    <!-- Adutlos Confirmados -->
                                    <div class="col-12">
                                        <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                            <strong>Adultos Confirmados:</strong>
                                            <span>@Invitation?.NumberConfirmedAdults</span>
                                        </p>
                                    </div>
                                    <!-- Niños Confirmados -->
                                    <div class="col-12">
                                        <p class="d-flex justify-content-between align-items-center px-3 py-1">
                                            <strong>Niños Confirmados:</strong>
                                            <span>@Invitation?.NumberConfirmedChildren</span>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-12 d-flex flex-column">
                                    <!-- Nombres -->
                                    <div class="col-12 ">
                                        <p class="d-flex justify-content-between align-items-center px-3 py-1 ">
                                            <strong>Nombres:</strong>
                                            <span>@Invitation?.Name</span>
                                        </p>
                                    </div>
                                </div>

                            </div>

                            <EditForm Model="@NewInvitationEntry" OnValidSubmit="@SaveInvitationEntry">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                <div class="mb-3">
                                    <label class="form-label">Adultos Asistentes</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitationEntry.AdultsEntered" min="0" max="@Invitation?.NumberConfirmedAdults" />
                                    <ValidationMessage For="@(() => NewInvitationEntry.AdultsEntered)" />
                                    <small class="text-muted">Máximo permitido: @Invitation?.NumberConfirmedAdults</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Niños Asistentes</label>
                                    <InputNumber class="form-control" @bind-Value="NewInvitationEntry.ChildrenEntered" min="0" max="@Invitation?.NumberConfirmedChildren" />
                                    <ValidationMessage For="@(() => NewInvitationEntry.ChildrenEntered)" />
                                    <small class="text-muted">Máximo permitido: @Invitation?.NumberConfirmedChildren</small>
                                </div>
                            </EditForm>
                        }

                    }

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-custom" @onclick="SaveInvitationEntry" disabled="@(Invitation == null)">
                        Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}
