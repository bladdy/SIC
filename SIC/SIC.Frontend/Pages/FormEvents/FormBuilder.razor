@page "/builder"

<style>

    .builder-container {
        max-width: 900px;
        margin: auto;
        padding: 30px;
    }

    .header-card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        border: 1px solid #dee2e6;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        margin-bottom: 25px;
    }

    .question-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .btn-add {
        border: 2px dashed #ced4da;
        border-radius: 12px;
        background: white;
        padding: 18px;
        width: 100%;
        transition: .2s;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #f8f9fa;
            border-color: #0d6efd;
        }

</style>

<div class="builder-container">

    <!-- ENCABEZADO -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-0">

                📝 Constructor de Formularios

            </h2>

            <small class="text-muted">

                Diseña tu checklist o inspección

            </small>

        </div>

        <button class="btn btn-success">

            💾 Guardar

        </button>

    </div>



    <!-- DATOS DEL FORMULARIO -->

    <div class="header-card">

        <label class="fw-semibold mb-2">

            Nombre del formulario

        </label>

        <input class="form-control form-control-lg"
               @bind="Formulario.Titulo" />

    </div>



    <!-- PREGUNTAS -->

    <div class="question-list">

        @foreach (var pregunta in Formulario.Preguntas)
        {
            <PreguntaBuilder Pregunta="pregunta"
                             OnDelete="Eliminar" />
        }

    </div>



    <!-- BOTÓN AGREGAR -->

    <button class="btn-add mt-4"
            @onclick="Agregar">

        ➕ Agregar Nueva Pregunta

    </button>



    #if DEBUG

    <hr />

    <details class="mt-4">

        <summary>

            JSON del formulario

        </summary>

        <pre class="mt-3">

            @System.Text.Json.JsonSerializer.Serialize(
                Formulario,
                new System.Text.Json.JsonSerializerOptions
{
    WriteIndented = true
})

        </pre>

    </details>

    #endif

</div>

@code {

    FormularioModel Formulario = new()
        {
            Titulo = "Inspección de Seguridad",

            Preguntas =
        {
            new()
            {
                Titulo="¿El área está limpia?",
                Tipo=TipoPregunta.SiNo,
                Obligatoria=true
            },

            new()
            {
                Titulo="Temperatura del equipo",
                Tipo=TipoPregunta.Numero
            },

            new()
            {
                Titulo="Nombre del inspector",
                Tipo=TipoPregunta.Texto
            },

            new()
            {
                Titulo="Fecha de inspección",
                Tipo=TipoPregunta.Fecha
            }
        }
        };

    void Agregar()
    {
        Formulario.Preguntas.Add(new()
            {
                Titulo = "Nueva pregunta",
                Tipo = TipoPregunta.Texto
            });
    }

    void Eliminar(PreguntaModel pregunta)
    {
        Formulario.Preguntas.Remove(pregunta);
    }

}