@page "/event/{EventCode}/form-builder"
@using SIC.Shared.Entities
@using SIC.Shared.Enums

<PageTitle>Formulario del Evento</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
    <h3 class="mb-0">
        <i class="bi bi-pencil-square me-1"></i> Formulario del Evento
        @if (!string.IsNullOrWhiteSpace(EventName))
        {
            <small class="text-muted fs-6 d-block">@EventName</small>
        }
    </h3>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver
        </button>
        <button class="btn btn-custom" @onclick="Guardar" disabled="@(Saving || Formulario.Preguntas.Count == 0)">
            @if (Saving)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            <i class="bi bi-floppy"></i> Guardar
        </button>
    </div>
</div>

@if (Loading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var pregunta in Formulario.Preguntas)
        {
            <PreguntaBuilder @key="pregunta.Id"
                             Pregunta="pregunta"
                             OnDelete="Eliminar" />
        }
    </div>

    @if (Formulario.Preguntas.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <h4 class="fw-bold">Sin preguntas todavía</h4>
            <p>Agrega la primera pregunta para comenzar.</p>
        </div>
    }

    <button class="btn btn-custom w-100 mt-4 py-3 fw-semibold" @onclick="Agregar">
        <i class="bi bi-plus-lg"></i> Agregar Nueva Pregunta
    </button>
}