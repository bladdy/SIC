@page "/builder"

<PageTitle>Constructor de Formularios</PageTitle>

<div class="container" style="max-width: 900px; margin: auto;">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-pencil-square"></i>
                Constructor de Formularios
            </h3>
        </div>
        <button class="btn btn-custom">
            <i class="bi bi-floppy"></i> Guardar
        </button>
    </div>

    <!-- DATOS DEL FORMULARIO -->
    <div class="card shadow-sm p-4 mb-4" style="border-radius: 12px;">
        <label class="form-label fw-semibold mb-2">Nombre del formulario</label>
        <input class="form-control form-control-lg" @bind="Formulario.Titulo" />
    </div>

    <!-- PREGUNTAS -->
    <div class="d-flex flex-column gap-3">
        @foreach (var pregunta in Formulario.Preguntas)
        {
            <PreguntaBuilder Pregunta="pregunta"
                             OnDelete="Eliminar" />
        }
    </div>

    <!-- BOTÓN AGREGAR -->
    <button class="btn btn-custom w-100 mt-4 py-3 fw-semibold"
            style="background: white; color: #3C6A79; border-radius: 12px; transition: .2s;"
            @onclick="Agregar"
            onmouseover="this.style.background='#f8f9fa'; this.style.borderColor='#3C6A79';"
            onmouseout="this.style.background='white'; this.style.borderColor='#ced4da';">
        <i class="bi bi-plus-lg"></i> Agregar Nueva Pregunta
    </button>

  
    <hr />
    <details class="mt-4">
        <summary class="fw-semibold text-muted">JSON del formulario</summary>
        <pre class="mt-3 p-3 bg-light rounded" style="font-size: .85rem; overflow-x: auto;">
            @System.Text.Json.JsonSerializer.Serialize(
                Formulario,
                new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true
                })
        </pre>
    </details>

</div>

@code {

    FormularioModel Formulario = new()
    {
        Titulo = "Restricciones alimenticias",

        Preguntas =
        {
            new()
            {
                Titulo="¿Eres alergico?",
                Tipo=TipoPregunta.SiNo,
                Obligatoria=true
            }
        }
    };

    void Agregar()
    {
        Formulario.Preguntas.Add(new()
        {
            Titulo = "Nueva pregunta",
            Tipo = TipoPregunta.Texto
        });
    }

    void Eliminar(PreguntaModel pregunta)
    {
        Formulario.Preguntas.Remove(pregunta);
    }

}