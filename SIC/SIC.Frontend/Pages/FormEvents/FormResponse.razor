@page "/responder"

<PageTitle>Responder Formulario</PageTitle>

<div class="container py-4" style="max-width: 800px; margin: auto;">

    <!-- ENCABEZADO -->
    <PageHeader Icon="bi-ui-checks" Title="@Formulario.Titulo" Subtitle="Completa los campos requeridos" />
    <div class="mb-4"></div>

    @foreach (var pregunta in Formulario.Preguntas)
    {
        <PreguntaResponse Pregunta="pregunta" Respuestas="Respuestas" />
    }

    <div class="text-end mt-4">
        <button class="btn btn-primary btn-lg px-5">
            <i class="bi bi-check-lg me-2"></i>Enviar
        </button>
    </div>

</div>

@code {

    private Dictionary<Guid, string> Respuestas = new();

    private FormularioModel Formulario = new()
    {
        Titulo = "Cuestionario de Seguridad",
        Preguntas =
        [
            new()
            {
                Titulo = "Nombre completo",
                Tipo = TipoPregunta.Texto,
                Obligatoria = true
            },
            new()
            {
                Titulo = "Edad",
                Tipo = TipoPregunta.Numero
            },
            new()
            {
                Titulo = "¿Tiene restricciones alimentarias?",
                Tipo = TipoPregunta.SiNo,
                Obligatoria = true,
                Reglas =
                [
                    new()
                    {
                        ValorDisparador = "Si",
                        SubPreguntas =
                        [
                            new()
                            {
                                Titulo = "¿Cuáles restricciones?",
                                Tipo = TipoPregunta.Texto,
                                Obligatoria = true
                            },
                            new()
                            {
                                Titulo = "Foto del comprobante médico",
                                Tipo = TipoPregunta.Foto
                            }
                        ]
                    }
                ]
            }
        ]
    };
}