@page "/responder"

<PageTitle>Responder Formulario</PageTitle>

<div class="container" style="max-width: 800px; margin: auto;">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">@Formulario.Titulo</h3>
            <small class="text-muted">Completa los campos requeridos</small>
        </div>
    </div>

    @foreach (var pregunta in Formulario.Preguntas)
    {
        <div class="card shadow-sm p-3 mb-3" style="border-radius: 10px;">
            <label class="form-label fw-semibold mb-2">
                @pregunta.Titulo
                @if (pregunta.Obligatoria)
                {
                    <span class="text-danger ms-1">*</span>
                }
            </label>

            @switch (pregunta.Tipo)
            {
                case TipoPregunta.Texto:
                    <input class="form-control" placeholder="Escribe tu respuesta..." />
                    break;

                case TipoPregunta.Numero:
                    <input type="number" class="form-control" placeholder="0" />
                    break;

                case TipoPregunta.SiNo:
                    <select class="form-select">
                        <option value="">-- Selecciona --</option>
                        <option value="Si">Sí</option>
                        <option value="No">No</option>
                    </select>
                    break;

                case TipoPregunta.Fecha:
                    <input type="date" class="form-control" />
                    break;

                case TipoPregunta.Foto:
                    <InputFile class="form-control" />
                    break;
            }
        </div>
    }

    <div class="text-end mt-4">
        <button class="btn btn-custom btn-lg px-5">
            <i class="bi bi-check-lg me-2"></i>Enviar
        </button>
    </div>

</div>

@code {

    private FormularioModel Formulario = new()
        {
            Titulo = "Inspección de Seguridad",

            Preguntas =
        [
            new()
        {
            Titulo="Nombre del inspector",
            Tipo=TipoPregunta.Texto
        },

        new()
        {
            Titulo="Temperatura",
            Tipo=TipoPregunta.Numero
        },

        new()
        {
            Titulo="¿Hay riesgos?",
            Tipo=TipoPregunta.SiNo
        },

        new()
        {
            Titulo="Fecha",
            Tipo=TipoPregunta.Fecha
        },

        new()
        {
            Titulo="Fotografía",
            Tipo=TipoPregunta.Foto
        }
        ]
        };
}