<div class="card shadow-sm p-3 mb-0" style="border-radius: 12px;">

    <!-- CABECERA -->
    <div class="d-flex justify-content-between align-items-start">
        <input class="form-control border-0 border-bottom border-2 px-0 py-1 fs-6 fw-semibold"
               style="border-bottom-color: #3C6A79 !important; outline: none; transition: .2s; width: 100%;"
               @bind="Pregunta.Titulo" />

        <div class="dropdown">
            <button class="btn btn-link text-secondary p-0 fs-5 text-decoration-none"
                    data-bs-toggle="dropdown">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <button class="dropdown-item" @onclick="Eliminar">
                        <i class="bi bi-trash text-danger me-2"></i>Eliminar
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- CONFIGURACIÓN -->
    <div class="row mt-4">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Tipo</label>
            <select class="form-select" @bind="Pregunta.Tipo">
                @foreach (var tipo in Enum.GetValues<TipoPregunta>())
                {
                    <option value="@tipo">@tipo</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Obligatoria</label>
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" @bind="Pregunta.Obligatoria" />
                <label class="form-check-label">Sí</label>
            </div>
        </div>
    </div>

    <!-- REGLAS -->
    @if (Pregunta.Tipo == TipoPregunta.SiNo)
    {
        <div class="mt-4">
            @foreach (var regla in Pregunta.Reglas)
            {
                <div style="margin-left: 45px; margin-top: 20px; padding-left: 20px; border-left: 3px solid #d9d9d9;">
                    <div class="fw-semibold mb-3" style="color: #3C6A79; font-size: .9rem;">
                        <i class="bi bi-chevron-down"></i> Cuando responda
                        <strong>@regla.ValorDisparador</strong>
                    </div>

                    <select class="form-select mb-3" @bind="regla.ValorDisparador">
                        <option>Si</option>
                        <option>No</option>
                    </select>

                    @foreach (var sub in regla.SubPreguntas)
                    {
                        <PreguntaBuilder Pregunta="sub"
                                         OnDelete="@(() => EliminarSub(regla, sub))" />
                    }

                    <button class="btn btn-custom btn-sm w-100 mt-2"
                            style="border: 2px dashed #ced4da; background: transparent; color: #3C6A79; border-radius: 8px;"
                            @onclick="() => AgregarSub(regla)"
                            onmouseover="this.style.background='#f8f9fa'"
                            onmouseout="this.style.background='transparent'">
                        <i class="bi bi-plus-lg"></i> Agregar Subpregunta
                    </button>
                </div>
            }

            <button class="btn btn-custom mt-4" @onclick="AgregarRegla">
                <i class="bi bi-plus-lg"></i> Agregar Condición
            </button>
        </div>
    }

</div>

@code {

    [Parameter]
    public PreguntaModel Pregunta { get; set; } = default!;

    [Parameter]
    public EventCallback<PreguntaModel> OnDelete { get; set; }

    async Task Eliminar()
    {
        await OnDelete.InvokeAsync(Pregunta);
    }

    void AgregarRegla()
    {
        Pregunta.Reglas.Add(new()
            {
                ValorDisparador = "Si"
            });
    }

    void AgregarSub(ReglaPreguntaModel regla)
    {
        regla.SubPreguntas.Add(new()
            {
                Titulo = "Nueva Subpregunta",
                Tipo = TipoPregunta.Texto
            });
    }

    void EliminarSub(ReglaPreguntaModel regla, PreguntaModel pregunta)
    {
        regla.SubPreguntas.Remove(pregunta);
    }

}