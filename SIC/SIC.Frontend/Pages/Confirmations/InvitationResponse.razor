@page "/invitacion/{Code}"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Forms

<div class="d-flex justify-content-center align-items-center min-vh-100" style="background-color">
    <div class="card p-4 shadow position-relative"
    style="max-width: 500px; width: 90%; min-height: 400px;">

        <div class="text-center">

            @if (MostrarFormulario)
            {
                <div>
                    <h4 class="fw-bold mb-1">@Invitacion?.Event?.Name</h4>
                    <p class="fw-bold mb-3">@Invitacion?.Event?.SubTitle</p>
                    <h2 class="fw-bold mb-3">@Invitacion?.Name</h2>

                    <div class="mb-3">
                        <p class="fw-bold mb-1">Adultos invitados: @Adultos</p>

                        @if (Jovenes > 0)
                        {
                            <p class="fw-bold mb-1">Jóvenes invitados: @Jovenes</p>
                        }

                        <p class="fw-bold mb-2">
                            @(Menores == 0 ? "Respetuosamente NO NIÑOS"
                                        : $"Niños invitados: {Menores}")
                        </p>
                    </div>

                    @if (MostrarListadoInvitados)
                    {
                        <div class="mb-3">
                            <p class="mb-2">Elija su respuesta:</p>

                            <InputRadioGroup @bind-Value="Asistira">

                                <div class="d-flex justify-content-center align-items-center gap-4">

                                    <label class="d-flex align-items-center gap-2 mb-0"
                                           style="cursor:pointer; white-space:nowrap;">
                                        <InputRadio class="form-check-input m-0"
                                                    Value="true" />
                                        <span>Sí Asistiré</span>
                                    </label>

                                    <label class="d-flex align-items-center gap-2 mb-0"
                                           style="cursor:pointer; white-space:nowrap;">
                                        <InputRadio class="form-check-input m-0"
                                                    Value="false" />
                                        <span>No Asistiré</span>
                                    </label>

                                </div>

                            </InputRadioGroup>
                            <div class="row fw-bold border-bottom">
                                <div class="col-6">Invitado</div>
                                <div class="col-6">¿Asistirá?</div>
                            </div>

                            @if (Invitacion?.Guests != null && Invitacion.Guests.Any())
                            {
                                int contador = 1;

                                @foreach (var guest in Invitacion.Guests)
                                {
                                    <div class="row align-items-center py-2 fw-bold">
                                        <div class="col-6">
                                            @(guest.GuestName ?? $"Invitado {contador}")
                                        </div>

                                        <div class="col-6 d-flex gap-4 justify-content-center">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       id="@($"invitado_{contador}_si")"
                                                       type="radio"
                                                       name="guest_@guest.Id"
                                                       checked="@(guest.Status == Status.Attend)"
                                                       @onclick="() => guest.Status = Status.Attend" />

                                                <label class="form-check-label"
                                                       for="@($"invitado_{contador}_si")">
                                                    Sí
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       id="@($"invitado_{contador}_no")"
                                                       type="radio"
                                                       name="guest_@guest.Id"
                                                       checked="@(guest.Status == Status.NotAttend)"
                                                       @onclick="() => guest.Status = Status.NotAttend" />

                                                <label class="form-check-label"
                                                       for="@($"invitado_{contador}_no")">
                                                    No
                                                </label>
                                            </div>
                                            
                                        </div>
                                    </div>

                                    contador++;
                                }
                            }

                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold">Dedicatoria</label>
                        <textarea class="form-control"
                        rows="3"
                        maxlength="1500"
                        @bind="Comentarios">
                        </textarea>
                    </div>

                    @if (MostrarBotonConfirmar)
                    {
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-custom w-50 fw-bold"
                            @onclick="EnviarRespuesta">
                                Enviar Respuesta
                            </button>
                        </div>
                    }
                </div>
            }

            @if (MostrarGracias)
            {
                <div class="card shadow-lg border-0 mt-4 mx-auto">

                    <!-- Imagen del evento -->
                    @if (!string.IsNullOrEmpty(Invitacion?.Event?.CoverImageUrl))
                    {
                        <img src="@Invitacion.Event.CoverImageUrl"
                        class="card-img-top"
                        style="height: 200px; object-fit: contain; border-top-left-radius:15px; border-top-right-radius:15px;" />
                    }

                    <div class="card-body text-center">

                        <h6 class="fw-bold text-uppercase mb-3 text-muted">
                            Gracias por confirmar tu asistencia al evento de:
                        </h6>
                        <h6 class="fw-bold text-uppercase mb-0 text-black">
                            @Invitacion!.Event!.SubTitle
                        </h6>
                        <h6 class="fw-bold text-uppercase mb-0 text-black">
                            @Invitacion!.Event!.Name
                        </h6>
                        <h6 class="fw-bold mb-3 text-black">
                            @Invitacion!.Event!.Date.FormatearFechaLargaEspanol()
                        </h6>

                        @if (Invitacion?.Status == Status.Attend)
                        {
                            @if (!string.IsNullOrEmpty(QrBase64))
                            {
                                <div class="my-3">
                                    <img src="@($"data:image/png;base64,{QrBase64}")"
                                    class="img-fluid"
                                    style="max-width: 100px;" />
                                </div>
                            }

                            @if (Invitacion?.Guests != null && Invitacion.Guests.Any())
                            {
                                int contador = 1;
                                <h5 class="fw-bold text-uppercase mb-3 text-muted">
                                    Lista de invitados
                                </h5>
                                <h5 class="fw-bold text-uppercase mb-0 text-black">
                                    @Invitacion.Name
                                </h5>

                                @foreach (var guest in Invitacion.Guests.Where(s => s.Status == Status.Attend))
                                {
                                    <div class="row text-center fw-bold text-capitalize text-muted">
                                        <div class="col">
                                            @(guest.GuestName ?? $"Invitado {contador}") (@(guest.GuestType.GetDescription()))
                                            @if (guest.TablesEventsId.HasValue)
                                            {
                                                <span> — Mesa: @guest.TablesEvents?.Name</span>
                                            }
                                        </div>
                                    </div>

                                }
                            }
                            @if (Invitacion?.Guests?.Any(g => g.TablesEventsId.HasValue) != true)
                            {
                                var mesaNombre = Invitacion?.TablesEvents?.Name;
                                @if (!string.IsNullOrEmpty(mesaNombre))
                                {
                                    <h6 class="fw-bold text-uppercase mt-3 text-black">
                                        Mesa: @mesaNombre
                                    </h6>
                                }
                            }
                            <p class="fw-semibold text-muted small mt-3">
                            Este código QR es tu acceso al evento.
                            Descárgalo y preséntalo en la entrada.
                            Este QR solo se escanea con nuestra App.
                        </p>

                        @if (!string.IsNullOrEmpty(PdfBase64))
                        {
                            <a class="btn btn-dark w-100"
                                href="@($"data:application/pdf;base64,{PdfBase64}")"
                                download="Boleta.pdf">
                                ⬇ Descargar QR
                            </a>
                        }

                    }
                    </div>
                </div>
            }

            @if (MostrarNoInvitacion)
            {
                <div class="mt-4 text-center">
                    <h5 class="fw-bold text-danger">No se encontró la invitación</h5>
                    <p>Código: <b>@CodigoNoEncontrado</b></p>
                </div>
            }

        </div>
    </div>
</div>
