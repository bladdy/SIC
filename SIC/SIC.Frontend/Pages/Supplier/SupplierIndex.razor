
@page "/supplier"
<PageTitle>Proveedores</PageTitle>
<PageHeader Icon="bi-truck" Title="Proveedores" Subtitle="Gestión de proveedores">
    <VolverButton />

    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i class="bi bi-plus-lg"></i> Crear Proveedor
    </button>
</PageHeader>

<GenericList MyList="Supplier">
    <Body>
        <table class="table sic-table mb-0">
            <thead>
                <tr class="text-center">
                    <th>Proveedor</th>
                    <th>Compañia</th>
                    <th>Telefono</th>
                    <th>Movil</th>
                    <th>Correo</th>

                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Supplier!)
                {
                    <tr class="align-middle">
                        <td>@supplier.Name</td>
                        <td>@supplier.Company</td>
                        <td>@supplier.Phone</td>
                        <td>@supplier.Mobile</td>
                        <td>@supplier.Email</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-custom me-2" @onclick="() => ShowEditModal(supplier)">
                                <i class="bi bi-pencil-fill"></i> Editar
                            </button>
                            <button class="btn btn-sm btn-custom" @onclick="() => ConfirmDelete(supplier)">
                                <i class="bi bi-trash-fill"></i> Borrar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </Body>
</GenericList>

<!-- Modal -->
@if (IsModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(IsEditMode ? "bi-pencil-square me-2" : "bi-truck me-2")"></i>@((IsEditMode ? "Editar Proveedor" : "Crear Proveedor"))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewSupplier" OnValidSubmit="@SaveEventTypes">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="NewSupplier.Name" />
                            <ValidationMessage For="@(() => NewSupplier.Name)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Compañia</label>
                            <InputText class="form-control" @bind-Value="NewSupplier.Company" />
                            <ValidationMessage For="@(() => NewSupplier.Company)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Telefono</label>
                            <InputText class="form-control" @bind-Value="NewSupplier.Phone" />
                            <ValidationMessage For="@(() => NewSupplier.Phone)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Movil</label>
                            <InputText class="form-control" @bind-Value="NewSupplier.Mobile" />
                            <ValidationMessage For="@(() => NewSupplier.Mobile)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Correo</label>
                            <InputText class="form-control" @bind-Value="NewSupplier.Email" />
                            <ValidationMessage For="@(() => NewSupplier.Email)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nota</label>
                            <InputTextArea class="form-control" @bind-Value="NewSupplier.Notes" />
                            <ValidationMessage For="@(() => NewSupplier.Notes)" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-custom btn-sm"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModal">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmModal IsVisible="IsConfirmVisible" IsVisibleChanged="OnConfirmVisibleChanged" Message="@ConfirmMessage" OnConfirmAction="ExecutePendingDelete" />


